;========================================================
; 生活系统大修 - 养鸡系统
; 文件：ERB/DLC/生活系统大修/生活系统_养鸡.ERB
;
; 开关：生活系统_养鸡
; 钩子：@生活系统_养鸡_每日事件 由 DLCEVENT 在每日结算时调用
;
; 状态：施工中（后续版本实装，菜单内标注）
;========================================================

;--------------------------------------------------------
; 鸡舍实际容量：基础 3 笼，鸡舍扩建（911）Lv1=5、Lv2+=8
; 由养鸡子系统开关控制（关闭时保持原版 3 笼）
;--------------------------------------------------------
@生活系统_鸡舍容量
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !生活系统_养鸡
	RETURNF 3
SELECTCASE ITEM:911
	CASE 0
		RETURNF 3
	CASE 1
		RETURNF 5
	CASEELSE
		RETURNF 8
ENDSELECT
RETURNF 3

;--------------------------------------------------------
; 孵化器：孵出生物判定（按蛋种）
; 参数：蛋类物品名（ARGS）
; 返回：孵出的生物CritterData ID（0=无法孵化）
;--------------------------------------------------------
@生活系统_孵化判定(ARGS)
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "卵"
		RETURN 50    ;野鸡
	CASE "奇妙な卵"
		;随机特殊生物（蛇/死亡蠕虫/槌之子）
		SELECTCASE RAND:3
			CASE 0
				RETURN 20
			CASE 1
				RETURN 23
			CASEELSE
				RETURN 24
		ENDSELECT
	CASE "龙蛋"
		RETURN 55    ;幼龙
	CASE "鸭蛋"
		RETURN 56    ;鸭子
	CASEELSE
		RETURN 0
ENDSELECT
RETURN 0

;--------------------------------------------------------
; 每日事件钩子：在本子系统开关开启时被调用
;--------------------------------------------------------
@生活系统_养鸡_每日事件
#LOCALSIZE 2
#LOCALSSIZE 1
SIF !生活系统_养鸡
	RETURN
;抚摸每日标记重置（每只动物每天只能被抚摸一次）
VARSET 抚摸済み, 0
;孵化器推进：剩余天数-1，到 0 孵出并放入空笼
IF 孵化槽_蛋种 != ""
	孵化槽_剩余天数 --
	IF 孵化槽_剩余天数 <= 0
		;找空笼放入
		FOR LOCAL, 0, 生活系统_鸡舍容量()
			IF BIRD_CAGE:LOCAL == 0
				CALL INPUT_EGGDATA(孵化槽_生物ID, LOCAL)
				SETCOLOR C_YELLOW
				PRINTFORML 孵化完成！%Eggname%破壳而出，被安置进了饲育小屋！
				RESETCOLOR
				孵化槽_蛋种 = 
				孵化槽_生物ID = 0
				孵化槽_剩余天数 = 0
				RETURN
			ENDIF
		NEXT
		;笼满则孵化暂停，提示
		PRINTFORML 孵化完成！但没有空余的饲育小屋，%孵化槽_蛋种%仍留在孵化器中……
		孵化槽_剩余天数 = 0
	ENDIF
ENDIF
;自动抚摸机（913）：每日自动抚摸所有饲育生物（收益+2）
IF ITEM:913
	FOR LOCAL, 0, 生活系统_鸡舍容量()
		SIF BIRD_CAGE:LOCAL
			BIRD_COND:LOCAL += 2
	NEXT
	PRINTFORML 自动抚摸机轻轻抚摸着饲育生物们，它们似乎比昨天更亲近了些……
ENDIF
RETURN

;--------------------------------------------------------
; 抚摸互动：选择一只饲育生物抚摸（好感+5，行动5分钟）
; 返回：行动时间
;--------------------------------------------------------
@生活系统_抚摸互动
#LOCALSIZE 2
#LOCALSSIZE 1
PRINTL 要抚摸哪只饲育生物？
DRAWLINE
FOR LOCAL:1, 0, 生活系统_鸡舍容量()
	IF BIRD_CAGE:(LOCAL:1)
		IF 抚摸済み:(LOCAL:1)
			PRINTFORML [{LOCAL:1+1,2}] %BIRD_NAME:(LOCAL:1)%（今天已亲近过）
		ELSE
			PRINTFORML [{LOCAL:1+1,2}] %BIRD_NAME:(LOCAL:1)%
		ENDIF
	ENDIF
NEXT
PRINTL [0] 返回
$抚摸输入
INPUT
IF RESULT == 0
	RETURN 0
ENDIF
LOCAL:1 = RESULT - 1
IF INRANGE(LOCAL:1, 0, 生活系统_鸡舍容量() - 1) && BIRD_CAGE:(LOCAL:1)
	;每日限一次：已经抚摸过的动物不能再加好感（防止无限刷）
	IF 抚摸済み:(LOCAL:1)
		PRINTFORML %BIRD_NAME:(LOCAL:1)%今天已经被抚摸过了……
		CLEARLINE 1
		GOTO 抚摸输入
	ENDIF
	抚摸済み:(LOCAL:1) = 1
	BIRD_COND:(LOCAL:1) += 5
	;好感分档互动文本（低<50 / 中50~99 / 高100+）
	LOCAL = 1
	SIF BIRD_COND:(LOCAL:1) >= 50
		LOCAL = 2
	SIF BIRD_COND:(LOCAL:1) >= 100
		LOCAL = 3
	CALL 生活系统_抚摸文本(BIRD_ID:(LOCAL:1), LOCAL, BIRD_NAME:(LOCAL:1))
	;等待确认，让互动文本可见（否则返回时会被鸡舍菜单清屏抹掉）
	WAIT
	RETURN 5
ELSE
	PRINTFORML 没有这个饲育小屋……
	CLEARLINE 1
	GOTO 抚摸输入
ENDIF
RETURN 0

;--------------------------------------------------------
; 抚摸互动文本：按生物种类×好感档位显示
; 参数：ARG=生物ID ARG:1=档位(1低/2中/3高) ARGS=生物名
; 档位：好感<50低 / 50~99中 / 100+高
; 幼龙（55）的文本以彩色显示，体现其稀有性
;--------------------------------------------------------
@生活系统_抚摸文本(ARG, ARG:1, ARGS)
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ARG
	CASE 50	;野鸡
		SELECTCASE ARG:1
			CASE 1
				PRINTFORML %ARGS%扑腾着翅膀躲开了你的手，警惕地咯咯直叫。
			CASE 2
				PRINTFORML %ARGS%站在原地让你抚摸蓬松的羽毛，舒服地眯起眼睛。
			CASEELSE
				PRINTFORML %ARGS%主动蹭到你脚边，用翅膀轻轻拍着你的手，发出满足的咕咕声。
		ENDSELECT
	CASE 20	;蛇
		SELECTCASE ARG:1
			CASE 1
				PRINTFORML %ARGS%冰冷地吐着信子，警惕地注视着你的手。
			CASE 2
				PRINTFORML %ARGS%安静地缠绕上你的手臂，用信子轻轻触碰你的指尖。
			CASEELSE
				PRINTFORML %ARGS%温顺地盘在你膝上，惬意地随着你的抚摸轻轻摆动。
		ENDSELECT
	CASE 23	;死亡蠕虫
		SELECTCASE ARG:1
			CASE 1
				PRINTFORML %ARGS%蠕动了一下，用不祥的气息抗拒着你的靠近。
			CASE 2
				PRINTFORML %ARGS%缓缓舒展身体，似乎开始习惯你的触碰。
			CASEELSE
				PRINTFORML %ARGS%欢快地在你手心钻来钻去，粘液蹭得到处都是——不过它似乎很高兴。
		ENDSELECT
	CASE 24	;槌之子
		SELECTCASE ARG:1
			CASE 1
				PRINTFORML %ARGS%缩成一团，戒备地观察着你。
			CASE 2
				PRINTFORML %ARGS%小心翼翼地探出头，让你摸了摸它毛茸茸的脑袋。
			CASEELSE
				PRINTFORML %ARGS%在你手边蹦蹦跳跳，发出愉悦的鸣叫声。
		ENDSELECT
	CASE 55	;幼龙（彩色文本体现稀有性）
		SELECTCASE ARG:1
			CASE 1
				SETCOLOR 0x994C00
				PRINTFORML 鳞片泛着冷光的%ARGS%低吼一声，龙威让空气都沉重了几分。
				RESETCOLOR
			CASE 2
				SETCOLOR C_YELLOW
				PRINTFORML 微微发光的%ARGS%收拢翅膀，任由你的手拂过温热的鳞片。
				RESETCOLOR
			CASEELSE
				SETCOLOR C_ORANGE
				PRINTFORML 威严的%ARGS%垂下头颅，龙瞳中映出你的身影——那是完全的信任。
				RESETCOLOR
		ENDSELECT
	CASE 56	;鸭子
		SELECTCASE ARG:1
			CASE 1
				PRINTFORML %ARGS%嘎嘎叫着躲开你的手，扑腾着翅膀溅起水花。
			CASE 2
				PRINTFORML %ARGS%歪着脑袋让你抚摸它的脖颈，发出轻柔的嘎嘎声。
			CASEELSE
				PRINTFORML %ARGS%亲昵地跟着你走，用扁扁的嘴轻轻啄着你的裤脚。
		ENDSELECT
	CASEELSE
		PRINTFORML 你轻轻抚摸了%ARGS%的头。%ARGS%舒服地眯起了眼睛！
ENDSELECT
RETURN 0

;--------------------------------------------------------
; 孵化器菜单（家具912）：放入蛋/查看/加速
; 返回：行动时间
;--------------------------------------------------------
@生活系统_孵化器菜单
#LOCALSIZE 3
#LOCALSSIZE 1
$孵化器循环
LOCAL:2 = LINECOUNT
PRINTFORML 【孵化器】
IF 孵化槽_蛋种 == ""
	PRINTFORML 孵化槽：空
	PRINTL [1] 放入蛋
ELSE
	PRINTFORML 孵化槽：%孵化槽_蛋种%（剩余{孵化槽_剩余天数}天）
	PRINTL [2] 操纵时间加速孵化（消耗TSP）
	SIF BASE:MASTER:TSP >= 4000 && ITEM:绯红之王
		PRINTL [3] 『绯红之王』！（消耗TSP与绯红之王）
	PRINTL [4] 取出蛋
ENDIF
PRINTL [0] 返回
INPUT
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1
		;放入蛋
		IF 孵化槽_蛋种 != ""
			PRINTFORML 孵化槽已经被占用了……
			CLEARLINE 1
			GOTO 孵化器循环
		ENDIF
		PRINTL 选择要孵化的蛋：
		FOR LOCAL, 711, 714
			SIF ITEMNAME:LOCAL == ""
				CONTINUE
			SIF ITEM:LOCAL
				PRINTFORML [{LOCAL}] %ITEMNAME_TR(LOCAL)%（持有{ITEM:LOCAL}个）
		NEXT
		PRINTL [0] 取消
		$蛋选择输入
		INPUT
		IF RESULT == 0
			CLEARLINE 1
			GOTO 孵化器循环
		ENDIF
		LOCAL = RESULT
		CALL 生活系统_孵化判定(ITEMNAME:LOCAL)
		IF RESULT == 0
			PRINTFORML 这个蛋无法孵化……
			CLEARLINE 1
			GOTO 孵化器循环
		ENDIF
		孵化槽_生物ID = RESULT
		孵化槽_蛋种 = %ITEMNAME:LOCAL%
		;龙蛋需漫长孵化（神话生物），其余蛋10天
		IF 孵化槽_蛋种 == "龙蛋"
			孵化槽_剩余天数 = 1000
			PRINTFORML 将%孵化槽_蛋种%放入了孵化器。龙蛋散发着深沉的光辉，恐怕需要漫长的岁月才能孵出……
		ELSE
			孵化槽_剩余天数 = 10
			PRINTFORML 将%孵化槽_蛋种%放入了孵化器，约10天后孵出……
		ENDIF
		ITEM:LOCAL --
		CLEARLINE LINECOUNT - LOCAL:2
		GOTO 孵化器循环
	CASE 2
		;TSP加速（-10天）
		IF 孵化槽_蛋种 == ""
			PRINTFORML 孵化槽是空的……
			CLEARLINE 1
			GOTO 孵化器循环
		ENDIF
		IF BASE:MASTER:TSP < 2400
			PRINTFORML TSP不足……
			CLEARLINE 1
			GOTO 孵化器循环
		ENDIF
		BASE:MASTER:TSP -= 2400
		孵化槽_剩余天数 -= 10
		PRINTFORML 使用时间停止能力强行加速了孵化（剩余{孵化槽_剩余天数}天）
		CLEARLINE LINECOUNT - LOCAL:2
		GOTO 孵化器循环
	CASE 3
		;绯红之王（-100天）
		IF 孵化槽_蛋种 == ""
			PRINTFORML 孵化槽是空的……
			CLEARLINE 1
			GOTO 孵化器循环
		ENDIF
		IF BASE:MASTER:TSP < 4000 || ITEM:绯红之王 == 0
			PRINTFORML TSP或绯红之王不足……
			CLEARLINE 1
			GOTO 孵化器循环
		ENDIF
		BASE:MASTER:TSP -= 4000
		ITEM:绯红之王 --
		孵化槽_剩余天数 -= 100
		PRINTFORML 消除了时间得到了『结果』！孵化进度大幅推进！
		CLEARLINE LINECOUNT - LOCAL:2
		GOTO 孵化器循环
	CASE 4
		;取出蛋
		IF 孵化槽_蛋种 == ""
			PRINTFORML 孵化槽是空的……
			CLEARLINE 1
			GOTO 孵化器循环
		ENDIF
		PRINTFORML 取出了%孵化槽_蛋种%。
		CALL GET_ITEM(孵化槽_蛋种, 1, 2)
		孵化槽_蛋种 = 
		孵化槽_生物ID = 0
		孵化槽_剩余天数 = 0
		CLEARLINE LINECOUNT - LOCAL:2
		GOTO 孵化器循环
	CASEELSE
		CLEARLINE 1
		GOTO 孵化器循环
ENDSELECT
RETURN 0
