;========================================================
; 生活系统大修 - 变量声明（SAVEDATA/常量）
; 文件：ERB/DLC/生活系统大修/0_生活系统_变量.ERH
;
; 设计说明：
;   - 本模组全部 SAVEDATA 变量与常量集中声明于此，
;     不修改原版 DIM.ERH，便于从原版/变体继承上游更新。
;   - 文件名以 "0_" 开头，保证在 DLC 目录内最先编译
;     （所有使用点均位于本文件之后，编译顺序安全）。
;========================================================

;--------------------------------------------------------
; 框架开关与存档版本
;--------------------------------------------------------
#DIM CONST 生活系统大修_框架版本 = 1
#DIM SAVEDATA 生活系统_存档版本
#DIM SAVEDATA 生活系统_养鸡        ;养鸡系统（已实装：鸡舍强化/孵化器/抚摸互动）
#DIM SAVEDATA 生活系统_种地        ;种地系统（已实装：种子培育设施+新作物两阶段收获）
#DIM SAVEDATA 生活系统_酿酒        ;酿酒系统（已实装：橡木酒桶）
#DIM SAVEDATA 生活系统_钓鱼        ;钓鱼系统（已实装：钓鱼小游戏）
#DIM SAVEDATA 生活系统_钓鱼_难度    ;0=默认 1=简单
#DIM SAVEDATA 生活系统_读书        ;读书系统改造（v2.1.3：实用书分区选择 + 等级化学习判定）
#DIM SAVEDATA 生活系统_魔法联动    ;魔法版联动内容（v2.1.5：天堂制造 TSlv5 魔法）
#DIM SAVEDATA 生活系统_天堂制造加速  ;天堂制造·时间压缩（对自己发动后生效，非性爱系指令1分钟，就寝/次日清除）
#DIM SAVEDATA 生活系统_指令开始时刻  ;EVENTCOM 记录当前指令开始时 TIME（供 EVENTCOMEND 时间压缩用）
#DIM SAVEDATA 生活系统_武道大会      ;天下第一武道大会（v2.1.6：博丽神社境内，与全幻想乡少女弹幕战斗）
#DIM SAVEDATA 生活系统_音乐        ;生活系统大修·音乐开关（与音乐补丁开关同时开启才播放音效/BGM）
;--------------------------------------------------------
; 生活质量提升（读书 / 料理委托改善 / 巧克力转换）
;--------------------------------------------------------
#DIM SAVEDATA 生活系统_料理委托改善  ;委托17口味旁提示最佳菜谱/做菜高亮
#DIMS 生活系统_委托17_味要求   ;进行中委托17的口味要求（非存档）
#DIM 生活系统_委托17_最高匹配   ;进行中委托17下所有菜谱的最高匹配标签数（非存档）
#DIM SAVEDATA 生活系统_巧克力转换  ;开放调和配方：黑雷神/高级巧克力料理用巧克力

;--------------------------------------------------------
; 养蜂系统（蜂箱 / 授粉 / 熊与妖精）
;--------------------------------------------------------
#DIM SAVEDATA 生活系统_养蜂        ;养蜂系统
#DIM SAVEDATA 生活系统_蜂箱蜜, 8       ;每箱蜜存量（上限10）
#DIM SAVEDATA 生活系统_蜂箱进度, 8     ;每箱采蜜进度（10进度=1蜜）
#DIM SAVEDATA 生活系统_蜂箱有蜂, 8     ;1=已放入蜂王开始工作
#DIM SAVEDATA 生活系统_熊好感      ;熊的好感度（10=熊之友）
#DIM SAVEDATA 生活系统_熊赶跑剩    ;武力赶跑后的冷却天数
#DIM SAVEDATA 生活系统_熊敲门剩    ;好感3+后敲门讨蜜的间隔天数
#DIM SAVEDATA 生活系统_妖精好感    ;妖精好感度（10=花田妖精）
#DIM SAVEDATA 生活系统_花田妖精    ;1=花田妖精事件已触发
#DIM SAVEDATA 生活系统_授粉标记, 240   ;植株授粉生效标记

;--------------------------------------------------------
; 鱼塘系统（养鱼繁殖 / 鲟鱼卵鱼子酱）
;--------------------------------------------------------
#DIM SAVEDATA 生活系统_鱼塘        ;鱼塘系统
#DIM SAVEDATA 生活系统_鱼塘数量    ;鱼塘数量（默认1，上限5）
#DIM SAVEDATA 生活系统_鱼塘建造剩余 ;建造剩余天数（天堂制造可加速）
#DIM SAVEDATA 生活系统_鱼塘建造中   ;1=正在建造
#DIMS SAVEDATA 生活系统_鱼塘鱼种, 5  ;每口塘的鱼种名
#DIM SAVEDATA 生活系统_鱼塘鱼种ID, 5  ;每口塘的鱼种ID
#DIM SAVEDATA 生活系统_鱼塘鱼数, 5   ;每口塘的鱼数量（上限10）
#DIM SAVEDATA 生活系统_鱼塘长度, 5, 10 ;每口塘每条鱼的长度cm
#DIM SAVEDATA 生活系统_鱼塘产卵剩, 5  ;产卵期剩余天数
#DIM SAVEDATA 生活系统_鱼塘孵化剩, 5  ;孵化期剩余天数
#DIM SAVEDATA 生活系统_鱼塘繁殖剩, 5  ;繁殖冷却剩余天数
#DIM SAVEDATA 生活系统_鱼塘成长剩, 5  ;成长加速剩余天数
#DIM SAVEDATA 生活系统_鱼塘请求, 5    ;0=无 1=等待 2=已完成加成
#DIM SAVEDATA 生活系统_鱼塘请求剩, 5  ;请求等待剩余天数
#DIM 生活系统_鱼塘请求物, 5      ;请求物品ID
#DIM 生活系统_鱼塘请求量, 5      ;请求数量
#DIM 生活系统_武道大会_压制强度   ;武道大会「压制实力」预置的大角虫装置强度（COM480 钩子读取后清零）
#DIM SAVEDATA 生活系统_武道大会_胜利数    ;擂台战累计胜利人数（仅统计擂台挑战获胜）
#DIM SAVEDATA 生活系统_武道大会_奖励领取日 ;最近一次领取擂台战奖励的 DAY:0（每天限一次）
#DIM 生活系统_武道大会_上次战果   ;COMF480 钩子记录：对方残机数（0=玩家胜），供擂台战判定

;--------------------------------------------------------
; 种地系统：菜园畝数组（上限 240=隙间耕地；普通上限 8 由代码控制）
;--------------------------------------------------------
#DIM SAVEDATA PLANT_TYPE, 240
#DIM SAVEDATA PLANT_DAYS, 240
#DIM SAVEDATA PLANT_GROW, 240
#DIM SAVEDATA PLANT_DRY, 240
#DIMS SAVEDATA HATAKE_NAME, 240
#DIM SAVEDATA PLANT_FOOD, 240
;保留植株作物（浆果/菌菇）已收获果期标记 0=未收 1=已收
#DIM SAVEDATA PLANT_HARVESTED, 240

;--------------------------------------------------------
; 种地系统：开荒（COMF472 开荒）与花屋苗解锁（育苗→解锁花屋出售）
;--------------------------------------------------------
#DIM 生活系统_QOL已注册	;非SAVEDATA：每次启动首次进入主菜单时重新注册 QOL 物品数据（花屋苗 SHOP_COND 等），兼容补丁更新

#DIM SAVEDATA 生活系统_开荒数
#DIM SAVEDATA 生活系统_上次基础畝数
#DIM SAVEDATA 生活系统_开荒日期	;最近一次开荒的 DAY:0（每日限一次）
#DIM SAVEDATA 花屋苗解锁, 220	;模组苗（193~219）的花屋出售解锁状态（按苗ITEM_ID索引，0=未解锁）
#DIM SAVEDATA 花屋苗今日获得, 220	;今日通过育苗获得的模组苗标记（当晚结算时处理）

;--------------------------------------------------------
; 种地系统：种子培育设施槽位（家具908，等级=ITEM:908，1~3级）
; 分钟制：TIME:1 - 开始时刻 >= 需求分钟 即完成
;--------------------------------------------------------
#DIM SAVEDATA 育苗槽, 3, 4
#DIM CONST 育苗槽_材料 = 0        ;成材ITEM_ID（0=空槽）
#DIM CONST 育苗槽_产物 = 1        ;产出种子ITEM_ID
#DIM CONST 育苗槽_开始时刻 = 2    ;放入时 TIME:1（绝对分钟）
#DIM CONST 育苗槽_需求分钟 = 3    ;所需分钟（已含设施等级缩短）

;--------------------------------------------------------
; 养鸡系统：孵化器（家具912）孵化槽（1件=1槽）
;--------------------------------------------------------
#DIMS SAVEDATA 孵化槽_蛋种	;孵化中的蛋类物品名（空=未孵化）
#DIM SAVEDATA 孵化槽_生物ID	;孵出的生物CritterData ID
#DIM SAVEDATA 孵化槽_剩余天数	;剩余孵化天数
;抚摸每日标记（0=今天还没抚摸过，1=已抚摸，每日事件重置）
#DIM SAVEDATA 抚摸済み, 8
;饲料箱存量（开关开启时容量5盒，每日消耗1盒；BIRD_FEED仍存当前饲料编码）
#DIM SAVEDATA 饲料存量
#DIM CONST 饲料箱容量 = 5

;--------------------------------------------------------
; 酿酒系统：橡木酒桶（酒桶0=原版酒虫，酒桶1～5由家具屋914打造，最多5个）
;--------------------------------------------------------
#DIMS SAVEDATA 酒桶_内容物, 6	;各酒桶内的内容物名称（空=空桶）
#DIM SAVEDATA 酒桶_天数, 6	;各酒桶内发酵经过的天数
;--------------------------------------------------------
; 钓鱼系统：隙间渔获（钓鱼2.0，渔获与道具解耦）
;   捕获的鱼按「鱼种+个体尺寸」存入 QOL_FISH_INSTANCE 实例表（随存档，见 VarExtGameData.csv）；
;   手动「获取鱼肉」时才转换为道具（鱼707/好吃的鱼708）。
;   容量 = 隙间基础容量 + 扩容次数，上限 隙间容量上限；扩容消耗「收藏隙間」（ITEM:400）。
;--------------------------------------------------------
#DIM SAVEDATA 生活系统_隙间扩容次数 ;隙间扩容次数（容量=基础+次数，上限90）
#DIM CONST 隙间基础容量 = 30
#DIM CONST 隙间容量上限 = 90
#DIM CONST 隙间扩容消耗 = 10        ;扩容消耗收藏隙間（ITEM:400）个数

