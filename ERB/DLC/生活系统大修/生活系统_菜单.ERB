;========================================================
; 生活系统大修 - 设置菜单
; 文件：ERB/DLC/生活系统大修/生活系统_菜单.ERB
;
; 入口：DLC设置 → [69] 生活系统大修（OPTIONPRINT.ERB 的 C_List:69，
;       DLCCHIOSEMENU.ERB 的 @GETINFO_DLC CASE 69 调用本文件 @生活系统_主菜单）
;
; 包含：
;   @生活系统_主菜单       子系统主菜单（养鸡/种地/酿酒/钓鱼启停）
;   @生活系统_子系统菜单   单个子系统的开关与说明
;========================================================

;--------------------------------------------------------
; 生活系统大修 · 主菜单
; 由 DLCCHIOSEMENU 的 CASE 69 调用
;--------------------------------------------------------
@生活系统_主菜单
#LOCALSIZE 2
#LOCALSSIZE 1
LOCAL = LINECOUNT
$LIFE_MENU
PRINTFORML 生活系统大修 · 主菜单
PRINTFORML 对养鸡/种地/酿酒/钓鱼生活玩法的强化，各子系统独立启停
PRINTL
SIF 生活系统_养鸡
	SETCOLOR 0x00FF00
PRINTFORML [1] 养鸡系统　　\@ 生活系统_养鸡 ? [已生效] # [未启动] \@
RESETCOLOR
SIF 生活系统_种地
	SETCOLOR 0x00FF00
PRINTFORML [2] 种地系统　　\@ 生活系统_种地 ? [已生效] # [未启动] \@
RESETCOLOR
SIF 生活系统_酿酒
	SETCOLOR 0x00FF00
PRINTFORML [3] 酿酒系统　　\@ 生活系统_酿酒 ? [已生效] # [未启动] \@
RESETCOLOR
SIF 生活系统_钓鱼
	SETCOLOR 0x00FF00
PRINTFORML [4] 钓鱼系统　　\@ 生活系统_钓鱼 ? [已生效] # [未启动] \@
RESETCOLOR
PRINTL
PRINTFORML ※ 咸鸭蛋产业链（鸭蛋→调合→腌制→咸鸭蛋）需要「养鸡系统」与「酿酒系统」同时开启
PRINTL
PRINTFORML [0] 一键关闭所有子系统　[99] 返回
INPUT
SELECTCASE RESULT
	CASE 0
		;一键关闭所有子系统
		生活系统_养鸡 = 0
		生活系统_种地 = 0
		生活系统_酿酒 = 0
		生活系统_钓鱼 = 0
		PRINTFORMW 已关闭所有生活系统子系统
		RESTART
	CASE 1 TO 4
		CALL 生活系统_子系统菜单(RESULT)
		CLEARLINE LINECOUNT - LOCAL
		GOTO LIFE_MENU
	CASE 99
		RETURN
	CASEELSE
		CLEARLINE LINECOUNT - LOCAL
		GOTO LIFE_MENU
ENDSELECT

;--------------------------------------------------------
; 子系统设置子菜单
; ARG: 1=养鸡 2=种地 3=酿酒 4=钓鱼
;--------------------------------------------------------
@生活系统_子系统菜单(ARG)
#LOCALSIZE 2
#LOCALSSIZE 2
;LOCAL:1 = 进入时行数（用于 CLEARLINE）
LOCAL:1 = LINECOUNT
SELECTCASE ARG
	CASE 1
		LOCAL = 生活系统_养鸡
		LOCALS = 养鸡系统
		LOCALS:1 = 强化鸡舍养殖玩法：收蛋、饲料、亲密度、孵化器、自动抚摸机等。※ 咸鸭蛋产业链（鸭蛋→调合→腌制）需要与「酿酒系统」同时开启
	CASE 2
		LOCAL = 生活系统_种地
		LOCALS = 种地系统
		LOCALS:1 = 新增「育苗」指令：在菜园旁消耗采集素材育成种子，种子可在家庭菜园种植。越是珍贵的作物收成越稀少，成熟期的收成格外丰厚；浆果与菌菇类收获后还能再收一茬
	CASE 3
		LOCAL = 生活系统_酿酒
		LOCALS = 酿酒系统
		LOCALS:1 = 酿酒玩法扩展：橡木酒桶（酒桶0=原版酒虫，酒桶1～5由家具屋打造，每个独立酿酒）。※ 咸鸭蛋腌制（清酒中添加待腌制的咸鸭蛋）需要与「养鸡系统」同时开启
	CASE 4
		LOCAL = 生活系统_钓鱼
		LOCALS = 钓鱼系统
		LOCALS:1 = 以钓鱼小游戏取代原本的钓鱼判定：浮漂下沉时提竿，拉锯战中选对方向与鱼角力，在它挣脱之前拉上来
	CASEELSE
		RETURN
ENDSELECT
$LIFE_SUB_MENU
PRINTFORML 【%LOCALS%】　\@ LOCAL ? [已生效] # [未启动] \@
PRINTFORML %LOCALS:1%
SIF ARG == 2
	PRINTFORML 提示：先去图书馆寻找一下耕种的基础教程再开始尝试种地会比较好
PRINTL
PRINTFORML [0] \@ LOCAL ? 关闭本子系统 # 启动本子系统 \@
SIF ARG == 4
	PRINTFORML [2] 难度：\@ 生活系统_钓鱼_难度 ? [简单] # [默认] \@
SIF ARG == 4
	PRINTFORML [3] 钓鱼小游戏玩法说明
PRINTFORML [9] 返回主菜单
INPUT
SELECTCASE RESULT
	CASE 0
		SELECTCASE ARG
			CASE 1
				生活系统_养鸡 = !生活系统_养鸡
			CASE 2
				生活系统_种地 = !生活系统_种地
			CASE 3
				生活系统_酿酒 = !生活系统_酿酒
			CASE 4
				生活系统_钓鱼 = !生活系统_钓鱼
		ENDSELECT
		LOCAL = !LOCAL
		PRINTFORMW %LOCALS%已\@ LOCAL ? 启动 # 关闭 \@
		CLEARLINE LINECOUNT - LOCAL:1
		GOTO LIFE_SUB_MENU
	CASE 2
		;难度切换（仅钓鱼）
		IF ARG == 4
			生活系统_钓鱼_难度 = !生活系统_钓鱼_难度
			PRINTFORMW 钓鱼小游戏难度已切换为\@ 生活系统_钓鱼_难度 ? [简单] # [默认] \@
		ENDIF
		CLEARLINE LINECOUNT - LOCAL:1
		GOTO LIFE_SUB_MENU
	CASE 3
		;玩法说明（仅钓鱼）
		IF ARG == 4
			PRINTL 钓鱼小游戏玩法说明
			PRINTL 提竿：浮漂下沉后需在倒计时内按[0]提竿，超时脱钩
			PRINTL 拉锯：鱼会向四个方向之一逃窜，选择与其相反的方向拉竿
			PRINTL 选对方向扣除鱼体力，选错则鱼恢复体力
			PRINTL 在鱼挣脱之前耗尽它的体力即为成功
			PRINTFORMW 钓鱼技艺越高反应时间越长，技艺精湛时正确方向会以黄色高亮
		ENDIF
		CLEARLINE LINECOUNT - LOCAL:1
		GOTO LIFE_SUB_MENU
	CASE 9
		RETURN
	CASEELSE
		CLEARLINE LINECOUNT - LOCAL:1
		GOTO LIFE_SUB_MENU
ENDSELECT
