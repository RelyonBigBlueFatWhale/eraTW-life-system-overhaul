;========================================================
; 生活系统大修 - 设置菜单
; 文件：ERB/DLC/生活系统大修/生活系统_菜单.ERB
;
; 入口：DLC设置 → [69] 生活系统大修（OPTIONPRINT.ERB 的 C_List:69，
;       DLCCHIOSEMENU.ERB 的 @GETINFO_DLC CASE 69 调用本文件 @生活系统_主菜单）
;
; 交互设计（v2.0 重制）：
;   - 单层菜单：四个子系统开关直接在主菜单切换，不再进入子菜单
;   - [0] 统一为"返回"（与全游戏习惯一致，避免误触）
;   - 「全部关闭」为危险操作：移至 [7] 且必须二次确认，不触发 RESTART
;     （开关判定实时生效，无需重启；原版误触 [0] 会关闭全部并重启导致当日进度丢失）
;========================================================

;--------------------------------------------------------
; 生活系统大修 · 主菜单
; 由 DLCCHIOSEMENU 的 CASE 69 调用
;--------------------------------------------------------
@生活系统_主菜单
#LOCALSIZE 2
#LOCALSSIZE 1
;从 DLC 设置进入时，先清除上方的 DLC 选项列表，避免与本菜单叠加
CLEARLINE LINECOUNT - 0
LOCAL = LINECOUNT
IF !生活系统_QOL已注册
        生活系统_QOL已注册 = 1
        CALL QOL_ITEM_DATA_REGISTER
        ;同步刷新药房数据（巧克力转换等新增调合产物/配方），避免旧 qol_data.db 未注册
        CALL QOL_PHARMA_DATA_REGISTER
ENDIF
;任一子系统开启时自动启用自定义指令显示（育苗/开荒等入口）
SIF 生活系统_养鸡 || 生活系统_种地 || 生活系统_酿酒 || 生活系统_钓鱼 || 生活系统_养蜂 || 生活系统_鱼塘 || 生活系统_倒掉饭菜
        ADD_CUSTOM_COM_SWITCH = 1
$LIFE_MENU
SETCOLOR C_CREAM
PRINTFORML 　　　　生活系统大修 · 设置
RESETCOLOR
PRINTFORML 　让田园生活焕然一新，各子系统独立启停
DRAWLINE
PRINTFORML 　【生产 · 养殖】
SIF 生活系统_养鸡
        SETCOLOR 0x00FF00
PRINTFORML 　[1] 养鸡系统　　　\@ 生活系统_养鸡 ? [已生效] # [未启动] \@
RESETCOLOR
SIF 生活系统_种地
        SETCOLOR 0x00FF00
PRINTFORML 　[2] 种地系统　　　\@ 生活系统_种地 ? [已生效] # [未启动] \@
RESETCOLOR
SIF 生活系统_酿酒
        SETCOLOR 0x00FF00
PRINTFORML 　[3] 酿酒系统　　　\@ 生活系统_酿酒 ? [已生效] # [未启动] \@
RESETCOLOR
SIF 生活系统_钓鱼
        SETCOLOR 0x00FF00
PRINTFORML 　[4] 钓鱼系统　　　\@ 生活系统_钓鱼 ? [已生效] # [未启动] \@
RESETCOLOR
SIF 生活系统_养蜂
        SETCOLOR 0x00FF00
PRINTFORML 　[5] 养蜂系统　　　\@ 生活系统_养蜂 ? [已生效] # [未启动] \@
RESETCOLOR
SIF 生活系统_鱼塘
        SETCOLOR 0x00FF00
PRINTFORML 　[6] 鱼塘系统　　　\@ 生活系统_鱼塘 ? [已生效] # [未启动] \@
RESETCOLOR
PRINTFORML 　【联动 · 拓展】
SIF 生活系统_魔法联动
        SETCOLOR 0x00FF00
PRINTFORML 　[7] 魔法版联动内容 \@ 生活系统_魔法联动 ? [已生效] # [未启动] \@
RESETCOLOR
SIF 生活系统_武道大会
        SETCOLOR 0x00FF00
PRINTFORML 　[8] 天下第一武道大会 \@ 生活系统_武道大会 ? [已生效] # [未启动] \@
RESETCOLOR
PRINTFORML 　【劳动 · 学习】
SIF 生活系统_伐木增强
        SETCOLOR 0x00FF00
PRINTFORML 　[13] 伐木系统增强　\@ 生活系统_伐木增强 ? [已生效] # [未启动] \@（无需自带工具/更易获高级木材）
RESETCOLOR
SIF 生活系统_学习教育 || 生活系统_悟性
        SETCOLOR 0x00FF00
PRINTFORML 　[14] 学习与教育系统改进 （成人再教育 / 悟性系统）
RESETCOLOR
PRINTFORML 　【体验 · 便捷】
SIF 生活系统_读书 || 生活系统_料理委托改善 || 生活系统_巧克力转换 || 生活系统_活跃妖精
        SETCOLOR 0x00FF00
PRINTFORML 　[9] 生活质量提升 （读书 / 料理委托改善 / 巧克力转换 / 妖精集团 等）
RESETCOLOR
SIF 生活系统_音乐
        SETCOLOR 0x00FF00
PRINTFORML 　[10] 音乐开关　　 \@ 生活系统_音乐 ? [已生效] # [未启动] \@
RESETCOLOR
PRINTFORML 　[11] 钓鱼难度　　 \@ 生活系统_钓鱼_难度 ? [简单] # [默认] \@
PRINTFORML 　[12] 玩法说明
DRAWLINE
PRINTFORML 　　　　　　　　　　[0] 返回　　　[15] 全部关闭（需确认）
INPUT
SELECTCASE RESULT
        CASE 1 TO 6
                SELECTCASE RESULT
                        CASE 1
                                生活系统_养鸡 = !生活系统_养鸡
                                PRINTFORMW 养鸡系统已\@ 生活系统_养鸡 ? 启动 # 关闭 \@
                        CASE 2
                                生活系统_种地 = !生活系统_种地
                                PRINTFORMW 种地系统已\@ 生活系统_种地 ? 启动 # 关闭 \@
                        CASE 3
                                生活系统_酿酒 = !生活系统_酿酒
                                PRINTFORMW 酿酒系统已\@ 生活系统_酿酒 ? 启动 # 关闭 \@
                        CASE 4
                                生活系统_钓鱼 = !生活系统_钓鱼
                                PRINTFORMW 钓鱼系统已\@ 生活系统_钓鱼 ? 启动 # 关闭 \@
                        CASE 5
                                生活系统_养蜂 = !生活系统_养蜂
                                PRINTFORMW 养蜂系统已\@ 生活系统_养蜂 ? 启动 # 关闭 \@
                        CASE 6
                                生活系统_鱼塘 = !生活系统_鱼塘
                                PRINTFORMW 鱼塘系统已\@ 生活系统_鱼塘 ? 启动 # 关闭 \@
                ENDSELECT
                SIF 生活系统_养鸡 || 生活系统_种地 || 生活系统_酿酒 || 生活系统_钓鱼 || 生活系统_养蜂 || 生活系统_鱼塘 || 生活系统_倒掉饭菜
                        ADD_CUSTOM_COM_SWITCH = 1
                CLEARLINE LINECOUNT - LOCAL
                GOTO LIFE_MENU
        CASE 7
                生活系统_魔法联动 = !生活系统_魔法联动
                PRINTFORMW 魔法版联动内容已\@ 生活系统_魔法联动 ? 启动 # 关闭 \@
                CLEARLINE LINECOUNT - LOCAL
                GOTO LIFE_MENU
        CASE 8
                生活系统_武道大会 = !生活系统_武道大会
                PRINTFORMW 天下第一武道大会已\@ 生活系统_武道大会 ? 启动 # 关闭 \@
                CLEARLINE LINECOUNT - LOCAL
                GOTO LIFE_MENU
        CASE 9
                CALL 生活系统_生活质量菜单
                CLEARLINE LINECOUNT - LOCAL
                GOTO LIFE_MENU
        CASE 10
                生活系统_音乐 = !生活系统_音乐
                PRINTFORMW 音乐开关已\@ 生活系统_音乐 ? 启动 # 关闭 \@（需音乐补丁开关同时开启）
                CLEARLINE LINECOUNT - LOCAL
                GOTO LIFE_MENU
        CASE 11
                生活系统_钓鱼_难度 = !生活系统_钓鱼_难度
                PRINTFORMW 钓鱼小游戏难度已切换为\@ 生活系统_钓鱼_难度 ? [简单] # [默认] \@
                CLEARLINE LINECOUNT - LOCAL
                GOTO LIFE_MENU
        CASE 12
                PRINTL 【养鸡】强化鸡舍养殖：收蛋、饲料、亲密度、孵化器、自动抚摸机
                PRINTL 【种地】新增「育苗」指令：在菜园旁消耗采集素材育成种子，可种植新作物
                PRINTL 【酿酒】橡木酒桶独立发酵（酒桶0=原版酒虫，1~5由家具屋打造）
                PRINTL 【钓鱼】小游戏：浮漂下沉时提竿；捕获的鱼暂存于「隙间渔获」
                PRINTL 【养蜂】蜂箱采蜜，为开花作物授粉增产/催熟；熊与妖精的事件等你发掘
                PRINTL 【鱼塘】养鱼繁殖，卖鱼/取肉/收回隙间；鲟鱼卵入酒桶腌成鱼子酱
                PRINTL 【伐木增强】无需自带伐木工具即可伐木，等级越高越容易获得高级木材
                PRINTL 【学习与教育】向擅长某项技能的少女学习，花钱买经验（关系越好越便宜）
                PRINTL 【生活质量提升】读书 / 料理委托改善 / 巧克力转换 / 活跃的妖精集团
                PRINTFORMW 按任意键返回
                CLEARLINE LINECOUNT - LOCAL
                GOTO LIFE_MENU
        CASE 13
                生活系统_伐木增强 = !生活系统_伐木增强
                增强的伐木系统开关 = 生活系统_伐木增强
                PRINTFORMW 伐木系统增强已\@ 生活系统_伐木增强 ? 启动 # 关闭 \@
                CLEARLINE LINECOUNT - LOCAL
                GOTO LIFE_MENU
        CASE 14
                CALL 生活系统_学习教育菜单
                CLEARLINE LINECOUNT - LOCAL
                GOTO LIFE_MENU
        CASE 15
                PRINTFORML 确定要关闭全部生活系统子系统吗？
                CALL ASK_YN, "确认关闭", "再想想"
                IF RESULT == 0
                        生活系统_养鸡 = 0
                        生活系统_种地 = 0
                        生活系统_酿酒 = 0
                        生活系统_钓鱼 = 0
                        生活系统_读书 = 0
                        生活系统_料理委托改善 = 0
                        生活系统_养蜂 = 0
                        生活系统_鱼塘 = 0
                        生活系统_魔法联动 = 0
                        生活系统_武道大会 = 0
                        生活系统_音乐 = 0
                        生活系统_巧克力转换 = 0
                        生活系统_活跃妖精 = 0
                        生活系统_水龙头 = 0
                        生活系统_倒掉饭菜 = 0
                        生活系统_伐木增强 = 0
                        生活系统_学习教育 = 0
                        生活系统_悟性 = 0
                        增强的伐木系统开关 = 0
                        成人再教育插件开关 = 0
                        悟性系统开关 = 0
                        PRINTFORMW 已关闭所有生活系统子系统
                        RETURN
                ENDIF
                CLEARLINE LINECOUNT - LOCAL
                GOTO LIFE_MENU
        CASE 0
                RETURN
        CASEELSE
                CLEARLINE LINECOUNT - LOCAL
                GOTO LIFE_MENU
ENDSELECT

;--------------------------------------------------------
; 学习与教育系统改进 · 子菜单
;--------------------------------------------------------
@生活系统_学习教育菜单
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = LINECOUNT
$EDU_MENU
SETCOLOR C_CREAM
PRINTFORML 　　　　学习与教育系统改进 · 设置
RESETCOLOR
PRINTFORML 　向擅长的少女学习、花钱买经验的进修插件
DRAWLINE
SIF 生活系统_学习教育
        SETCOLOR 0x00FF00
PRINTFORML 　[1] 成人再教育　 \@ 生活系统_学习教育 ? [已生效] # [未启动] \@（向少女学习技能，花钱买经验）
RESETCOLOR
SIF 生活系统_悟性
        SETCOLOR 0x00FF00
PRINTFORML 　[2] 悟性系统　 \@ 生活系统_悟性 ? [已生效] # [未启动] \@（提升学习效率）
RESETCOLOR
SIF 生活系统_教育_同伴经验
        SETCOLOR 0x00FF00
PRINTFORML 　[3] 同伴经验　 \@ 生活系统_教育_同伴经验 ? [已生效] # [未启动] \@（授课经验同时给予同行少女）
RESETCOLOR
IF 生活系统_教育_价格档 == 0
	PRINTFORML 　[4] 学费档位　[不变]（按同行人数加算）
ELSEIF 生活系统_教育_价格档 == 1
	PRINTFORML 　[4] 学费档位　[1.5]（按同行人数加算）
ELSE
	PRINTFORML 　[4] 学费档位　[2]（按同行人数加算）
ENDIF
DRAWLINE
PRINTFORML 　[0] 返回
INPUT
SELECTCASE RESULT
        CASE 1
                生活系统_学习教育 = !生活系统_学习教育
                成人再教育插件开关 = 生活系统_学习教育
                PRINTFORMW 成人再教育已\@ 生活系统_学习教育 ? 启动 # 关闭 \@
        CASE 2
                生活系统_悟性 = !生活系统_悟性
                悟性系统开关 = 生活系统_悟性
                PRINTFORMW 悟性系统已\@ 生活系统_悟性 ? 启动 # 关闭 \@
        CASE 3
                生活系统_教育_同伴经验 = !生活系统_教育_同伴经验
                PRINTFORMW 同伴经验已\@ 生活系统_教育_同伴经验 ? 启动 # 关闭 \@
        CASE 4
                生活系统_教育_价格档 = (生活系统_教育_价格档 + 1) % 3
                IF 生活系统_教育_价格档 == 0
	PRINTFORML 学费档位已切换为[不变]（按同行人数加算）
ELSEIF 生活系统_教育_价格档 == 1
	PRINTFORML 学费档位已切换为[1.5]（按同行人数加算）
ELSE
	PRINTFORML 学费档位已切换为[2]（按同行人数加算）
ENDIF
        CASE 0
                RETURN
        CASEELSE
ENDSELECT
CLEARLINE LINECOUNT - LOCAL
GOTO EDU_MENU

;--------------------------------------------------------
; 生活质量提升 · 子菜单
;--------------------------------------------------------
@生活系统_生活质量菜单
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = LINECOUNT
$QOL_MENU
SETCOLOR C_CREAM
PRINTFORML 　　　　生活质量提升 · 设置
RESETCOLOR
PRINTFORML 　让日常体验更顺手的小开关
DRAWLINE
SIF 生活系统_读书
        SETCOLOR 0x00FF00
PRINTFORML 　[1] 读书系统　　　\@ 生活系统_读书 ? [已生效] # [未启动] \@
RESETCOLOR
SIF 生活系统_料理委托改善
        SETCOLOR 0x00FF00
PRINTFORML 　[2] 料理委托改善 \@ 生活系统_料理委托改善 ? [已生效] # [未启动] \@（委托17提示最佳菜谱/做菜高亮）
RESETCOLOR
SIF 生活系统_巧克力转换
        SETCOLOR 0x00FF00
PRINTFORML 　[3] 巧克力转换　 \@ 生活系统_巧克力转换 ? [已生效] # [未启动] \@（黑雷神/高级巧克力  料理用巧克力）
RESETCOLOR
SIF 生活系统_活跃妖精
        SETCOLOR 0x00FF00
PRINTFORML 　[4] 活跃的妖精集团 \@ 生活系统_活跃妖精 ? [已生效] # [未启动] \@（每晚妖精来访，可教训/投喂黑雷神巧克力）
RESETCOLOR
SIF 生活系统_水龙头
        SETCOLOR 0x00FF00
PRINTFORML 　[5] 水龙头　 \@ 生活系统_水龙头 ? [已生效] # [未启动] \@（酒虫所在的自宅各处均可打普通水）
RESETCOLOR
SIF 生活系统_倒掉饭菜
        SETCOLOR 0x00FF00
PRINTFORML 　[6] 倒掉饭菜　 \@ 生活系统_倒掉饭菜 ? [已生效] # [未启动] \@（携带料理时可使用「倒掉饭菜」指令）
RESETCOLOR
DRAWLINE
PRINTFORML 　[0] 返回
INPUT
SELECTCASE RESULT
        CASE 1
                生活系统_读书 = !生活系统_读书
                PRINTFORMW 读书系统已\@ 生活系统_读书 ? 启动 # 关闭 \@
        CASE 2
                生活系统_料理委托改善 = !生活系统_料理委托改善
                PRINTFORMW 料理委托改善已\@ 生活系统_料理委托改善 ? 启动 # 关闭 \@
        CASE 3
                生活系统_巧克力转换 = !生活系统_巧克力转换
                SIF 生活系统_巧克力转换
                        CALL QOL_PHARMA_DATA_REGISTER
                PRINTFORMW 巧克力转换已\@ 生活系统_巧克力转换 ? 启动 # 关闭 \@
        CASE 4
                生活系统_活跃妖精 = !生活系统_活跃妖精
                PRINTFORMW 活跃的妖精集团已\@ 生活系统_活跃妖精 ? 启动 # 关闭 \@
        CASE 5
                生活系统_水龙头 = !生活系统_水龙头
                PRINTFORMW 水龙头已\@ 生活系统_水龙头 ? 启动 # 关闭 \@
        CASE 6
                生活系统_倒掉饭菜 = !生活系统_倒掉饭菜
                PRINTFORMW 倒掉饭菜已\@ 生活系统_倒掉饭菜 ? 启动 # 关闭 \@
        CASE 0
                RETURN
        CASEELSE
ENDSELECT
CLEARLINE LINECOUNT - LOCAL
GOTO QOL_MENU