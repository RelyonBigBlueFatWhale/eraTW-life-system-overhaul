;========================================================
; 生活系统大修 - 天下第一武道大会（v2.1.9 休整版 · 二轮）
; 文件：ERB/DLC/生活系统大修/生活系统_武道大会.ERB
;
; 设定：博丽神社境内矗立着一座神秘的擂台，踏上擂台即可向全幻想乡的少女
;       发出挑战书，并借助隙间将对方传送到擂台上。（因此仅能在神社境内举行）
;  - 挑战费用：10000 × 对方战斗力等级（隙间传送费）
;  - 炸鱼惩罚：挑战战斗力等级低于自己的对手时，需压制实力或支付补偿
;  - 名单：跳过路人子、跳过与玩家同名的复制体；显示 战斗技能等级（原版彩色评级）
;          与 战斗技能（弹幕特能）；底部 上一页/下一页 居中 + 第X页/共Y页
;  - 排序：默认按角色编号 / 按战斗力顺序 / 按战斗力倒序
;  - 随机匹配：优先匹配与玩家战斗力等级接近的对手
;  - 对战：TARGET=对方 → CALL COM480 复用标准弹幕胜负
;  - 开关：生活系统大修设置 → [10] 天下第一武道大会
;========================================================

@生活系统_武道大会
#LOCALSIZE 11
#LOCALSSIZE 1
#DIM L_LIST, 220      ;参赛者角色ID列表（显示顺序）
#DIM L_SORTED, 220    ;战斗力排序/随机匹配临时列表
#DIM DYNAMIC L_PAGE   ;分页偏移
;门控：开关 + 博丽神社境内（据点 神社境内=20 / 外出 P2境内=2）
IF !生活系统_武道大会 || (CFLAG:MASTER:現在位置 != 神社境内 && CFLAG:MASTER:現在位置 != P2境内)
        PRINTFORML 现在这里无法召开天下第一武道大会……
        RETURN -1
ENDIF
;防御：清空上次的压制强度残留
生活系统_武道大会_压制强度 = 0
LOCAL:9 = 0  ;排序模式：0=角色编号 1=战斗力升序 2=战斗力降序
$大会_循环
LOCAL:0 = LINECOUNT
;收集名单（CHARASORT_EX 返回全部角色 ID，跳过 MASTER、与玩家同名者、路人子）
CALL CHARASORT_EX
LOCAL:1 = 0
FOR LOCAL:2, 0, EX_CHARANUM
        LOCAL:3 = RESULT:(LOCAL:2)
        SIF LOCAL:3 < 0
                CONTINUE
        SIF LOCAL:3 == MASTER
                CONTINUE
        SIF CALLNAME:(LOCAL:3) == CALLNAME:MASTER
                CONTINUE
        SIF TALENT:(LOCAL:3):路人
                CONTINUE
        L_LIST:(LOCAL:1) = LOCAL:3
        LOCAL:1 ++
NEXT
;按战斗力排序（桶排序：ABL:戦闘能力 0~6）
IF LOCAL:9 > 0
        LOCAL:6 = 0
        IF LOCAL:9 == 1
                ;升序
                FOR LOCAL:7, 0, 6
                        FOR LOCAL:4, 0, LOCAL:1
                                LOCAL:5 = L_LIST:(LOCAL:4)
                                SIF ABL:(LOCAL:5):戦闘能力 != LOCAL:7
                                        CONTINUE
                                L_SORTED:(LOCAL:6) = LOCAL:5
                                LOCAL:6 ++
                        NEXT
                NEXT
        ELSE
                ;降序
                FOR LOCAL:7, 6, 0, -1
                        FOR LOCAL:4, 0, LOCAL:1
                                LOCAL:5 = L_LIST:(LOCAL:4)
                                SIF ABL:(LOCAL:5):戦闘能力 != LOCAL:7
                                        CONTINUE
                                L_SORTED:(LOCAL:6) = LOCAL:5
                                LOCAL:6 ++
                        NEXT
                NEXT
        ENDIF
        FOR LOCAL:4, 0, LOCAL:1
                L_LIST:(LOCAL:4) = L_SORTED:(LOCAL:4)
        NEXT
ENDIF
;开场设定
PRINTFORML 【天下第一武道大会】博丽神社境内矗立着一座神秘的擂台。
PRINTFORML 　　踏上擂台，即可向全幻想乡的少女发出挑战书，并借助隙间将对方传送到擂台上！
;首次进入：博丽先代指引文本
IF FIRSTTIME("生活系统_武道大会_初次",,-1)
        PRINTFORML 根据博丽先代的指引，你找到了被结界笼罩的一处擂台，将其打扫干净后，你从上面感受到了隙间的力量。
        PRINTFORML 在擂台的下方，有一个小小的赛钱箱，似乎是只要花费金钱就可以使用这个擂台的力量。
        PRINTFORML 这是什么类似〇人〇打的设定吗？无论如何，似乎在上面挑战幻想乡的强者更方便了。
        PRINTL
ENDIF
DRAWLINE
PRINTFORML 参赛者共{LOCAL:1}人　（挑战需支付隙间传送费用）
;分页显示：每页20人
LOCAL:2 = MIN(LOCAL:1, L_PAGE + 20)
LOCAL:3 = 0
FOR LOCAL:4, L_PAGE, LOCAL:2
        LOCAL:3 ++
        LOCAL:5 = L_LIST:(LOCAL:4)
        ;状态标记
        LOCALS '= ""
        IF !CFLAG:(LOCAL:5):面識
                LOCALS '= "（陌生）"
        ENDIF
        IF TCVAR:(LOCAL:5):弾幕勝負不能
                LOCALS '= "（今日已战）"
        ENDIF
        SIF CFLAG:(LOCAL:5):弾幕勝負勝利
                LOCALS '= "★胜"
        ;名字 + 评级 + 战斗技能
        PRINTFORM [{LOCAL:3,2}] %CALLNAME:(LOCAL:5)%
        PRINTPLAINFORM 　
        LOCAL:8 = MAX(6 - ABL:(LOCAL:5):戦闘能力, 0)
        CALL PRINT_ALPHABET(LOCAL:8, 7)
        CALL 生活系统_武道大会_技能显示(LOCAL:5)
        PRINTFORM %LOCALS%
        PRINTL
NEXT
DRAWLINE
;分页栏（居中显示 上一页/下一页 + 第X页/共Y页，位于名单下方）
CALL 生活系统_武道大会_分页栏(LOCAL:1, L_PAGE)
;擂台战计数与奖励（计数 >0 且今日未领取时可领）
LOCALS '= @"擂台战胜利人数：{生活系统_武道大会_胜利数}　"
IF 生活系统_武道大会_胜利数 > 0 && 生活系统_武道大会_奖励领取日 != DAY:0
        LOCALS += @"<button value='10'>【领取奖励】</button>"
ELSE
        LOCALS += @"<nonbutton title='今天已领取或暂无胜利'>【领取奖励】</nonbutton>"
ENDIF
HTML_PRINT LOCALS + "<br>"
;底部选项
PRINTL [0] 返回　　[5] 随机匹配（优先实力接近）
SELECTCASE LOCAL:9
        CASE 0
                PRINTL [7] 按战斗力顺序　[8] 按战斗力倒序
        CASE 1
                PRINTL [6] 按角色编号排列　[8] 按战斗力倒序
        CASEELSE
                PRINTL [6] 按角色编号排列　[7] 按战斗力顺序
ENDSELECT
$大会_输入
INPUT
SELECTCASE RESULT
        CASE 0
                RETURN 1
        CASE 4
                ;上一页
                IF L_PAGE > 0
                        L_PAGE -= 20
                        GOTO 大会_重新显示
                ENDIF
                CLEARLINE 1
                GOTO 大会_输入
        CASE 10
                ;领取擂台战奖励：胜利人数×100 临时TSP上限/精力上限（当日有效）
                IF 生活系统_武道大会_胜利数 > 0 && 生活系统_武道大会_奖励领取日 != DAY:0
                        LOCAL:2 = 生活系统_武道大会_胜利数 * 100
                        CALL BUFF_BASE(MASTER, BASE_TSP, LOCAL:2, 1)
                        CALL BUFF_BASE(MASTER, BASE_精力, LOCAL:2, 1)
                        ;宝藏袋功能开启时额外获得 胜利人数 个宝藏袋（黄金律加成）
                        IF 生活系统_魔法联动 && MAGIC_DLC && MAGIC_DLC_宝藏袋
                                LOCAL:3 = 生活系统_武道大会_胜利数
                                IF TALENT:MASTER:黄金律 && MAGIC_DLC_魔法成就
                                        LOCAL:3 += LOCAL:3 * 3 / 10
                                ENDIF
                                ITEM:ITEM_宝藏袋 += LOCAL:3
                        ENDIF
                        生活系统_武道大会_奖励领取日 = DAY:0
                        ;原生消息流：直接 PRINTFORML 提示，不清屏，保留在名单下方直到下一次操作
                        SETCOLOR C_YELLOW
                        PRINTFORML ────────── 擂台战奖励 ──────────
                        PRINTFORML 　临时TSP上限 +{LOCAL:2}（当日有效）
                        PRINTFORML 　临时精力上限 +{LOCAL:2}（当日有效）
                        IF 生活系统_魔法联动 && MAGIC_DLC && MAGIC_DLC_宝藏袋
                                PRINTFORML 　%ITEMNAME_TR(ITEM_宝藏袋)% ×{LOCAL:3}（黄金律加成）
                        ENDIF
                        RESETCOLOR
                        ;原生输入：任意鼠标按键（左/右）或键盘 → 返回主界面
                        INPUT 999999, 1
                        GOTO 大会_重新显示
                ENDIF
                ;已领取过：刷新界面（按钮置灰）
                GOTO 大会_重新显示
        CASE 5
                ;随机匹配：优先匹配与玩家战斗力等级接近的对手
                LOCAL:7 = ABL:MASTER:戦闘能力
                LOCAL:2 = 0
                FOR LOCAL:3, 0, 7
                        LOCAL:2 = 0
                        FOR LOCAL:4, 0, LOCAL:1
                                LOCAL:5 = L_LIST:(LOCAL:4)
                                SIF ABS(ABL:(LOCAL:5):戦闘能力 - LOCAL:7) != LOCAL:3
                                        CONTINUE
                                L_SORTED:(LOCAL:2) = LOCAL:5
                                LOCAL:2 ++
                        NEXT
                        SIF LOCAL:2 > 0
                                BREAK
                NEXT
                IF LOCAL:2 == 0
                        PRINTFORMW 现在没有合适的对手可以匹配……
                        GOTO 大会_重新显示
                ENDIF
                LOCAL:5 = L_SORTED:(RAND:(LOCAL:2))
                PRINTFORML 随机匹配：%CALLNAME:(LOCAL:5)%接下了你的挑战书！
                CALL 生活系统_武道大会_挑战(LOCAL:5)
                GOTO 大会_重新显示
        CASE 6
                IF LOCAL:9 != 0
                        LOCAL:9 = 0
                        GOTO 大会_重新显示
                ENDIF
                CLEARLINE 1
                GOTO 大会_输入
        CASE 7
                IF LOCAL:9 != 1
                        LOCAL:9 = 1
                        GOTO 大会_重新显示
                ENDIF
                CLEARLINE 1
                GOTO 大会_输入
        CASE 8
                IF LOCAL:9 != 2
                        LOCAL:9 = 2
                        GOTO 大会_重新显示
                ENDIF
                CLEARLINE 1
                GOTO 大会_输入
        CASE 9
                ;下一页
                IF LOCAL:1 > 20 && LOCAL:2 < LOCAL:1
                        L_PAGE += 20
                        GOTO 大会_重新显示
                ENDIF
                CLEARLINE 1
                GOTO 大会_输入
        CASE 1 TO 20
                ;本页第N条 → 角色ID
                LOCAL:4 = L_PAGE + RESULT - 1
                IF LOCAL:4 < LOCAL:1
                        CALL 生活系统_武道大会_挑战(L_LIST:(LOCAL:4))
                        GOTO 大会_重新显示
                ENDIF
                CLEARLINE 1
                GOTO 大会_输入
        CASEELSE
                CLEARLINE 1
                GOTO 大会_输入
ENDSELECT
$大会_重新显示
CLEARLINE LINECOUNT - LOCAL:0
GOTO 大会_循环

;--------------------------------------------------------
; 发起挑战（名单选择 / 随机匹配共用）
; ARG = 对方角色ID；返回 1=开战 0=取消/失败
;--------------------------------------------------------
@生活系统_武道大会_挑战(ARG)
#LOCALSIZE 11
#LOCALSSIZE 1
;今日已战过则拒绝（沿用标准弹幕胜负的每日限制）
IF TCVAR:(ARG):弾幕勝負不能
        PRINTFORMW %CALLNAME:(ARG)%今天已经很累了，明天再来挑战吧
        RETURN 0
ENDIF
;隙间传送费用 = 10000 × 对方战斗力等级
LOCAL:6 = 10000 * ABL:(ARG):戦闘能力
;战斗等级差（对方低于自己 → 炸鱼）
LOCAL:7 = ABL:MASTER:戦闘能力 - ABL:(ARG):戦闘能力
;传送费检查
IF MONEY < LOCAL:6
        PRINTFORMW 身上的钱不够支付将%CALLNAME:(ARG)%传送过来的费用（需要%金额表示(LOCAL:6)%元）……
        RETURN 0
ENDIF
;炸鱼惩罚（对手战斗力等级低于自己）
IF LOCAL:7 > 0
        SETCOLOR C_RED
        PRINTFORML 炸鱼是一种极其不道德的行为，挑战比自己弱小太多的敌人根本没有意义吧？
        RESETCOLOR
        LOCAL:10 = 0
        IF ITEM:角虫养成外骨骼 || ITEM:大角虫养成外骨骼
                CALL ASK_M("我会压制自己的实力", 1, "我会给对方补偿", 1, "取消", 1)
                SELECTCASE RESULT
                        CASE 0
                                LOCAL:10 = 1
                        CASE 1
                                LOCAL:10 = 2
                        CASEELSE
                                PRINTFORMW 取消了挑战……
                                RETURN 0
                ENDSELECT
        ELSE
                CALL ASK_M("我会给对方补偿", 1, "取消", 1)
                SELECTCASE RESULT
                        CASE 0
                                LOCAL:10 = 2
                        CASEELSE
                                PRINTFORMW 取消了挑战……
                                RETURN 0
                ENDSELECT
        ENDIF
        ;压制实力：大角虫特训装置强度 = 10 × 等级差
        IF LOCAL:10 == 1
                生活系统_武道大会_压制强度 = 10 * LOCAL:7
                PRINTFORML 将大角虫特训装置的强度调整至{生活系统_武道大会_压制强度}！
        ;给对方补偿：10000 × 等级差
        ELSEIF LOCAL:10 == 2
                LOCAL:8 = 10000 * LOCAL:7
                CALL ASK_YN(@"需要%金额表示(LOCAL:8)%元，确定吗？")
                IF RESULT
                        PRINTFORMW 未支付补偿，取消了挑战……
                        RETURN 0
                ENDIF
                IF MONEY < LOCAL:6 + LOCAL:8
                        PRINTFORMW 身上的钱不够支付隙间传送与补偿费用……
                        RETURN 0
                ENDIF
                MONEY -= LOCAL:8
                PRINTFORMW 支付了%金额表示(LOCAL:8)%元作为补偿……
        ENDIF
ENDIF
;支付隙间传送费并开战
MONEY -= LOCAL:6
PRINTFORMW 消耗%金额表示(LOCAL:6)%元，通过隙间将%CALLNAME:(ARG)%传送到了擂台上！
;生活系统大修·音乐：骚话时播放《AIZO》（音乐补丁开关+生活系统音乐开关同时开启）
IF 音乐补丁开关 && 生活系统_音乐 && EXISTSOUND("AIZO.mp3")
        STOPSOUND
        PLAYSOUND "AIZO.mp3"
ENDIF
;开战前骚话（非炸鱼：对方战斗力不低于玩家时）
IF LOCAL:7 == 0
        PRINTFORML 开战前，%CALLNAME:MASTER%先来到%CALLNAME:(ARG)%面前，露出一个狂放的笑容，指着对方说到："先说好，你才是挑战者。"
ELSEIF LOCAL:7 < 0
        PRINTFORML 开战前，%CALLNAME:(ARG)%冷冷地对着玩家说道："你真的觉得你会赢吗？"，而%CALLNAME:MASTER%只是露出一个挑衅般的笑容，说道："会赢的。"
ENDIF
TARGET = ARG
;重置战果标记（防止 COM480 内取消时误判旧战果）
生活系统_武道大会_上次战果 = -1
CALL COM480
;擂台战战果：对方残机=0 → 玩家胜利
IF 生活系统_武道大会_上次战果 == 0
        生活系统_武道大会_胜利数 ++
        PRINTFORML 擂台战胜利！累计击败{生活系统_武道大会_胜利数}名对手！
        ;宝藏袋功能开启时，每次胜利奖励 20 个宝藏袋（黄金律加成）
        IF 生活系统_魔法联动 && MAGIC_DLC && MAGIC_DLC_宝藏袋
                LOCAL:2 = 20
                IF TALENT:MASTER:黄金律 && MAGIC_DLC_魔法成就
                        LOCAL:2 += LOCAL:2 * 3 / 10
                ENDIF
                ITEM:ITEM_宝藏袋 += LOCAL:2
                PRINTFORML 获得了{LOCAL:2}个%ITEMNAME_TR(ITEM_宝藏袋)%！
        ENDIF
ENDIF
RETURN 1

;--------------------------------------------------------
; 分页栏：居中显示 上一页/下一页 + 第X页/共Y页
;--------------------------------------------------------
@生活系统_武道大会_分页栏(总数, 偏移)
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM 总数
#DIM 偏移
#DIMS DYNAMIC HTML_STR
#DIM 当前页
#DIM 总页数
当前页 = 偏移 / 20 + 1
总页数 = MAX((总数 + 19) / 20, 1)
HTML_STR '= ""
IF 当前页 > 1
        HTML_STR += @"<button value='4'>【上一页】</button>"
ELSE
        HTML_STR += @"<nonbutton title='已是第一页'>【上一页】</nonbutton>"
ENDIF
HTML_STR += @"　第{当前页}页 / 共{总页数}页　"
IF 当前页 < 总页数
        HTML_STR += @"<button value='9'>【下一页】</button>"
ELSE
        HTML_STR += @"<nonbutton title='已是最后一页'>【下一页】</nonbutton>"
ENDIF
;居中
LOCAL:2 = MAX((CLIENTWIDTH() - HTML_STRINGLEN(HTML_STR, 1)) / 2, 0)
HTML_PRINT @"<shape type='space' param='{LOCAL:2}px'>" + HTML_STR + "<br>"
RETURN

;--------------------------------------------------------
; 战斗技能（弹幕特能）内联显示——原版彩色字体
;--------------------------------------------------------
@生活系统_武道大会_技能显示(OPPONENT)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM OPPONENT
;统计技能数
LOCAL:1 = 0
FOR LOCAL, 0, 10
        SIF GETBIT(CFLAG:(OPPONENT):弾幕特能, LOCAL)
                LOCAL:1 ++
NEXT
SIF LOCAL:1 == 0
        RETURN
;全部10个 → 百载无穷
IF LOCAL:1 == 10
        PRINTPLAINFORM 　
        SETCOLOR C_RED
        PRINTPLAINFORM 【百载无穷】
        RESETCOLOR
        RETURN
ENDIF
PRINTPLAINFORM 　
FOR LOCAL, 0, 10
        SIF !GETBIT(CFLAG:(OPPONENT):弾幕特能, LOCAL)
                CONTINUE
        SELECTCASE LOCAL
                CASE 0
                        SETCOLOR C_P_BLUE
                        PRINTPLAINFORM 【言笑自若】
                CASE 1
                        SETCOLOR C_P_BLUE
                        PRINTPLAINFORM 【温柔敦厚】
                CASE 2
                        SETCOLOR C_RED
                        PRINTPLAINFORM 【勇气凛然】
                CASE 3
                        SETCOLOR C_RED
                        PRINTPLAINFORM 【豪放磊落】
                CASE 4
                        SETCOLOR C_P_PURPLE
                        PRINTPLAINFORM 【怪力乱神】
                CASE 5
                        SETCOLOR C_P_PURPLE
                        PRINTPLAINFORM 【洽览深识】
                CASE 6
                        SETCOLOR C_P_PURPLE
                        PRINTPLAINFORM 【残忍酷薄】
                CASE 7
                        SETCOLOR C_P_PURPLE
                        PRINTPLAINFORM 【乾坤一掷】
                CASE 8
                        SETCOLOR C_RED
                        PRINTPLAINFORM 【狷介孤高】
                CASE 9
                        SETCOLOR C_P_BLUE
                        PRINTPLAINFORM 【幽愁暗恨】
        ENDSELECT
        RESETCOLOR
NEXT
RETURN
