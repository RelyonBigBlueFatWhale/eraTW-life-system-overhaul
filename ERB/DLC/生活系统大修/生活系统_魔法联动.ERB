;========================================================
; 生活系统大修 - 魔法版联动（天堂制造）
; 文件：ERB/DLC/生活系统大修/生活系统_魔法联动.ERB
;
; 联动对象：魔法补丁（MAGIC_DLC），写法对齐魔法补丁惯例
;   - 熟练度 = ITEM 计数（如 解酒957/清扫977/隙间982 模式）
;   - 魔法门控：MAGIC_RANK(TSlv) / MAGIC_MASTERONLY / MAGIC_GENERALCONDITION
; 开关：生活系统大修设置 → [9] 魔法版联动内容
;
; 功能：
;   1. 熟练度获取：使用绯红之王 酿酒/加速孵化/战斗 时 15% 获得 1 点
;   2. 天堂制造（TSlv5，熟练度3解锁，ITEM:984）：
;      - 对自己：时间压缩——所有非性爱系指令执行时间改为 1 分钟（就寝/次日清除）
;      - 家具屋老板（制作家具中可选）：立即完工（FLAG:家具作成残り = 0）
;========================================================

;--------------------------------------------------------
; 熟练度获取（15%）：酿酒/孵蛋/战斗 使用绯红之王时调用
;--------------------------------------------------------
@生活系统_魔法熟练度获取
#LOCALSIZE 1
#LOCALSSIZE 1
;需开启魔法版联动且魔法补丁存在；解锁后（ITEM:984>=3）不再增长
SIF !生活系统_魔法联动 || !MAGIC_DLC || ITEM:984 >= 3
        RETURN 0
IF RAND:100 < 15
        ITEM:984 ++
        PRINTFORML 获得了1点「天堂制造」熟练度！（{ITEM:984}/3）
ENDIF
RETURN 1

;--------------------------------------------------------
; 非性爱系指令判定
; 性爱系：0-199（基础性/SM/调教）、313-330（爱抚/掀裙）、
;         350-361（推倒/强迫）、700-799（自慰系）
;--------------------------------------------------------
@生活系统_非性爱系指令()
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
IF INRANGE(SELECTCOM, 0, 199) || INRANGE(SELECTCOM, 313, 330) || INRANGE(SELECTCOM, 350, 361) || INRANGE(SELECTCOM, 700, 799)
        RETURNF 0
ENDIF
RETURNF 1

;--------------------------------------------------------
; 天堂制造 发动（由 使用魔法.ERB CASE 984 调用）
; 返回：1=已发动（消耗一回合） 0=中止（不消耗）
;--------------------------------------------------------
@生活系统_天堂制造
#LOCALSIZE 2
#LOCALSSIZE 1
;发动条件防御：开关、魔法补丁、已解锁
SIF !生活系统_魔法联动 || !MAGIC_DLC || ITEM:984 < 3
        PRINTFORMW 现在还不能发动「天堂制造」……
        RETURN 0
PRINTFORML 发动「天堂制造」！要将目标设定为？
;正在制作家具时可选择家具屋老板
IF FLAG:作成中家具 && FLAG:家具作成残り > 0
        CALL ASK_M("对自己", 1, "家具屋老板", 1, "中止", 1)
        SELECTCASE RESULT
                CASE 0
                        CALL 生活系统_天堂制造_对自己
                        RETURN 1
                CASE 1
                        CALL 生活系统_天堂制造_完工家具
                        RETURN 1
                CASEELSE
                        RETURN 0
        ENDSELECT
ELSE
        CALL ASK_M("对自己", 1, "中止", 1)
        IF RESULT == 0
                CALL 生活系统_天堂制造_对自己
                RETURN 1
        ENDIF
ENDIF
RETURN 0

;--------------------------------------------------------
; 对自己：时间压缩（持续到就寝/次日，DLCEVENT 每日清除）
;--------------------------------------------------------
@生活系统_天堂制造_对自己
#LOCALSIZE 1
#LOCALSSIZE 1
生活系统_天堂制造加速 = 1
SETCOLOR C_AQUA
PRINTFORML 「天堂制造」！从现在起直到入睡，所有日常指令都将在转瞬之间完成！
RESETCOLOR
RETURN 1

;--------------------------------------------------------
; 家具屋老板：立即完工当前制作中的家具
;--------------------------------------------------------
@生活系统_天堂制造_完工家具
#LOCALSIZE 1
#LOCALSSIZE 1
FLAG:家具作成残り = 0
SETCOLOR C_AQUA
PRINTFORML 「天堂制造」！家具屋老板猛地回过神来——%ITEMNAME_TR(FLAG:作成中家具)%已经完工了！
RESETCOLOR
RETURN 1

;--------------------------------------------------------
; EVENTCOM：记录指令开始时刻（供时间压缩；多重定义事件，不干扰他人）
;--------------------------------------------------------
@EVENTCOM
SIF 生活系统_天堂制造加速
        生活系统_指令开始时刻 = TIME
RETURN 0

;--------------------------------------------------------
; EVENTCOMEND：时间压缩——非性爱系指令执行时间改为 1 分钟
;--------------------------------------------------------
@EVENTCOMEND
SIF !生活系统_天堂制造加速
        RETURN 0
;性爱系指令不压缩
SIF 生活系统_非性爱系指令() == 0
        RETURN 0
TIME = 生活系统_指令开始时刻 + 1
RETURN 0
