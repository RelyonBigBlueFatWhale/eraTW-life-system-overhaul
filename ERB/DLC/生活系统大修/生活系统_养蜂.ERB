;========================================================
; 生活系统大修 - 养蜂系统（蜂箱 / 授粉 / 熊与妖精）
;
; 流程：
;   1. 家具屋打造蜂箱（首个5天、之后3天；橡木制），上限8
;   2. 采集获得蜂蜜时30%概率发现【蜂王】，放入蜂箱后才开始工作
;   3. 每日按季节+天气增长采蜜进度（1~6），10进度=1蜜，每箱上限10蜜
;   4. 授粉：每箱每晚对每株「花阶段」且异花授粉作物独立判定，
;      触发后随机增产/缩短生长，同时该箱+1采蜜进度；同株只生效一次
;   5. 熊偷蜜/敲门讨蜜事件链（好感10=熊之友）；妖精偷蜜（好感10=花田妖精）
;========================================================

;--------------------------------------------------------
; 每日事件（DLCEVENT 钩子，开关开启时调用）
;--------------------------------------------------------
@生活系统_养蜂_每日事件
#LOCALSIZE 2
#LOCALSSIZE 1
SIF !生活系统_养蜂
        RETURN
FOR LOCAL, 0, ITEM:蜂箱
        SIF !生活系统_蜂箱有蜂:LOCAL
                CONTINUE
        ;季节基础值，冬蛰伏
        LOCAL:1 = 1
        SIF DAY:季節 != 4
                LOCAL:1 = 2 + DAY:季節
        ;天气修正
        IF GROUPMATCH(TIME:天气, 天气_晴, 天气_少云, 天气_多云)
                LOCAL:1 += 1
        ELSE
                LOCAL:1 -= 2
        ENDIF
        LOCAL:1 = LIMIT(LOCAL:1, 1, 6)
        生活系统_蜂箱进度:LOCAL += LOCAL:1
        WHILE 生活系统_蜂箱进度:LOCAL >= 10 && 生活系统_蜂箱蜜:LOCAL < 10
                生活系统_蜂箱进度:LOCAL -= 10
                生活系统_蜂箱蜜:LOCAL += 1
        WEND
NEXT
CALL 生活系统_养蜂_授粉结算
CALL 生活系统_熊事件
CALL 生活系统_妖精事件
RETURN

;--------------------------------------------------------
; 授粉结算
;--------------------------------------------------------
@生活系统_养蜂_授粉结算
#LOCALSIZE 3
#LOCALSSIZE 1
FOR LOCAL, 1, 生活系统_畝数() + 1
        SIF 生活系统_授粉标记:LOCAL
                CONTINUE
        SIF !生活系统_异花授粉作物(PLANT_TYPE:LOCAL)
                CONTINUE
        SIF !INRANGE(PLANT_GROW:LOCAL, 6, 7)
                CONTINUE
        LOCAL:1 = 0
        FOR LOCAL:2, 0, ITEM:蜂箱
                SIF !生活系统_蜂箱有蜂:(LOCAL:2)
                        CONTINUE
                IF RAND:100 < 15
                        LOCAL:1 = 1
                        生活系统_蜂箱进度:(LOCAL:2) += 1
                ENDIF
        NEXT
        IF LOCAL:1
                生活系统_授粉标记:LOCAL = 1 + RAND:2
                PRINTFORML 蜂群嗡嗡地穿梭在花田间，%HATAKE_NAME:LOCAL%似乎受到了授粉的恩惠
        ENDIF
NEXT
RETURN

;--------------------------------------------------------
; 异花授粉（虫媒）作物判定
;--------------------------------------------------------
@生活系统_异花授粉作物(种子ID)
#FUNCTION
#DIM 种子ID
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE 种子ID
        CASE [[树莓种子]], [[山葡萄插条]], [[木通果种子]], [[彼岸花球根]], [[高丽人参根苗]], [[曼陀罗草根]]
                RETURNF 1
ENDSELECT
RETURNF 0

;--------------------------------------------------------
; 熊事件
;--------------------------------------------------------
@生活系统_熊事件
#LOCALSIZE 3
#LOCALSSIZE 1
IF TALENT:MASTER:熊之友
        IF !RAND:30
                CALL GET_ITEM("树莓", 1 + RAND:3, 2)
                PRINTFORML 一早起来，门口放着熊叼来的野果熊之友的谢礼！
        ENDIF
        RETURN
ENDIF
IF 生活系统_熊好感 >= 3
        IF 生活系统_熊敲门剩 > 0
                生活系统_熊敲门剩 -= 1
                RETURN
        ENDIF
        生活系统_熊敲门剩 = 3 + RAND:3
        CALL 生活系统_熊讨蜜
        RETURN
ENDIF
IF 生活系统_熊赶跑剩 > 0
        生活系统_熊赶跑剩 -= 1
        RETURN
ENDIF
SIF !生活系统_蜂箱有蜜()
        RETURN
IF RAND:100 < 20
        CALL 生活系统_熊偷蜜
ENDIF
RETURN

;--------------------------------------------------------
; 熊偷蜜
;--------------------------------------------------------
@生活系统_熊偷蜜
#LOCALSIZE 2
#LOCALSSIZE 1
PRINTFORML 半夜里你忽然醒来，听见蜂箱方向传来窸窸窣窣的动静是熊在偷蜜！
IF ABL:MASTER:戦闘能力 < 4
        PRINTFORML 凭你现在的战斗力，也只能躲在屋里眼睁睁看着熊舔着爪子满意地离开了。
        生活系统_蜂箱蜜:0 = MAX(生活系统_蜂箱蜜:0 - 3, 0)
        RETURN
ENDIF
IF 生活系统_熊好感 > 0
        CALL ASK_M("冲出去揍它", 0, "取出蜂蜜招待它", 1, "装睡", 1)
ELSE
        CALL ASK_M("冲出去揍它", 0, "装睡", 1)
ENDIF
SELECTCASE RESULT
        CASE 0
                PRINTFORML 你冲上去对着熊一顿拳打脚踢！熊「嗷呜」一声，夹着尾巴逃跑了！
                生活系统_蜂箱蜜:0 = MAX(生活系统_蜂箱蜜:0 - 1, 0)
                生活系统_熊赶跑剩 = 10
        CASE 1
                IF 生活系统_熊好感 > 0
                        PRINTFORML 你取出蜂箱里的全部蜂蜜放在地上。熊凑上来舔了个精光，蹭了蹭你的腿才离开。
                        生活系统_熊好感 += 1
                        生活系统_蜂箱蜜:0 = 0
                ELSE
                        PRINTFORML 你决定装睡熊把蜜舔了个干净，心满意足地离开了。
                        生活系统_蜂箱蜜:0 = MAX(生活系统_蜂箱蜜:0 - 3, 0)
                ENDIF
        CASEELSE
                PRINTFORML 你决定装睡熊把蜜舔了个干净，心满意足地离开了。
                生活系统_蜂箱蜜:0 = MAX(生活系统_蜂箱蜜:0 - 3, 0)
ENDSELECT
RETURN

;--------------------------------------------------------
; 熊敲门讨蜜
;--------------------------------------------------------
@生活系统_熊讨蜜
#LOCALSIZE 1
#LOCALSSIZE 1
PRINTFORML 半夜睡不着，你听见门口传来「咚咚」的敲门声熊又来了，眼巴巴地看着你。
LOCAL = (生活系统_蜂箱蜜:0 >= 3) + (ITEM:好吃的魚 > 0 || ITEM:魚 > 0)
CALL ASK_M("取出3份蜂蜜", LIMIT(LOCAL, 0, 1), "拿鱼给它", LIMIT(LOCAL, 0, 1) && (ITEM:好吃的魚 > 0 || ITEM:魚 > 0), "什么也不给", 1)
SELECTCASE RESULT
        CASE 0
                IF 生活系统_蜂箱蜜:0 >= 3
                        生活系统_蜂箱蜜:0 -= 3
                        生活系统_熊好感 += 1
                        PRINTFORML 熊心满意足地吃掉了蜂蜜，蹭了蹭你才离开。
                ELSE
                        生活系统_熊好感 -= 1
                        PRINTFORML 你翻遍了蜂箱也没凑够3份蜂蜜，熊失望地离开了
                ENDIF
        CASE 1
                IF ITEM:好吃的魚 > 0
                        ITEM:好吃的魚 -= 1
                        生活系统_熊好感 += 2
                        PRINTFORML 你拿出好吃的鱼，熊吃得津津有味，好感明显上涨了！
                ELSEIF ITEM:魚 > 0
                        ITEM:魚 -= 1
                        生活系统_熊好感 += 1
                        PRINTFORML 你拿出一条鱼，熊满意地叼走了。
                ELSE
                        生活系统_熊好感 -= 1
                        PRINTFORML 你翻遍了身上也没有鱼，熊失望地离开了
                ENDIF
        CASEELSE
                生活系统_熊好感 -= 1
                PRINTFORML 熊在你门口坐了一夜，最终失望地离开了（好感下降）
ENDSELECT
IF 生活系统_熊好感 >= 10 && !TALENT:MASTER:熊之友
        生活系统_熊好感 = 10
        TALENT:MASTER:熊之友 = 1
        PRINTFORML 熊正式成为了你的朋友你获得了素质【熊之友】！
ENDIF
RETURN

;--------------------------------------------------------
; 妖精事件
;--------------------------------------------------------
@生活系统_妖精事件
#LOCALSIZE 1
#LOCALSSIZE 1
SIF 生活系统_花田妖精
        RETURN
SIF RAND:100 >= 10
        RETURN
PRINTFORML 半夜里，一群捣乱的妖精正围着蜂箱打转，偷偷往嘴里塞蜂蜜！
CALL ASK_M("用肉棒教训它们", 0, "用蜂蜜招待", 1, "喂黑雷神巧克力", 1, "赶走它们", 1)
SELECTCASE RESULT
        CASE 0
                PRINTFORML 你掏出肉棒在妖精们面前晃了晃，妖精们尖叫着一哄而散！
                生活系统_蜂箱蜜:0 = MAX(生活系统_蜂箱蜜:0 - 1, 0)
        CASE 1
                IF 生活系统_蜂箱蜜:0 >= 1
                        生活系统_蜂箱蜜:0 -= 1
                        生活系统_妖精好感 += 1
                        PRINTFORML 你请妖精们喝了点蜂蜜，妖精们心满意足地飞走了。
                ELSE
                        PRINTFORML 蜂箱里没有蜜可招待妖精们扫兴地飞走了。
                ENDIF
        CASE 2
                IF ITEM:黑雷神巧克力 > 0
                        ITEM:黑雷神巧克力 -= 1
                        生活系统_妖精好感 += 1
                        PRINTFORML 你丢出一块黑雷神巧克力，妖精们抢作一团，欢天喜地地飞走了。
                ELSE
                        PRINTFORML 你身上没有黑雷神巧克力妖精们扫兴地飞走了。
                ENDIF
        CASEELSE
                PRINTFORML 你挥手赶走了妖精们。
                生活系统_蜂箱蜜:0 = MAX(生活系统_蜂箱蜜:0 - 1, 0)
ENDSELECT
IF 生活系统_妖精好感 >= 10 && !生活系统_花田妖精
        生活系统_妖精好感 = 10
        生活系统_花田妖精 = 1
        PRINTFORML 妖精们欢呼着围住你【花田妖精】事件！所有正在开花的作物都得到了妖精的祝福！
        CALL 生活系统_花田妖精授粉
ENDIF
RETURN

;--------------------------------------------------------
; 花田妖精：一次性授粉
;--------------------------------------------------------
@生活系统_花田妖精授粉
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 1, 生活系统_畝数() + 1
        SIF !生活系统_异花授粉作物(PLANT_TYPE:LOCAL)
                CONTINUE
        SIF !INRANGE(PLANT_GROW:LOCAL, 6, 7)
                CONTINUE
        IF !生活系统_授粉标记:LOCAL
                生活系统_授粉标记:LOCAL = 1 + RAND:2
        ENDIF
NEXT
RETURN

;--------------------------------------------------------
; 是否有蜂箱存蜜（偷蜜判定）
;--------------------------------------------------------
@生活系统_蜂箱有蜜()
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 0, ITEM:蜂箱
        SIF 生活系统_蜂箱蜜:LOCAL >= 8
                RETURNF 1
NEXT
RETURNF 0

;--------------------------------------------------------
; 收蜜（普通函数，调用方 CALL + RESULT 读取）
;--------------------------------------------------------
@生活系统_蜂箱收蜜(箱号)
#DIM 箱号
#LOCALSIZE 3
#LOCALSSIZE 1
LOCAL = 0
IF 生活系统_彼岸花开()
        LOCAL:1 = 1
ENDIF
FOR LOCAL:2, 0, 生活系统_蜂箱蜜:箱号
        IF LOCAL:1 && LOCAL:2 == 0
                CALL GET_ITEM("彼岸花蜜", 1, 1)
        ELSE
                CALL GET_ITEM("蜂蜜", 1, 1)
        ENDIF
        LOCAL += 1
NEXT
生活系统_蜂箱蜜:箱号 = 0
RETURN LOCAL

;--------------------------------------------------------
; 菜园是否有彼岸花处于花阶段
;--------------------------------------------------------
@生活系统_彼岸花开()
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 1, 生活系统_畝数() + 1
        SIF PLANT_TYPE:LOCAL != [[彼岸花球根]]
                CONTINUE
        SIF INRANGE(PLANT_GROW:LOCAL, 6, 7)
                RETURNF 1
NEXT
RETURNF 0