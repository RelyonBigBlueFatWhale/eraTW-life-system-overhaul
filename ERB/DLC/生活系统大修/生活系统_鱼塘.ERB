;========================================================
; 生活系统大修 - 鱼塘系统（养鱼繁殖 / 鲟鱼卵鱼子酱）
;
; 流程：
;   1. 默认1口鱼塘，界面内建造新鱼塘（15天，同时1口，上限5）
;   2. 每口10槽，同种鱼；多条产卵期孵化期鱼苗
;   3. 鱼可收回隙间渔获/取肉/卖鱼（稀有度长度话术技能定价）
;   4. 鱼达性成熟长度才繁殖；有受精卵时卖光鱼也会孵出鱼苗
;   5. 鲟鱼产卵期可用打捞具取鲟鱼卵（打断本次繁殖），入酒桶腌14天鱼子酱
;   6. 星露谷式请求：满足后鱼苗+、冷却-、成长加速
;========================================================

;--------------------------------------------------------
; 每日事件
;--------------------------------------------------------
@生活系统_鱼塘_每日事件
#LOCALSIZE 2
#LOCALSSIZE 1
SIF !生活系统_鱼塘
        RETURN
IF 生活系统_鱼塘建造中
        生活系统_鱼塘建造剩余 -= 1
        IF 生活系统_鱼塘建造剩余 <= 0
                生活系统_鱼塘建造中 = 0
                生活系统_鱼塘数量 = LIMIT(生活系统_鱼塘数量 + 1, 0, 5)
                PRINTFORML 新鱼塘建成了！现在共有{生活系统_鱼塘数量}口鱼塘。
        ENDIF
ENDIF
FOR LOCAL, 1, 生活系统_鱼塘数量 + 1
        CALL 生活系统_鱼塘_每日结算(LOCAL)
NEXT
RETURN

;--------------------------------------------------------
; 单塘每日结算
;--------------------------------------------------------
@生活系统_鱼塘_每日结算(塘号)
#DIM 塘号
#LOCALSIZE 4
#LOCALSSIZE 1
SIF 生活系统_鱼塘鱼种:塘号 == ""
        RETURN
IF 生活系统_鱼塘请求:塘号 == 1
        生活系统_鱼塘请求剩:塘号 -= 1
        IF 生活系统_鱼塘请求剩:塘号 <= 0
                生活系统_鱼塘请求:塘号 = 0
        ENDIF
ENDIF
SIF 生活系统_鱼塘成长剩:塘号 > 0
        生活系统_鱼塘成长剩:塘号 -= 1
LOCAL:1 = 1
SIF 生活系统_鱼塘成长剩:塘号 > 0
        LOCAL:1 = 2
FOR LOCAL:2, 0, 生活系统_鱼塘鱼数:塘号
        生活系统_鱼塘长度:塘号:(LOCAL:2) += LOCAL:1
NEXT
IF 生活系统_鱼塘孵化剩:塘号 > 0
        生活系统_鱼塘孵化剩:塘号 -= 1
        IF 生活系统_鱼塘孵化剩:塘号 <= 0
                LOCAL:2 = MAX(1, 生活系统_鱼塘鱼数:塘号 / 2)
                生活系统_鱼塘鱼数:塘号 = MIN(生活系统_鱼塘鱼数:塘号 + LOCAL:2, 10)
                PRINTFORML 鱼塘{塘号}的鱼苗孵化了！鱼群壮大到{生活系统_鱼塘鱼数:塘号}条。
        ENDIF
        RETURN
ENDIF
IF 生活系统_鱼塘产卵剩:塘号 > 0
        生活系统_鱼塘产卵剩:塘号 -= 1
        IF 生活系统_鱼塘产卵剩:塘号 <= 0
                生活系统_鱼塘孵化剩:塘号 = 生活系统_鱼塘孵化日数(生活系统_鱼塘鱼种:塘号)
                PRINTFORML 鱼塘{塘号}的%生活系统_鱼塘鱼种:塘号%产下了一片鱼卵，开始孵化
        ENDIF
        RETURN
ENDIF
IF 生活系统_鱼塘繁殖剩:塘号 > 0
        生活系统_鱼塘繁殖剩:塘号 -= 1
        RETURN
ENDIF
IF 生活系统_鱼塘鱼数:塘号 >= 2 && 生活系统_鱼塘已性成熟(塘号)
        LOCAL:3 = 生活系统_鱼塘产卵日数(生活系统_鱼塘鱼种:塘号)
        IF 生活系统_鱼塘请求:塘号 == 2
                LOCAL:3 = MAX(1, LOCAL:3 - 1)
                生活系统_鱼塘请求:塘号 = 0
        ENDIF
        生活系统_鱼塘产卵剩:塘号 = LOCAL:3
        PRINTFORML 鱼塘{塘号}的%生活系统_鱼塘鱼种:塘号%进入了产卵期
ENDIF
IF 生活系统_鱼塘请求:塘号 == 0 && 生活系统_鱼塘鱼数:塘号 >= 3 && !RAND:5
        生活系统_鱼塘请求:塘号 = 1
        生活系统_鱼塘请求剩:塘号 = 5
        生活系统_鱼塘请求物:塘号 = 生活系统_鱼塘随机请求物()
        生活系统_鱼塘请求量:塘号 = 1 + RAND:2
        PRINTFORML 鱼塘{塘号}的%生活系统_鱼塘鱼种:塘号%似乎在向你讨要什么
ENDIF
RETURN

;--------------------------------------------------------
; 辅助函数（纯计算）
;--------------------------------------------------------
@生活系统_鱼塘平均长度(塘号)
#FUNCTION
#DIM 塘号
#LOCALSIZE 2
#LOCALSSIZE 1
LOCAL = 0
SIF 生活系统_鱼塘鱼数:塘号 == 0
        RETURNF 0
FOR LOCAL:1, 0, 生活系统_鱼塘鱼数:塘号
        LOCAL += 生活系统_鱼塘长度:塘号:(LOCAL:1)
NEXT
RETURNF LOCAL / 生活系统_鱼塘鱼数:塘号

@生活系统_鱼塘已性成熟(塘号)
#FUNCTION
#DIM 塘号
#LOCALSIZE 1
#LOCALSSIZE 1
RETURNF 生活系统_鱼塘平均长度(塘号) >= 生活系统_鱼种最大长度(生活系统_鱼塘鱼种:塘号) * 6 / 10

@生活系统_鱼种最大长度(鱼种名)
#FUNCTION
#DIMS 鱼种名
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE 鱼种名
        CASE "石斑鱼", "巨骨舌鱼", "鲟", "鳗鱼", "雷鱼"
                RETURNF 150
        CASE "鲑鱼", "虹鳟"
                RETURNF 100
        CASE "腔棘鱼", "铁甲鱼", "青鱼", "草鱼", "大口黑鲈"
                RETURNF 120
        CASE "皋月鳟", "山女鱼", "岩鱼", "姬鳟", "国鳟", "香鱼", "西太公鱼"
                RETURNF 60
        CASE "鲫鱼", "拉氏鱥", "溪哥", "蓝鳃太阳鱼", "杜父鱼", "斗鲈", "八目鳗"
                RETURNF 40
ENDSELECT
RETURNF 60

@生活系统_鱼塘产卵日数(鱼种名)
#FUNCTION
#DIMS 鱼种名
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE 鱼种名
        CASE "鲫鱼", "鲤鱼", "草鱼", "高身鲫", "青鱼", "拉氏鱥", "溪哥"
                RETURNF 2
        CASE "蓝鳃太阳鱼", "鲶鱼", "杜父鱼", "香鱼", "石斑鱼"
                RETURNF 3
        CASE "皋月鳟", "山女鱼", "岩鱼", "虹鳟", "姬鳟", "国鳟"
                RETURNF 5
        CASE "鲑鱼"
                RETURNF 6
        CASE "鲟"
                RETURNF 8
        CASE "腔棘鱼", "雷鱼", "幽影鳞鱼", "火舌鲤", "影毒鳐", "星光鲦", "铁甲鱼", "泷太郎"
                RETURNF 5
ENDSELECT
RETURNF 4

@生活系统_鱼塘孵化日数(鱼种名)
#FUNCTION
#DIMS 鱼种名
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE 鱼种名
        CASE "鲫鱼", "鲤鱼", "草鱼", "高身鲫", "青鱼", "拉氏鱥", "溪哥", "蓝鳃太阳鱼"
                RETURNF 2
        CASE "鲶鱼", "杜父鱼", "石斑鱼"
                RETURNF 3
        CASE "皋月鳟", "山女鱼", "岩鱼", "虹鳟", "姬鳟", "国鳟", "香鱼"
                RETURNF 4
        CASE "鲑鱼", "鲟", "腔棘鱼", "雷鱼", "幽影鳞鱼", "火舌鲤", "影毒鳐", "星光鲦", "铁甲鱼", "泷太郎"
                RETURNF 5
ENDSELECT
RETURNF 3

@生活系统_鱼塘随机请求物()
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE RAND:6
        CASE 0
                RETURNF [[虫]]
        CASE 1
                RETURNF [[稀有昆虫]]
        CASE 2
                RETURNF [[鱼粕]]
        CASE 3
                RETURNF [[平价食材]]
        CASE 4
                RETURNF [[木材]]
        CASEELSE
                RETURNF [[蜂蜜]]
ENDSELECT

@生活系统_鱼种基础价(鱼种名)
#FUNCTION
#DIMS 鱼种名
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE 鱼种名
        CASE "鲟", "腔棘鱼"
                RETURNF 5000
        CASE "鲑鱼", "鳗鱼", "雷鱼", "泷太郎"
                RETURNF 3000
        CASE "巨骨舌鱼", "铁甲鱼", "幽影鳞鱼", "火舌鲤", "影毒鳐", "星光鲦"
                RETURNF 2000
        CASE "石斑鱼", "青鱼", "草鱼", "大口黑鲈", "国鳟"
                RETURNF 1500
        CASE "虹鳟", "皋月鳟", "山女鱼", "岩鱼", "姬鳟", "香鱼", "西太公鱼"
                RETURNF 1000
        CASE "鲫鱼", "鲤鱼", "高身鲫", "鲶鱼", "杜父鱼", "斗鲈", "蓝鳃太阳鱼", "拉氏鱥", "溪哥", "八目鳗"
                RETURNF 500
ENDSELECT
RETURNF 800

;--------------------------------------------------------
; 完成请求（普通函数，调用方 CALL + RESULT 读取）
;--------------------------------------------------------
@生活系统_鱼塘完成请求(塘号)
#DIM 塘号
#LOCALSIZE 1
#LOCALSSIZE 1
IF 生活系统_鱼塘请求:塘号 != 1
        RETURN 0
ENDIF
IF ITEM:(生活系统_鱼塘请求物:塘号) < 生活系统_鱼塘请求量:塘号
        PRINTFORML 材料不够
        RETURN 0
ENDIF
ITEM:(生活系统_鱼塘请求物:塘号) -= 生活系统_鱼塘请求量:塘号
生活系统_鱼塘请求:塘号 = 2
生活系统_鱼塘成长剩:塘号 = 3
生活系统_鱼塘繁殖剩:塘号 = MAX(生活系统_鱼塘繁殖剩:塘号 - 2, 0)
PRINTFORML 塘里的%生活系统_鱼塘鱼种:塘号%欢快地游动起来，似乎在感谢你！
RETURN 1

;--------------------------------------------------------
; 卖鱼（普通函数，调用方 CALL + RESULT 读取）
;--------------------------------------------------------
@生活系统_鱼塘卖鱼(塘号, 条数)
#DIM 塘号
#DIM 条数
#LOCALSIZE 3
#LOCALSSIZE 1
LOCAL = 生活系统_鱼种基础价(生活系统_鱼塘鱼种:塘号)
LOCAL:1 = 0
FOR LOCAL:2, 0, 条数
        LOCAL:1 += 生活系统_鱼塘长度:塘号:(LOCAL:2)
NEXT
LOCAL:2 = LOCAL:1 / MAX(条数, 1)
;长度系数 0.8~1.5，话术加成 0.9~1.3
LOCAL:1 = LIMIT(LOCAL:2 / 60 * 10 + 8, 8, 15)
LOCAL:2 = LIMIT(90 + ABL:MASTER:話術技能 * 2, 90, 130)
LOCAL = LOCAL * 条数 * LOCAL:1 * LOCAL:2 / 100 / 10
MONEY += LOCAL
PRINTFORML 卖掉了{条数}条%生活系统_鱼塘鱼种:塘号%，获得%金額表示(LOCAL)%元！
生活系统_鱼塘鱼数:塘号 = 0
生活系统_鱼塘鱼种:塘号 =
生活系统_鱼塘鱼种ID:塘号 = 0
生活系统_鱼塘产卵剩:塘号 = 0
生活系统_鱼塘孵化剩:塘号 = 0
生活系统_鱼塘繁殖剩:塘号 = 0
RETURN LOCAL