;========================================================
; 生活系统大修 - 鱼塘系统（按个体储存 / 拟真繁殖）
; 1. 每口塘单一鱼种；每条鱼独立记录：鱼种ID / 长度 / 性别
; 2. 性别：1=雌 2=雄（未成熟时隐藏）；放入时随机
; 3. 集中产卵：同种鱼按现实产卵季节，同一天（跨塘同步）进入产卵期
; 4. 受精：产卵期结束时，池内有雄鱼才受精并进入孵化期；否则卵直接消失
; 5. 变性：现实具变性能力的鱼（缺资料者默认有）可在性别失衡时转换，
;    但不能自我授精至少需 2 条
; 6. 孵化结束：鱼苗直接填满鱼塘剩余槽位（性别随机、幼体长度）
;========================================================

;--------------------------------------------------------
; 每日事件
;--------------------------------------------------------
@生活系统_鱼塘_每日事件
#LOCALSIZE 2
#LOCALSSIZE 1
SIF !生活系统_鱼塘
        RETURN
IF 生活系统_鱼塘建造中
        生活系统_鱼塘建造剩余 -= 1
        IF 生活系统_鱼塘建造剩余 <= 0
                生活系统_鱼塘建造中 = 0
                生活系统_鱼塘数量 = LIMIT(生活系统_鱼塘数量 + 1, 0, 5)
                PRINTFORML 新鱼塘建成了！现在共有{生活系统_鱼塘数量}口鱼塘。
        ENDIF
ENDIF
FOR LOCAL, 1, 生活系统_鱼塘数量 + 1
        CALL 生活系统_鱼塘_每日结算(LOCAL)
NEXT
RETURN

;--------------------------------------------------------
; 单塘每日结算
;--------------------------------------------------------
@生活系统_鱼塘_每日结算(塘号)
#DIM 塘号
#LOCALSIZE 5
#LOCALSSIZE 1
SIF 生活系统_鱼塘鱼种:塘号 == ""
        RETURN
;请求等待
IF 生活系统_鱼塘请求:塘号 == 1
        生活系统_鱼塘请求剩:塘号 -= 1
        SIF 生活系统_鱼塘请求剩:塘号 <= 0
                生活系统_鱼塘请求:塘号 = 0
ENDIF
;成长（每条鱼）
SIF 生活系统_鱼塘成长剩:塘号 > 0
        生活系统_鱼塘成长剩:塘号 -= 1
LOCAL:1 = 1
SIF 生活系统_鱼塘成长剩:塘号 > 0
        LOCAL:1 = 2
FOR LOCAL:2, 0, 生活系统_鱼塘鱼数:塘号
        生活系统_鱼塘长度:塘号:(LOCAL:2) += LOCAL:1
NEXT
;成熟后补齐性别
FOR LOCAL:2, 0, 生活系统_鱼塘鱼数:塘号
        SIF 生活系统_鱼塘性别:塘号:(LOCAL:2)
                CONTINUE
        SIF 生活系统_鱼塘已成熟(塘号, LOCAL:2)
                生活系统_鱼塘性别:塘号:(LOCAL:2) = 1 + RAND:2
NEXT
;孵化期
IF 生活系统_鱼塘孵化剩:塘号 > 0
        生活系统_鱼塘孵化剩:塘号 -= 1
        IF 生活系统_鱼塘孵化剩:塘号 <= 0
                CALL 生活系统_鱼塘_孵化出苗(塘号)
        ENDIF
        RETURN
ENDIF
;产卵期：结束时判定受精
IF 生活系统_鱼塘产卵剩:塘号 > 0
        生活系统_鱼塘产卵剩:塘号 -= 1
        IF 生活系统_鱼塘产卵剩:塘号 <= 0
                IF 生活系统_鱼塘雄数(塘号) > 0
                        生活系统_鱼塘孵化剩:塘号 = 生活系统_鱼塘孵化日数(生活系统_鱼塘鱼种:塘号)
                        PRINTFORML 鱼塘{塘号}的%生活系统_鱼塘鱼种:塘号%产下的卵受精了，开始孵化
                ELSE
                        PRINTFORML 鱼塘{塘号}的%生活系统_鱼塘鱼种:塘号%产下了卵，却没有雄鱼为它授精
                ENDIF
        ENDIF
        RETURN
ENDIF
;繁殖冷却（仅递减，不阻断季节产卵判定）
SIF 生活系统_鱼塘繁殖剩:塘号 > 0
        生活系统_鱼塘繁殖剩:塘号 -= 1
;变性检查（性别失衡时）
CALL 生活系统_鱼塘_变性检查(塘号)
;集中产卵：本鱼种的产卵季节 + 本季尚未产卵 + 池中有成熟雌鱼
;（季节首日触发，同种鱼跨塘同日产卵；每季仅一次）
IF 生活系统_鱼种产卵季(生活系统_鱼塘鱼种:塘号) == DAY:季節 && DAY:日期 == 15 && 生活系统_鱼塘产卵季:塘号 != DAY:季節 && 生活系统_鱼塘雌成熟数(塘号) > 0
        生活系统_鱼塘产卵季:塘号 = DAY:季節
        生活系统_鱼塘产卵剩:塘号 = 生活系统_鱼塘产卵日数(生活系统_鱼塘鱼种:塘号)
        PRINTFORML 鱼塘{塘号}的%生活系统_鱼塘鱼种:塘号%进入了产卵期
ENDIF
;请求生成
IF !生活系统_鱼塘请求:塘号 && 生活系统_鱼塘鱼数:塘号 >= 3 && !RAND:5
        生活系统_鱼塘请求:塘号 = 1
        生活系统_鱼塘请求剩:塘号 = 5
        生活系统_鱼塘请求物:塘号 = 生活系统_鱼塘随机请求物()
        生活系统_鱼塘请求量:塘号 = 1 + RAND:2
        PRINTFORML 鱼塘{塘号}的%生活系统_鱼塘鱼种:塘号%似乎在向你讨要什么
ENDIF
RETURN

;--------------------------------------------------------
; 个体是否性成熟（长度该鱼种最大长度的60%）
;--------------------------------------------------------
@生活系统_鱼塘已成熟(塘号, 槽)
#FUNCTION
#DIM 塘号
#DIM 槽
RETURNF 生活系统_鱼塘长度:塘号:槽 >= 生活系统_鱼种最大长度(生活系统_鱼塘鱼种:塘号) * 6 / 10

;--------------------------------------------------------
; 池内成熟雌鱼数
;--------------------------------------------------------
@生活系统_鱼塘雌成熟数(塘号)
#FUNCTION
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM 塘号
LOCAL = 0
FOR LOCAL:1, 0, 生活系统_鱼塘鱼数:塘号
        SIF 生活系统_鱼塘性别:塘号:(LOCAL:1) != 1
                CONTINUE
        SIF 生活系统_鱼塘已成熟(塘号, LOCAL:1)
                LOCAL ++
NEXT
RETURNF LOCAL

;--------------------------------------------------------
; 池内雄鱼数
;--------------------------------------------------------
@生活系统_鱼塘雄数(塘号)
#FUNCTION
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM 塘号
LOCAL = 0
FOR LOCAL:1, 0, 生活系统_鱼塘鱼数:塘号
        SIF 生活系统_鱼塘性别:塘号:(LOCAL:1) == 2
                LOCAL ++
NEXT
RETURNF LOCAL

;--------------------------------------------------------
; 变性检查：具变性能力的鱼种、池内2条、性别失衡时，
; 由体型最大者转为缺失性别（无文本提示）
;--------------------------------------------------------
@生活系统_鱼塘_变性检查(塘号)
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM 塘号
SIF 生活系统_鱼塘鱼数:塘号 < 2
        RETURN
SIF !生活系统_鱼种可变性(生活系统_鱼塘鱼种:塘号)
        RETURN
LOCAL = 0   ;雌数
LOCAL:1 = 0 ;雄数
FOR LOCAL:2, 0, 生活系统_鱼塘鱼数:塘号
        SIF !生活系统_鱼塘性别:塘号:(LOCAL:2)
                CONTINUE
        IF 生活系统_鱼塘性别:塘号:(LOCAL:2) == 1
                LOCAL ++
        ELSE
                LOCAL:1 ++
        ENDIF
NEXT
;性别齐全  无需变性
SIF LOCAL > 0 && LOCAL:1 > 0
        RETURN
;找体型最大的个体，转为缺失性别
LOCAL = -1
LOCAL:1 = -1
FOR LOCAL:2, 0, 生活系统_鱼塘鱼数:塘号
        SIF 生活系统_鱼塘长度:塘号:(LOCAL:2) <= LOCAL:1
                CONTINUE
        LOCAL:1 = 生活系统_鱼塘长度:塘号:(LOCAL:2)
        LOCAL = LOCAL:2
NEXT
SIF LOCAL < 0
        RETURN
IF 生活系统_鱼塘性别:塘号:LOCAL == 1
        生活系统_鱼塘性别:塘号:LOCAL = 2
ELSE
        生活系统_鱼塘性别:塘号:LOCAL = 1
ENDIF
RETURN

;--------------------------------------------------------
; 孵化结束：鱼苗直接填满剩余槽位（性别随机、幼体长度）
;--------------------------------------------------------
@生活系统_鱼塘_孵化出苗(塘号)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM 塘号
LOCAL = 生活系统_鱼种最大长度(生活系统_鱼塘鱼种:塘号) / 5
SIF LOCAL < 3
        LOCAL = 3
FOR LOCAL:1, 生活系统_鱼塘鱼数:塘号, 10
        生活系统_鱼塘长度:塘号:(LOCAL:1) = LOCAL + RAND:(LOCAL + 1)
        生活系统_鱼塘性别:塘号:(LOCAL:1) = 0
NEXT
LOCAL = 10 - 生活系统_鱼塘鱼数:塘号
生活系统_鱼塘鱼数:塘号 = 10
PRINTFORML 鱼塘{塘号}的鱼苗孵化了！新添{LOCAL}条幼鱼，鱼塘已经满员。
RETURN

;--------------------------------------------------------
; 鱼种产卵季节（1=春 2=夏 3=秋 4=冬）
;--------------------------------------------------------
@生活系统_鱼种产卵季(鱼种名)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS 鱼种名
SELECTCASE 鱼种名
        CASE "鲤鱼", "鲫鱼", "高身鲫", "鲶鱼", "草鱼", "青鱼", "拉氏鱥", "溪哥", "鲤科鱼", "八目鳗", "巨骨舌鱼"
                RETURNF 1
        CASE "香鱼", "大口黑鲈", "蓝鳃太阳鱼", "杜父鱼", "斗鲈", "山女鱼", "岩鱼", "石斑鱼"
                RETURNF 2
        CASE "鲑鱼", "虹鳟", "皋月鳟", "姬鳟", "国鳟", "鲟", "腔棘鱼", "鳗鱼"
                RETURNF 3
        CASE "西太公鱼", "雷鱼", "幽影鳞鱼", "火舌鲤", "影毒鳐", "星光鲦", "铁甲鱼", "泷太郎"
                RETURNF 4
ENDSELECT
RETURNF 1

;--------------------------------------------------------
; 鱼种是否具性别转换能力（现实物种按生态；虚构鱼默认具备）
;--------------------------------------------------------
@生活系统_鱼种可变性(鱼种名)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS 鱼种名
SELECTCASE 鱼种名
        ;现实具变性能力：石斑鱼（先雌后雄）、鲫鱼（雌核发育/金鱼可变性）、鳗鱼（环境性别）
        CASE "石斑鱼", "鲫鱼", "鳗鱼"
                RETURNF 1
        ;虚构鱼类：默认具备
        CASE "幽影鳞鱼", "火舌鲤", "影毒鳐", "星光鲦", "铁甲鱼", "泷太郎", "雷鱼"
                RETURNF 1
ENDSELECT
RETURNF 0

;--------------------------------------------------------
; 单条鱼估值（基础价长度系数话术加成）
;--------------------------------------------------------
@生活系统_鱼塘单价(塘号, 槽)
#FUNCTION
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM 塘号
#DIM 槽
LOCAL = 生活系统_鱼种基础价(生活系统_鱼塘鱼种:塘号)
LOCAL:1 = LIMIT(生活系统_鱼塘长度:塘号:槽 / 60 * 10 + 8, 8, 15)
LOCAL:2 = LIMIT(90 + ABL:MASTER:話術技能 * 2, 90, 130)
RETURNF LOCAL * LOCAL:1 * LOCAL:2 / 100 / 10

;--------------------------------------------------------
; 移除指定槽位的鱼（后续前移）
;--------------------------------------------------------
@生活系统_鱼塘_移除(塘号, 槽)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM 塘号
#DIM 槽
生活系统_鱼塘鱼数:塘号 -= 1
FOR LOCAL, 槽, 生活系统_鱼塘鱼数:塘号
        生活系统_鱼塘长度:塘号:(LOCAL) = 生活系统_鱼塘长度:塘号:(LOCAL + 1)
        生活系统_鱼塘性别:塘号:(LOCAL) = 生活系统_鱼塘性别:塘号:(LOCAL + 1)
        生活系统_鱼塘鱼种ID:塘号:(LOCAL) = 生活系统_鱼塘鱼种ID:塘号:(LOCAL + 1)
NEXT
生活系统_鱼塘长度:塘号:(生活系统_鱼塘鱼数:塘号) = 0
生活系统_鱼塘性别:塘号:(生活系统_鱼塘鱼数:塘号) = 0
生活系统_鱼塘鱼种ID:塘号:(生活系统_鱼塘鱼数:塘号) = 0
;空塘则清除鱼种并重置状态
IF 生活系统_鱼塘鱼数:塘号 <= 0
        生活系统_鱼塘鱼种:塘号 =
        生活系统_鱼塘产卵剩:塘号 = 0
        生活系统_鱼塘孵化剩:塘号 = 0
        生活系统_鱼塘繁殖剩:塘号 = 0
        生活系统_鱼塘产卵季:塘号 = 0
ENDIF
RETURN

;--------------------------------------------------------
; 鱼种最大长度（cm，现实参考值）
;--------------------------------------------------------
@生活系统_鱼种最大长度(鱼种名)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS 鱼种名
SELECTCASE 鱼种名
        CASE "石斑鱼", "巨骨舌鱼", "鲟", "鳗鱼", "雷鱼"
                RETURNF 150
        CASE "鲑鱼", "虹鳟", "腔棘鱼", "铁甲鱼", "青鱼", "草鱼", "大口黑鲈"
                RETURNF 120
        CASE "皋月鳟", "山女鱼", "岩鱼", "姬鳟", "国鳟", "香鱼", "西太公鱼"
                RETURNF 60
        CASE "鲫鱼", "鲤鱼", "高身鲫", "鲶鱼", "杜父鱼", "斗鲈", "蓝鳃太阳鱼", "拉氏鱥", "溪哥", "八目鳗"
                RETURNF 40
ENDSELECT
RETURNF 60

;--------------------------------------------------------
; 产卵 / 孵化日数（按鱼种）
;--------------------------------------------------------
@生活系统_鱼塘产卵日数(鱼种名)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS 鱼种名
SELECTCASE 鱼种名
        CASE "鲫鱼", "鲤鱼", "草鱼", "高身鲫", "青鱼", "拉氏鱥", "溪哥"
                RETURNF 2
        CASE "蓝鳃太阳鱼", "鲶鱼", "杜父鱼", "香鱼", "石斑鱼"
                RETURNF 3
        CASE "皋月鳟", "山女鱼", "岩鱼", "虹鳟", "姬鳟", "国鳟"
                RETURNF 5
        CASE "鲑鱼"
                RETURNF 6
        CASE "鲟"
                RETURNF 8
        CASE "腔棘鱼", "雷鱼", "幽影鳞鱼", "火舌鲤", "影毒鳐", "星光鲦", "铁甲鱼", "泷太郎"
                RETURNF 5
ENDSELECT
RETURNF 4

@生活系统_鱼塘孵化日数(鱼种名)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS 鱼种名
SELECTCASE 鱼种名
        CASE "鲫鱼", "鲤鱼", "草鱼", "高身鲫", "青鱼", "拉氏鱥", "溪哥", "蓝鳃太阳鱼"
                RETURNF 2
        CASE "鲶鱼", "杜父鱼", "石斑鱼"
                RETURNF 3
        CASE "皋月鳟", "山女鱼", "岩鱼", "虹鳟", "姬鳟", "国鳟", "香鱼"
                RETURNF 4
        CASE "鲑鱼", "鲟", "腔棘鱼", "雷鱼", "幽影鳞鱼", "火舌鲤", "影毒鳐", "星光鲦", "铁甲鱼", "泷太郎"
                RETURNF 5
ENDSELECT
RETURNF 3

;--------------------------------------------------------
; 池内平均长度
;--------------------------------------------------------
@生活系统_鱼塘平均长度(塘号)
#FUNCTION
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM 塘号
SIF 生活系统_鱼塘鱼数:塘号 <= 0
        RETURNF 0
LOCAL = 0
FOR LOCAL:1, 0, 生活系统_鱼塘鱼数:塘号
        LOCAL += 生活系统_鱼塘长度:塘号:(LOCAL:1)
NEXT
RETURNF LOCAL / 生活系统_鱼塘鱼数:塘号

;--------------------------------------------------------
; 随机请求物品
;--------------------------------------------------------
@生活系统_鱼塘随机请求物()
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE RAND:6
        CASE 0
                RETURNF [[虫]]
        CASE 1
                RETURNF [[稀有昆虫]]
        CASE 2
                RETURNF [[鱼粕]]
        CASE 3
                RETURNF [[平价食材]]
        CASE 4
                RETURNF [[木材]]
        CASEELSE
                RETURNF [[蜂蜜]]
ENDSELECT

;--------------------------------------------------------
; 完成请求
;--------------------------------------------------------
@生活系统_鱼塘完成请求(塘号)
#DIM 塘号
#LOCALSIZE 1
#LOCALSSIZE 1
IF 生活系统_鱼塘请求:塘号 != 1
        RETURN 0
ENDIF
IF ITEM:(生活系统_鱼塘请求物:塘号) < 生活系统_鱼塘请求量:塘号
        PRINTFORML 材料不够
        RETURN 0
ENDIF
ITEM:(生活系统_鱼塘请求物:塘号) -= 生活系统_鱼塘请求量:塘号
生活系统_鱼塘请求:塘号 = 2
生活系统_鱼塘成长剩:塘号 = 3
生活系统_鱼塘繁殖剩:塘号 = MAX(生活系统_鱼塘繁殖剩:塘号 - 2, 0)
PRINTFORML 塘里的%生活系统_鱼塘鱼种:塘号%欢快地游动起来，似乎在感谢你！
RETURN 1

;--------------------------------------------------------
; 鱼种基础价
;--------------------------------------------------------
@生活系统_鱼种基础价(鱼种名)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS 鱼种名
SELECTCASE 鱼种名
        CASE "鲟", "腔棘鱼"
                RETURNF 5000
        CASE "鲑鱼", "鳗鱼", "雷鱼", "泷太郎"
                RETURNF 3000
        CASE "巨骨舌鱼", "铁甲鱼", "幽影鳞鱼", "火舌鲤", "影毒鳐", "星光鲦"
                RETURNF 2000
        CASE "石斑鱼", "青鱼", "草鱼", "大口黑鲈", "国鳟"
                RETURNF 1500
        CASE "虹鳟", "皋月鳟", "山女鱼", "岩鱼", "姬鳟", "香鱼", "西太公鱼"
                RETURNF 1000
        CASE "鲫鱼", "鲤鱼", "高身鲫", "鲶鱼", "杜父鱼", "斗鲈", "蓝鳃太阳鱼", "拉氏鱥", "溪哥", "八目鳗"
                RETURNF 500
ENDSELECT
RETURNF 800


;--------------------------------------------------------
; 共享进度条（写入全局字符串 生活系统_UI进度条）
;--------------------------------------------------------
@生活系统_进度条(值, 上限)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM 值
#DIM 上限
生活系统_UI进度条 =
FOR LOCAL, 0, LIMIT(值, 0, 上限)
        生活系统_UI进度条 += ""
NEXT
FOR LOCAL, LIMIT(值, 0, 上限), 上限
        生活系统_UI进度条 += ""
NEXT
RETURN
