;========================================================
; 生活系统大修 - 菜园增强实现（COMF418 的 DLC 版本）
; 文件：ERB/DLC/生活系统大修/生活系统_COM418.ERB
;
; 设计说明：
;   - 上游 COMF418 保留原样，@COM418 入口在 生活系统_种地 开关
;     开启时 CALL 本文件的 @生活系统_COM418（JUMP 分支结构）。
;   - 所有函数加 生活系统_ 前缀，避免与上游同名函数冲突；
;     开关关闭时本体行为完全不受影响。
;   - 生长逻辑（原 YASAI.ERB）由 生活系统_菜园生长 承担，
;     上游 YASAI 在开关开启时转入 DLC。
;========================================================

;-------------------------------------------------
;家庭菜園
;日常系指令、レベル1
;-------------------------------------------------
@生活系统_COM418
#LOCALSIZE 6
#LOCALSSIZE 1
;LOCAL:1 = 1 + FLAG:畑拡張
;生活系统大修：分页显示（每页8畝，超过一页显示翻页）
LOCAL:1 = 生活系统_畝数()
LOCAL:2 = 0    ;页码
$畝显示
LOCAL:5 = LINECOUNT    ;记录菜单起始行（翻页清屏用）
LOCAL:3 = LOCAL:2 * 8          ;本页起始全局畝号
LOCAL:4 = LOCAL:1 - LOCAL:3    ;本页畝数
SIF LOCAL:4 > 8
	LOCAL:4 = 8
FOR LOCAL,0,LOCAL:4
	CALL 生活系统_SHOW_PLANT(LOCAL:3 + LOCAL)
NEXT
;翻页与退出（超过一页才显示翻页选项）
SIF LOCAL:2 > 0
	PRINTL [998] 上一页
SIF LOCAL:3 + 8 < LOCAL:1
	PRINTL [997] 下一页
SIF 生活系统_种地
	PRINTFORML [996] 翻到指定页（共{(LOCAL:1 - 1) / 8 + 1}页）
SIF 生活系统_种地
	PRINTL [95] 一键播种（本页）　[96] 一键施肥（本页）
PRINTL [999] 算了
$INPUT_LOOP
INPUT
SELECTCASE RESULT
	CASE 998
		LOCAL:2 --
		CLEARLINE LINECOUNT - LOCAL:5
		GOTO 畝显示
	CASE 997
		LOCAL:2 ++
		CLEARLINE LINECOUNT - LOCAL:5
		GOTO 畝显示
	CASE 996
		;翻到指定页（由子系统开关控制）
		SIF !生活系统_种地
			RETURN -1
		PRINTFORML 输入要翻到的页码（1~{(LOCAL:1 - 1) / 8 + 1}）：
		$页码输入
		INPUT
		IF INRANGE(RESULT, 1, (LOCAL:1 - 1) / 8 + 1)
			LOCAL:2 = RESULT - 1
			CLEARLINE LINECOUNT - LOCAL:5
			GOTO 畝显示
		ELSE
			PRINTFORML 没有这个页码……
			CLEARLINE 2
			GOTO 页码输入
		ENDIF
	CASE 95
		;一键播种（本页空畝，由子系统开关控制）
		SIF !生活系统_种地
			RETURN -1
		CALL 生活系统_一键播种(LOCAL:3, LOCAL:4)
		IF RESULT > 0
			IF FLAG:70 == 0
				TIME += RESULT
				M_TFLAG:时间因子类型 = TimeFactor_采集
			ELSE
				BASE:MASTER:TSP -= RESULT * 3
			ENDIF
		ENDIF
		;等待确认：让"等级不足/季节不符/完成"等提示可见（否则会被下方清屏抹掉）
		WAIT
		CLEARLINE LINECOUNT - LOCAL:5
		GOTO 畝显示
	CASE 96
		;一键施肥（本页已种畝，由子系统开关控制）
		SIF !生活系统_种地
			RETURN -1
		CALL 生活系统_一键施肥(LOCAL:3, LOCAL:4)
		IF RESULT > 0
			IF FLAG:70 == 0
				TIME += RESULT
				M_TFLAG:时间因子类型 = TimeFactor_采集
			ELSE
				BASE:MASTER:TSP -= RESULT * 3
			ENDIF
		ENDIF
		;等待确认：让提示可见（否则会被下方清屏抹掉）
		WAIT
		CLEARLINE LINECOUNT - LOCAL:5
		GOTO 畝显示
	CASE 999
		RETURN -1
	CASEELSE
		;输入全局畝号（与显示一致）：畝号*100+行动号
		IF INRANGE(RESULT / 100, LOCAL:3, LOCAL:3 + LOCAL:4 - 1)
			LOCAL:3 = RESULT / 100
			CALL 生活系统_FARMING(LOCAL:3, RESULT % 100)
			IF RESULT == 0
				RETURN -1
			ELSEIF FLAG:70 == 0
				TIME += RESULT
				M_TFLAG:时间因子类型 = TimeFactor_采集
			ELSE
				BASE:MASTER:TSP -= RESULT * 3
			ENDIF
			RETURN 0
		ELSE
			CLEARLINE 1
			GOTO INPUT_LOOP
		ENDIF
ENDSELECT


@生活系统_FARMING(ARG, 行動番号)
#DIM 行動番号
#DIM 行動コスト
#DIM 畝尺寸

行動コスト = 0
LOCALS = %HATAKE_NAME:ARG%
IF 行動番号 == 0
	IF PLANT_TYPE:ARG > 0
		PRINTFORML 已经种植了%LOCALS%
		;行動コスト += 5
	ELSE
		PRINTL 要种什么呢？ (持有数)
		CALL 生活系统_INPLANT(ARG)
		IF RESULT
			行動コスト += 10
		ENDIF
	ENDIF
ELSEIF 行動番号 == 1
	IF !PLANT_DRY:ARG
		PRINTL 今天已经浇够水了
	;ELSEIF !TFLAG:打水
	ELSEIF VAR_WATER == ""
		PRINTL 还没有打水
	ELSE
		PLANT_DRY:ARG = 0
		PRINTFORML 对%LOCALS%浇了水
		SIF ITEM:三粒の天滴
			FLAG:天滴坤神 = 1
		行動コスト += 5
	ENDIF
ELSEIF 行動番号 == 2
	;収穫処理を関数化（生活系统大修：调用含经验/天赋的收获函数）
	行動コスト = 生活系统_HERVEST(ARG, LOCALS)

;全収穫追加
ELSEIF 行動番号 == 6
	;PRINTFORML 全ての畝を収穫します
	畝尺寸 = 生活系统_畝数()
	FOR LOCAL,0,畝尺寸
		LOCALS = %HATAKE_NAME:LOCAL%
		行動コスト += 生活系统_HERVEST(LOCAL, LOCALS)
	NEXT
ELSEIF 行動番号 == 3
	IF PLANT_DRY:ARG <= 4 && PLANT_GROW:ARG <= 10
		PRINTFORML %LOCALS%要拔掉吗？
		CALL ASK_YN
		IF RESULT
			;行動コスト += 5
			RETURN 0
		ENDIF
	ENDIF
	PLANT_TYPE:ARG = 0
	PLANT_DAYS:ARG = 0
	PLANT_GROW:ARG = 0
	PLANT_DRY:ARG = 0
	HATAKE_NAME:ARG =
	PLANT_FOOD:ARG = 0
	PLANT_HARVESTED:ARG = 0
	PRINTFORML 拔掉了%LOCALS%
	行動コスト += 10
;畑が拡張されたら全体にします
ELSEIF 行動番号 == 4 && ITEM:簡易泳池 && GETBIT (FLAG:泳池, 2)
	IF !PLANT_DRY:ARG
		PRINTL 今天已经浇够水了
	ELSE
		;PLANT_DRY:ARG = 0
		
		畝尺寸 = 生活系统_畝数()
		FOR LOCAL,0, 畝尺寸
			PLANT_DRY:LOCAL = 0
		NEXT
		PRINTFORML 对%LOCALS%浇了水
		SIF ITEM:三粒の天滴
			FLAG:天滴坤神 = 1
		行動コスト += 5
	ENDIF
ELSEIF 行動番号 == 5 && ITEM:肥料
	IF PLANT_FOOD:ARG
		PRINTL 肥料太多了也不是好事
	ELSE
		PLANT_FOOD:ARG = 1
		PRINTFORML 对%LOCALS%施了肥料
		行動コスト += 20
		ITEM:肥料 --
	ENDIF
ELSE
	;行動コスト += 5
	RETURN 0
ENDIF
RETURN 行動コスト

@生活系统_INPLANT(ARG)
FOR LOCAL, 0, 1000
	;生活系统大修：新种子作物（育苗产物193~219）也可种植；908育苗设施是家具非苗
	IF (STRCOUNT(ITEMNAME:LOCAL, "苗") || INRANGE(LOCAL, 193, 219)) && LOCAL != 908
		;苗以外を除外
		SIF ITEM:LOCAL
			PRINTFORML [{LOCAL}]%ITEMNAME_TR((LOCAL)), 14, LEFT%（持有{ITEM:(LOCAL), 2, RIGHT}个）
	ENDIF
NEXT
PRINTL [999] 算了
$INPUT_LOOP
INPUT
IF ITEM:RESULT && (STRCOUNT(ITEMNAME:RESULT, "苗") || INRANGE(RESULT, 193, 219)) && RESULT != 908
	;生活系统大修：等级/季节限制（由子系统开关控制）
	IF 生活系统_种地
		;耕种等级限制（植株等级 > 耕种Lv 不可种）
		IF 生活系统_植株等级(RESULT) > TALENT:MASTER:耕种Lv
			PRINTFORML 你的耕种技艺还不足以驾驭这种作物……
			RETURN 0
		ENDIF
		;季节限制（温室大棚 909 可无视）
		IF ITEM:909 == 0
			LOCAL = 生活系统_植株季节(RESULT)
			IF !(LOCAL & (1 << (DAY:2 - 1)))
				PRINTFORML 现在不是适宜种植的季节……
				RETURN 0
			ENDIF
		ENDIF
	ENDIF
	PRINTFORML 在畑{ARG}里种上了%ITEMNAME_TR((RESULT))%
	ITEM:RESULT -= 1
	PLANT_TYPE:ARG = RESULT
	PLANT_DRY:ARG = 1
	;生活系统大修：重置已收果期标记
	PLANT_HARVESTED:ARG = 0
	;三粒の天滴を持っている場合、植えてすぐに施肥、水撒き完了状態に
	IF ITEM:三粒の天滴
		PLANT_DRY:ARG = 0
		PLANT_FOOD:ARG = 1
		FLAG:天滴坤神 = 1
	ENDIF
	HATAKE_NAME:ARG = %ITEMNAME_TR((生活系统_苗対応作物番号取得(PLANT_TYPE:ARG)))%
	;天赋：沃土（种植免费施肥，由子系统开关控制）
	IF 生活系统_种地 && TALENT:MASTER:沃土
		PLANT_FOOD:ARG = 1
	ENDIF
	RETURN 1
ELSE
	RETURN 0
ENDIF

@生活系统_SHOW_PLANT(ARG)
PRINTFORM 畑{ARG}：
;正常な道具かチェック
IF ITEMNAME:生活系统_苗対応作物番号取得(PLANT_TYPE:ARG) == ""
	PLANT_TYPE:ARG = 0
	PLANT_DAYS:ARG = 0
	PLANT_GROW:ARG = 0
	PLANT_DRY:ARG = 0
	HATAKE_NAME:ARG =
	PLANT_FOOD:ARG = 0
	PLANT_HARVESTED:ARG = 0
ENDIF
IF PLANT_TYPE:ARG > 0
	SETCOLOR 0x00FF00
	PRINTFORM %HATAKE_NAME:ARG + "栽培中", 16, LEFT%
	IF PLANT_DRY:ARG > 4 || PLANT_GROW:ARG > 10
		SETCOLOR 0x994C00
		PRINT （枯）
	ELSE
			SELECTCASE PLANT_GROW:ARG
				CASE 10
					SETCOLOR 0xFF0000
					PRINT （熟）
				CASE 8,9
					SETCOLOR 0xFF8000
					PRINT （果）
				CASE 6,7
					SETCOLOR 0xFFFF00
					PRINT （花）
				CASE 4,5
					PRINT （叶）
				CASEELSE
					PRINT （苗）
			ENDSELECT 
			;生活系统大修：保留植株作物已收过果期
			SIF PLANT_HARVESTED:ARG
				PRINT 　（已采一茬）
		ENDIF
	IF !PLANT_DRY:ARG
		SETCOLOR C_AQUA
		PRINT 　撒水完毕
	ENDIF
	IF PLANT_FOOD:ARG
		SETCOLOR C_CREAM
		IF ITEM:三粒の天滴
			PRINT 　享受着坤神的恩惠
		ELSE
			PRINT 　已施肥
		ENDIF
	ENDIF
	RESETCOLOR
	PRINTL
	;時間停止中は菜園の状態を見るだけ
	;SIF FLAG:70 == 1
	;	RETURN
	;水撒き
	IF PLANT_DRY:ARG
		LOCAL = ARG * 100 + 1
		LOCALS = [%TOSTR(LOCAL, "000")%] - 洒水
		PRINTBUTTONLC LOCALS, LOCAL
	ELSE
		PRINTLC 　
	ENDIF
	;収穫
	IF 生活系统_収穫可能(ARG)
		LOCAL = ARG * 100 + 2
		LOCALS = [%TOSTR(LOCAL, "000")%] - 收获
		SIF PLANT_GROW:ARG == 10
			SETCOLOR 0xFF0000
		PRINTBUTTONLC LOCALS, LOCAL
		RESETCOLOR
	ELSE
		PRINTLC 　
	ENDIF
	;全収穫追加
	;全て収穫
	IF 生活系统_収穫可能(ARG)
		LOCAL = ARG * 100 + 6
		LOCALS = [%TOSTR(LOCAL, "000")%] - 全部收获
		SIF PLANT_GROW:ARG == 10
			SETCOLOR 0xFF0000
		PRINTBUTTONLC LOCALS, LOCAL
		RESETCOLOR
	ELSE
		PRINTLC 　
	ENDIF
	;整地
	LOCAL = ARG * 100 + 3
	LOCALS = [%TOSTR(LOCAL, "000")%] - 抜出
	PRINTBUTTONLC LOCALS, ARG * 100 + 03
	;自动洒水系统
	IF ITEM:簡易泳池 && GETBIT (FLAG:泳池, 2) && PLANT_DRY:ARG
		LOCAL = ARG * 100 + 4
		LOCALS = [%TOSTR(LOCAL, "000")%] - 自动洒水系统
		PRINTBUTTONLC LOCALS, LOCAL
	ELSE
		PRINTLC 　
	ENDIF
	;肥料を撒く
	IF ITEM:肥料 && PLANT_FOOD:ARG == 0
		LOCAL = ARG * 100 + 5
		LOCALS = [%TOSTR(LOCAL, "000")%] - 施肥
		PRINTBUTTONLC LOCALS, LOCAL
	ELSE
		PRINTLC 　
	ENDIF
ELSE
	PRINTL 空闲
	;時間停止中は菜園の状態を見るだけ
	;SIF FLAG:70 == 1
	;	RETURN
	;苗植え
	LOCAL = ARG * 100 + 0
	LOCALS = [%TOSTR(LOCAL, "000")%] - 种苗
	PRINTBUTTONLC LOCALS, LOCAL
ENDIF
PRINTL

@生活系统_収穫可能(ARG)
#FUNCTION
RETURNF PLANT_GROW:ARG > 7 && !(PLANT_DRY:ARG > 4 || PLANT_GROW:ARG > 10)

;-------------------------------------------------
;実行判定
;-------------------------------------------------
@生活系统_畝数()
#FUNCTION
#DIM 畝尺寸
;生活系统大修：子系统开启时 = 基础（采集+农民）+ 开荒数，上限8（隙间耕地910时240）；关闭时保持原版
IF 生活系统_种地
	畝尺寸 = 生活系统_基础畝数() + 生活系统_开荒数
	IF 畝尺寸 > 生活系统_畝上限()
		畝尺寸 = 生活系统_畝上限()
	ENDIF
ELSE
	;原版逻辑：基础1 + 采集等级加成
	畝尺寸 = 1
	IF TALENT:MASTER:採集Lv > 5
		畝尺寸 += 3
	ELSEIF TALENT:MASTER:採集Lv > 4
		畝尺寸 += 2
	ELSEIF TALENT:MASTER:採集Lv > 2
		畝尺寸 += 2
	ELSEIF TALENT:MASTER:採集Lv > 0
		畝尺寸 += 1
	ENDIF
ENDIF
RETURNF 畝尺寸

;全収穫追加
;----------------------------------
;畝一つの収穫処理
;ARG:苗インデックス, ARGS:苗の名称
;-----------------------------------
@生活系统_HERVEST(ARG, ARGS)
#FUNCTION
#DIM 行動コスト

	行動コスト = 0

	;八百屋で購入できるようになったため収穫条件の厳格化
	IF 生活系统_収穫可能(ARG) == 0
		;PRINTL 不是可以收获的状态
		RETURNF 行動コスト
	ENDIF
	;生活系统大修：新种子作物（育苗产物193~219）两阶段收获
	IF INRANGE(PLANT_TYPE:ARG, 193, 219)
		;基础收获量按成品稀有度（价格）分档
		LOCAL = 生活系统_收获基础量(生活系统_苗対応作物番号取得(PLANT_TYPE:ARG))
		;熟期（PLANT_GROW>=10）收获量翻倍
		SIF PLANT_GROW:ARG >= 10
			LOCAL *= 2
		;施肥/天滴/长期栽培加成
		SIF PLANT_FOOD:ARG
			LOCAL += LOCAL / 3
		SIF FLAG:天滴坤神 && RAND:2 == 1
			LOCAL += LOCAL / 3
		SIF PLANT_DAYS:ARG > 9
			LOCAL += LOCAL / 3
		SIF TCVAR:MASTER:豊穣
			LOCAL += LOCAL / 5
		IF MAGIC_DLC_大成功相关
			LOCAL += LOCAL * MAGIC_SuccessRate() /200
		ENDIF
		;妖精之友加成
		LOCAL += Add_Apply_Fairy_Title_Bonus("gardening")
		;天赋：丰收（熟期收获额外1~3个）/ 双收（10%概率翻倍，可叠加，由子系统开关控制）
		SIF 生活系统_种地 && TALENT:MASTER:丰收 && PLANT_GROW:ARG >= 10
			LOCAL += 1 + RAND:3
		SIF 生活系统_种地 && TALENT:MASTER:双收 && !RAND:10
			LOCAL *= 2
		;保留植株作物（浆果/菌菇）：果期收获后不拔除，等熟期再收一茬
		IF 生活系统_保留植株(PLANT_TYPE:ARG) && !PLANT_HARVESTED:ARG && PLANT_GROW:ARG < 10
			PLANT_HARVESTED:ARG = 1
			PRINTFORML 收获了{LOCAL}个%ARGS%，植株保留了下来，还能再收一茬……
			ITEM:(生活系统_苗対応作物番号取得(PLANT_TYPE:ARG)) += LOCAL
			;生活系统大修：耕种经验（收获时获得 = 收获个数 × 植株等级；未登记等级保底1点，由子系统开关控制）
			SIF 生活系统_种地
				EXP:MASTER:耕种経験 += LOCAL * MAX(生活系统_植株等级(PLANT_TYPE:ARG), 1)
			行動コスト += 20
			RETURNF 行動コスト
		ENDIF
		PRINTFORML 收获了{LOCAL}个%ARGS%
		ITEM:(生活系统_苗対応作物番号取得(PLANT_TYPE:ARG)) += LOCAL
		;生活系统大修：耕种经验（收获时获得 = 收获个数 × 植株等级；未登记等级保底1点，由子系统开关控制）
		SIF 生活系统_种地
			EXP:MASTER:耕种経験 += LOCAL * MAX(生活系统_植株等级(PLANT_TYPE:ARG), 1)
		PLANT_TYPE:ARG = 0
		PLANT_DAYS:ARG = 0
		PLANT_GROW:ARG = 0
		PLANT_DRY:ARG = 0
		HATAKE_NAME:ARG =
		PLANT_FOOD:ARG = 0
		PLANT_HARVESTED:ARG = 0
		行動コスト += 20
		RETURNF 行動コスト
	ENDIF
	SIF PLANT_DAYS:ARG > 9
		PLANT_GROW:ARG += 2
	SIF PLANT_FOOD:ARG
		PLANT_GROW:ARG ++
	SIF FLAG:天滴坤神 && RAND:2 == 1
		PLANT_GROW:ARG += 2
	;大豊作…天滴と肥料補正でないと到達不能
	IF PLANT_GROW:ARG > 12
		PRINTL 大丰收！
		IF PLANT_FOOD:ARG
			LOCAL = 20 + RAND:6 + RAND:4
		ELSE
			LOCAL = 20
		ENDIF
	ELSEIF PLANT_GROW:ARG > 10
		PRINTL 丰收了！
		IF PLANT_FOOD:ARG
			LOCAL = 14 + RAND:4 + RAND:3
		ELSE
			LOCAL = 14
		ENDIF
	ELSEIF PLANT_GROW:ARG > 7
		IF PLANT_FOOD:ARG
			LOCAL = 7 + RAND:3 + RAND:2
		ELSE
			LOCAL = 7
		ENDIF
	ELSE
		LOCAL = 5
	ENDIF
	SIF TCVAR:MASTER:豊穣
		LOCAL += LOCAL / 5
	;跳蛋一強を崩すため収穫量ダウン
	IF 生活系统_苗対応作物番号取得(PLANT_TYPE:ARG) == 0
		LOCAL /= 2
	ENDIF
	IF MAGIC_DLC_大成功相关
		LOCAL += LOCAL * MAGIC_SuccessRate() /200
	ENDIF
	;妖精之友加成
	LOCAL += Add_Apply_Fairy_Title_Bonus("gardening")
	;天赋：丰收（熟期收获额外1~3个）/ 双收（10%概率翻倍，可叠加，由子系统开关控制）
	SIF 生活系统_种地 && TALENT:MASTER:丰收 && PLANT_GROW:ARG >= 10
		LOCAL += 1 + RAND:3
	SIF 生活系统_种地 && TALENT:MASTER:双收 && !RAND:10
		LOCAL *= 2
	PRINTFORML 收获了{LOCAL}个%ARGS%
	ITEM:(生活系统_苗対応作物番号取得(PLANT_TYPE:ARG)) += LOCAL
	;生活系统大修：耕种经验（收获时获得 = 收获个数 × 植株等级；未登记等级如跳蛋苗等保底1点，由子系统开关控制）
	SIF 生活系统_种地
		EXP:MASTER:耕种経験 += LOCAL * MAX(生活系统_植株等级(PLANT_TYPE:ARG), 1)
	PLANT_TYPE:ARG = 0
	PLANT_DAYS:ARG = 0
	PLANT_GROW:ARG = 0
	PLANT_DRY:ARG = 0
	HATAKE_NAME:ARG =
	PLANT_FOOD:ARG = 0
	行動コスト += 20
RETURNF 行動コスト



@生活系统_苗対応作物番号取得(ARG)
#FUNCTION
SELECTCASE ARG
	;育苗设施（家具908）名字含"苗"但并非作物，返回自身避免+200越界
	CASE 908
		RETURNF 908
