;========================================================
; 生活系统大修 - 种地系统
; 文件：ERB/DLC/生活系统大修/生活系统_种地.ERB
;
; 开关：生活系统_种地（控制育苗指令 COMF471 的可用性）
; 钩子：@生活系统_种地_每日事件 由 DLCEVENT 在每日结算时调用
;
; 功能：
; 1. 育苗指令（COMF471 育苗）：把采集素材育成可种植的种子
; 2. 新种子作物（山菜种子 等）：可在家庭菜园种植，
;    收获量按成品稀有度分档，熟期收获量翻倍；
;    浆果/菌菇类作物收获后保留植株，可再收一茬
;========================================================

;--------------------------------------------------------
; 收获基础量：按成品价格（稀有度）分档
; 参数：成品ITEM_ID
; 返回：果期基础收获量（熟期 = 基础量 × 2）
;--------------------------------------------------------
@生活系统_收获基础量(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ITEMPRICE:ARG
	CASE IS <= 100
		RETURNF 8
	CASE IS <= 500
		RETURNF 6
	CASE IS <= 2000
		RETURNF 4
	CASE IS <= 7000
		RETURNF 2
	CASEELSE
		RETURNF 1
ENDSELECT
RETURNF 1

;--------------------------------------------------------
; 保留植株判定：浆果/藤本/菌菇类作物收获后保留植株，
; 可等下一阶段再收一茬（模拟现实中可多次采集的植物）
; 参数：苗ITEM_ID（193~219 区间的新种子）
; 返回：1=保留植株（两次收获） 0=一年生（一次性收获）
;--------------------------------------------------------
@生活系统_保留植株(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ARG
	;浆果/藤本果树：树莓、山葡萄、木通果
	CASE 195, 196, 205
		RETURNF 1
	;菌菇类：菌丝保留可再出菇
	CASE 197, 198, 199, 209, 210, 217
		RETURNF 1
	CASEELSE
		RETURNF 0
ENDSELECT
RETURNF 0

;--------------------------------------------------------
; 植株等级判定：耕种Lv >= 植株等级 才可种植
; 参数：苗/种子ITEM_ID（PLANT_TYPE 中存的值）
; 返回：1~6（未登记等级的特殊可种物品=1级）
;--------------------------------------------------------
@生活系统_植株等级(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ARG
	;育苗产物（等级 = 育苗配方等级）
	CASE 193, 194, 195, 196, 197, 198, 199, 200
		RETURNF 1
	CASE 201, 202, 203, 204, 205
		RETURNF 2
	CASE 206, 207
		RETURNF 3
	CASE 208, 209, 210, 211
		RETURNF 4
	CASE 217, 218
		RETURNF 5
	CASE 219
		RETURNF 6
	;原版蔬菜苗
	CASE 153, 163, 172, 182
		RETURNF 1
	CASE 151, 161, 174, 181, 183
		RETURNF 2
	CASE 152, 162, 164, 171, 173
		RETURNF 3
	CASEELSE
		RETURNF 1    ;特殊可种物品（跳蛋苗/红茶/冰淇淋等）设为一级
ENDSELECT
RETURNF 1

;--------------------------------------------------------
; 植株适宜季节判定：位掩码 1春 2夏 4秋 8冬
; 参数：苗/种子ITEM_ID
; 返回：季节位掩码（15=全年）
;--------------------------------------------------------
@生活系统_植株季节(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ARG
	;育苗产物（按对应成材的适宜季节）
	CASE 193                ;山菜（春）
		RETURNF 1
	CASE 194, 202           ;药草/高級药草（春夏）
		RETURNF 3
	CASE 195                ;树莓（夏）
		RETURNF 2
	CASE 196                ;山葡萄（夏秋）
		RETURNF 6
	CASE 197, 198, 199, 200, 203, 204, 205, 206, 207, 209, 210, 211, 217   ;菌菇/薯类/秋收作物
		RETURNF 4
	CASE 201, 208, 218      ;毒草/特药草/曼陀罗草（夏）
		RETURNF 2
	CASE 219                ;雪霊草（冬）
		RETURNF 8
	;原版蔬菜苗
	CASE 152, 153, 163, 172, 182, 183  ;春菜：草莓/芜菁/洋葱/马铃薯/胡萝卜/葱
		RETURNF 1
	CASE 151, 161, 162, 164, 171, 174  ;夏菜：卷心菜/黄瓜/番茄/西瓜/茄子/大麦
		RETURNF 2
	CASE 173, 181            ;秋菜：南瓜/白菜
		RETURNF 4
	CASEELSE
		RETURNF 15            ;全年（跳蛋苗等）
ENDSELECT
RETURNF 15

;--------------------------------------------------------
; 基础畝数 = 1（基础）+ 采集等级加成（原版逻辑）+ 农民 FLAG:畑拡張
;--------------------------------------------------------
@生活系统_基础畝数
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 1
IF TALENT:MASTER:採集Lv > 5
	LOCAL += 3
ELSEIF TALENT:MASTER:採集Lv > 4
	LOCAL += 2
ELSEIF TALENT:MASTER:採集Lv > 2
	LOCAL += 2
ELSEIF TALENT:MASTER:採集Lv > 0
	LOCAL += 1
ENDIF
LOCAL += FLAG:畑拡張
RETURNF LOCAL

;--------------------------------------------------------
; 菜园畝数上限：普通 8 块（场地内小菜园），
; 持有「隙间耕地」（910）时突破至 240 块
;--------------------------------------------------------
@生活系统_畝上限
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
IF ITEM:910 >= 1
	RETURNF 240
ENDIF
RETURNF 8

;--------------------------------------------------------
; 一键播种：对指定范围内的空畝种下同一种子
; 参数：ARG=起始畝号 ARG:1=畝数（本页）
; 返回：行动成本（10分钟/畝，0=未执行）
;--------------------------------------------------------
@生活系统_一键播种(ARG, ARG:1)
#LOCALSIZE 3
#LOCALSSIZE 1
;显示可种种子（与 INPLANT 一致）
FOR LOCAL,0,1000
	IF (STRCOUNT(ITEMNAME:LOCAL, "苗") || INRANGE(LOCAL, 193, 219)) && LOCAL != 908
		SIF ITEM:LOCAL
			PRINTFORML [{LOCAL}]%ITEMNAME_TR((LOCAL)), 14, LEFT%（持有{ITEM:(LOCAL), 2, RIGHT}个）
	ENDIF
NEXT
PRINTL [0] 取消
INPUT
IF !RESULT
	RETURN 0
ENDIF
LOCAL = RESULT    ;种子ID
;校验（等级/季节，与 INPLANT 一致）
IF !(STRCOUNT(ITEMNAME:LOCAL, "苗") || INRANGE(LOCAL, 193, 219)) || LOCAL == 908
	PRINTFORML 不能种这个……
	RETURN 0
ENDIF
IF 生活系统_植株等级(LOCAL) > TALENT:MASTER:耕种Lv
	PRINTFORML 你的耕种技艺还不足以驾驭这种作物……
	RETURN 0
ENDIF
IF ITEM:909 == 0
	LOCAL:2 = 生活系统_植株季节(LOCAL)
	IF !(LOCAL:2 & (1 << (DAY:2 - 1)))
		PRINTFORML 现在不是适宜种植的季节……
		RETURN 0
	ENDIF
ENDIF
;逐畝种植（空畝；种子不足停止）
LOCAL:2 = 0    ;种植数
FOR LOCAL:1, 0, ARG:1
	IF PLANT_TYPE:(ARG + LOCAL:1)
		CONTINUE
	ENDIF
	SIF ITEM:LOCAL == 0
		BREAK
	ITEM:LOCAL --
	PLANT_TYPE:(ARG + LOCAL:1) = LOCAL
	PLANT_DRY:(ARG + LOCAL:1) = 1
	PLANT_HARVESTED:(ARG + LOCAL:1) = 0
	;三粒の天滴：种下即浇水施肥完成状态
	IF ITEM:三粒の天滴
		PLANT_DRY:(ARG + LOCAL:1) = 0
		PLANT_FOOD:(ARG + LOCAL:1) = 1
		FLAG:天滴坤神 = 1
	ENDIF
	HATAKE_NAME:(ARG + LOCAL:1) = %ITEMNAME_TR((生活系统_苗対応作物番号取得(LOCAL)))%
	;天赋：沃土（种植免费施肥，由子系统开关控制）
	IF 生活系统_种地 && TALENT:MASTER:沃土
		PLANT_FOOD:(ARG + LOCAL:1) = 1
	ENDIF
	LOCAL:2 ++
NEXT
IF LOCAL:2
	PRINTFORML 一键播种完成！在{LOCAL:2}块畝上种下了%ITEMNAME_TR((LOCAL))%（剩余{ITEM:LOCAL}个）
ELSE
	PRINTFORML 本页没有可种植的空畝……
ENDIF
RETURN LOCAL:2 * 10

;--------------------------------------------------------
; 一键施肥：对指定范围内已种植且未施肥的畝施肥
; 参数：ARG=起始畝号 ARG:1=畝数（本页）
; 返回：行动成本（20分钟/畝，0=未执行）
;--------------------------------------------------------
@生活系统_一键施肥(ARG, ARG:1)
#LOCALSIZE 2
#LOCALSSIZE 1
IF ITEM:肥料 == 0
	PRINTFORML 没有肥料……
	RETURN 0
ENDIF
LOCAL = 0    ;施肥数
FOR LOCAL:1, 0, ARG:1
	IF PLANT_TYPE:(ARG + LOCAL:1) == 0 || PLANT_FOOD:(ARG + LOCAL:1)
		CONTINUE
	ENDIF
	SIF ITEM:肥料 == 0
		BREAK
	ITEM:肥料 --
	PLANT_FOOD:(ARG + LOCAL:1) = 1
	LOCAL ++
NEXT
IF LOCAL
	PRINTFORML 一键施肥完成！给{LOCAL}块畝施了肥（剩余肥料{ITEM:肥料}个）
ENDIF
RETURN LOCAL * 20

;--------------------------------------------------------
; 天赋二选一事件：条件满足时自动弹出，玩家二选一
; 参数：ARG=天赋位A ARG:1=天赋位B（FLAG:耕种BONUS取得状況 的位）
;--------------------------------------------------------
@生活系统_天赋选择事件(ARG, ARG:1)
#LOCALSIZE 2
#LOCALSSIZE 1
PRINTL 
SETCOLOR C_YELLOW
IF ARG == 1
	PRINTFORML 你的耕种技艺日益精进，领悟了新的耕种天赋！
	PRINTFORML [1] 【催熟】——果实进入果期时立即成熟
	PRINTFORML [2] 【丰收】——收获成熟植株时额外获得1~3个
ELSE
	PRINTFORML 你已是耕种的达人，领悟了更深层的耕种天赋！
	PRINTFORML [1] 【沃土】——种植时免费获得施肥效果
	PRINTFORML [2] 【双收】——收获时有10％概率翻倍
ENDIF
RESETCOLOR
PRINTL [0] 稍后再说
$天赋选择输入
INPUT
SELECTCASE RESULT
	CASE 1
		SETBIT FLAG:耕种BONUS取得状況, ARG
		CLEARBIT FLAG:耕种BONUS取得状況, ARG:1
		IF ARG == 1
			PRINTFORMW 领悟了【催熟】！
		ELSE
			PRINTFORMW 领悟了【沃土】！
		ENDIF
		CALL ボーナス素質判定
	CASE 2
		SETBIT FLAG:耕种BONUS取得状況, ARG:1
		CLEARBIT FLAG:耕种BONUS取得状況, ARG
		IF ARG == 1
			PRINTFORMW 领悟了【丰收】！
		ELSE
			PRINTFORMW 领悟了【双收】！
		ENDIF
		CALL ボーナス素質判定
	CASE 0
		RETURN
	CASEELSE
		CLEARLINE 1
		GOTO 天赋选择输入
ENDSELECT
RETURN

;--------------------------------------------------------
; 每日事件钩子（DLCEVENT 在每日结算时调用）
;--------------------------------------------------------
@生活系统_种地_每日事件
#LOCALSIZE 2
#LOCALSSIZE 1
SIF !生活系统_种地
	RETURN
;采集等级提升使基础畝数增加，但菜园已开垦完毕时提示
IF 生活系统_上次基础畝数 > 0 && 生活系统_基础畝数() > 生活系统_上次基础畝数 && 生活系统_基础畝数() + 生活系统_开荒数 >= 生活系统_畝上限()
	PRINTFORML 可以使用的地皮已经都开荒完毕了……
ENDIF
生活系统_上次基础畝数 = 生活系统_基础畝数()
;耕种Lv3：天赋二选一事件（未选时每日自动弹出）
IF TALENT:MASTER:耕种Lv >= 3 && !GETBIT (FLAG:耕种BONUS取得状況, 1) && !GETBIT (FLAG:耕种BONUS取得状況, 2)
	CALL 生活系统_天赋选择事件(1, 2)
ENDIF
;耕种Lv6：天赋二选一事件
IF TALENT:MASTER:耕种Lv >= 6 && !GETBIT (FLAG:耕种BONUS取得状況, 3) && !GETBIT (FLAG:耕种BONUS取得状況, 4)
	CALL 生活系统_天赋选择事件(3, 4)
ENDIF
;隙间耕地条件达成提示（领取在实绩页）
IF ITEM:910 == 0 && GETUNELENGTH418() >= 8 && TALENT:MASTER:耕种Lv >= 5
	PRINTFORML 菜园已经开垦至8块，你的耕种技艺也已纯熟——可以前往实绩页领取「隙间耕地」了！
ENDIF
;花屋解锁事件：今日通过育苗获得的模组苗 → 当晚把培育方法送去花屋，获得酬金并解锁出售
FOR LOCAL, 193, 220
	SIF !花屋苗今日获得:LOCAL
		CONTINUE
	花屋苗今日获得:LOCAL = 0
	;已解锁过的苗不重复触发（解锁与酬金仅一次）
	SIF 花屋苗解锁:LOCAL
		CONTINUE
	花屋苗解锁:LOCAL = 1
	;苗→对应成材，酬金 = 成材出售金额（定价）×10，并附赠10个成材（补充低级植株收益）
	;注意：GET_ITEM 需用原语名（ITEMNAME）查询，不能用翻译名（ITEMNAME_TR）——翻译可能与原名不同（如 山菜→野菜）
	LOCAL:1 = 生活系统_苗対応作物番号取得(LOCAL)
	PRINTFORMW 你将「%ITEMNAME_TR((LOCAL:1))%」的培育方法送到了花屋，花屋对你表示感谢
	MONEY += ITEMPRICE:(LOCAL:1) * 10
	PRINTFORMW 获得了酬金%金額表示(ITEMPRICE:(LOCAL:1) * 10)%元！
	CALL GET_ITEM(@"%ITEMNAME:(LOCAL:1)%", 10, 3)
	PRINTFORMW 花屋还附赠了10个「%ITEMNAME_TR((LOCAL:1))%」作为谢礼！
NEXT
RETURN

;--------------------------------------------------------
; 苗/种子 → 对应成材（收获物）映射
; 参数：苗/种子ITEM_ID（含育苗产物193~219与原版蔬菜苗）
; 返回：对应成材ITEM_ID
; 原版蔬菜苗（名字含"苗"）→ 成材 = 苗ID + 200（跳蛋苗特判→跳蛋）；
; 育苗产物走显式映射表；育苗设施（908）名字含"苗"但并非作物，返回自身
; 注：本函数原位于 COMF418，为减少原位修改迁移至此（调用点不变）
;--------------------------------------------------------
@生活系统_菜园生长
#LOCALSIZE 2
#LOCALSSIZE 1
FOR LOCAL,0,240
	IF PLANT_TYPE:LOCAL
		SIF FLAG:澆水代行
			PLANT_DRY:LOCAL = 0
		PLANT_DAYS:LOCAL ++
		PLANT_DRY:LOCAL ++

		;季节枯萎判定（温室大棚 909 时无视季节）
		LOCAL:1 = 生活系统_植株季节(PLANT_TYPE:LOCAL)
		IF ITEM:909 || (LOCAL:1 & (1 << (DAY:2 - 1)))
			;季节适宜（或有温室）→ 正常生长
			IF MAIN_MAP == 9
				PLANT_GROW:LOCAL ++
				;肥やしを撒いてある場合は追加
				SIF PLANT_FOOD:LOCAL && PLANT_GROW:LOCAL < 10
					PLANT_GROW:LOCAL ++
			ELSE
				SELECTCASE TIME:5
				CASE 0,1
					PLANT_GROW:LOCAL ++
					;肥やしを撒いてある場合は追加
					SIF PLANT_FOOD:LOCAL && PLANT_GROW:LOCAL < 10
						PLANT_GROW:LOCAL ++
				CASE 2,3
					PLANT_GROW:LOCAL += RAND:2
					SIF PLANT_FOOD:LOCAL && PLANT_GROW:LOCAL < 10
						PLANT_GROW:LOCAL ++
				CASE 4 TO 7
					PLANT_DRY:LOCAL = 0
					;肥やしを撒いてある場合は1/2の確率でさらに追加
					SIF PLANT_FOOD:LOCAL && PLANT_GROW:LOCAL < 10
						PLANT_GROW:LOCAL += RAND:2
				CASE 8 TO 13
					PLANT_GROW:LOCAL -= RAND:2
				ENDSELECT
			ENDIF
			;三粒の天滴を所有している場合は澆水済み＆成長に補正
			IF ITEM:三粒の天滴
				IF FLAG:天滴坤神 && PLANT_DRY:LOCAL > 2
					PRINTFORML 坤神的恩惠滋润了干涸的田地
					PLANT_DRY:LOCAL = 0
					FLAG:天滴坤神 = 0
				ENDIF
				SIF PLANT_GROW:LOCAL < 10 && !RAND:4
					PLANT_GROW:LOCAL ++
			ENDIF
			;天赋：催熟（进入果期时直接成熟）
			SIF TALENT:MASTER:催熟 && PLANT_GROW:LOCAL == 8
				PLANT_GROW:LOCAL = 10
		ELSE
			;季节不符 → 立即枯萎（枯死状态，需拔除重种）
			PLANT_GROW:LOCAL = 11
		ENDIF
	ENDIF
NEXT
RETURN
