;========================================================
; 生活系统大修 - 读书系统改造（等级化学习判定）
; 文件：ERB/DLC/生活系统大修/生活系统_读书.ERB
;
; 背景：原版读实用书为「随机方向获取经验」，学到与否纯看运气。
; 改造：
;   1. 读实用书 → 展开子菜单选择想找哪方面的书（书籍分区）
;   2. 学到概率随对应技能等级递减：P = (上限-等级)/(上限-等级+3)，
;      等级达到上限则一无所获；文学书同样套用（按教養等级）
; 门控：任一生活系统（养鸡/种地/酿酒/钓鱼）开启时生效；
;       全部关闭时 COMF436 保持上游行为。
; 上限公式与引擎 TRACHECK_ABLUP 一致：6 + N×MAGIC_DLC_等级重置（兼容魔法补丁）
;========================================================

;--------------------------------------------------------
; 等级化学习判定（文学书与实用书共用）
; ARG   = 技能分类：0=学習 1=会話 2=料理 3=釣り 4=採集 5=調合 6=伐採 7=耕种
; ARG:1 = 当前技能等级
; ARG:2 = 技能等级上限
; ARG:3 = 成功时获得的经验量（READING_EXP）
;--------------------------------------------------------
@生活系统_读书_学习判定(ARG, ARG:1, ARG:2, ARG:3)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC 判定技能
#DIM DYNAMIC 判定等级
#DIM DYNAMIC 判定上限
#DIM DYNAMIC 判定经验
判定技能 = ARG
判定等级 = ARG:1
判定上限 = ARG:2
判定经验 = ARG:3
;等级已达上限：一无所获
IF 判定等级 >= 判定上限
        PRINTFORML 这类书的内容你已经烂熟于心……翻了几页便放下了
        RETURN 1
ENDIF
;学到概率 = (上限-等级)/(上限-等级+3)，等级越低越容易
IF RAND:(判定上限 - 判定等级 + 3) < 判定上限 - 判定等级
        SELECTCASE 判定技能
                CASE 0
                        EXP:MASTER:学習経験 += 判定经验
                        SIF TARGET > 0 && MAGIC_DLC_等级重置
                                EXP:TARGET:学習経験 += 判定经验
                        PRINTFORML 沉浸在书页之间，若有所思……
                CASE 1
                        EXP:MASTER:会話経験 += 判定经验
                        SIF TARGET > 0 && MAGIC_DLC_等级重置
                                EXP:TARGET:会話経験 += 判定经验
                        PRINTFORML 学到了一点点与人交谈的门道……
                CASE 2
                        EXP:MASTER:料理経験 += 判定经验
                        SIF TARGET > 0 && MAGIC_DLC_等级重置
                                EXP:TARGET:料理経験 += 判定经验
                        PRINTFORML 记下了一道全新的菜谱……
                CASE 3
                        EXP:MASTER:釣り経験 += 判定经验
                        SIF TARGET > 0 && MAGIC_DLC_等级重置
                                EXP:TARGET:釣り経験 += 判定经验
                        PRINTFORML 对垂钓的理解更深了一些……
                CASE 4
                        EXP:MASTER:採集経験 += 判定经验
                        SIF TARGET > 0 && MAGIC_DLC_等级重置
                                EXP:TARGET:採集経験 += 判定经验
                        PRINTFORML 学到了一些野外生存的门道……
                CASE 5
                        EXP:MASTER:調合経験 += 判定经验
                        SIF TARGET > 0 && MAGIC_DLC_等级重置
                                EXP:TARGET:調合経験 += 判定经验
                        PRINTFORML 新的调合配方在脑中逐渐成型……
                CASE 6
                        EXP:MASTER:伐採経験 += 判定经验
                        SIF TARGET > 0 && MAGIC_DLC_等级重置
                                EXP:TARGET:伐採経験 += 判定经验
                        PRINTFORML 学到了更高效的伐木手法……
                CASE 7
                        EXP:MASTER:耕种经验 += 判定经验
                        SIF TARGET > 0 && MAGIC_DLC_等级重置
                                EXP:TARGET:耕种经验 += 判定经验
                        PRINTFORML 对耕种的理解又加深了一些……
        ENDSELECT
ELSE
        PRINTFORML 可惜没能从书里找到有用的内容……
ENDIF
RETURN 1
