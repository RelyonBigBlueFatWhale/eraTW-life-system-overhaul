;========================================================
; 生活系统大修 - 酿酒系统
; 文件：ERB/DLC/生活系统大修/生活系统_酿酒.ERB
;
; 开关：生活系统_酿酒
; 钩子：@生活系统_酿酒_每日事件 由 DLCEVENT 在每日结算时调用
;
; 功能：
;   家具屋可订购橡木酒桶（家具914，最多5个），每拥有一个在
;   「察看酒虫的情况」（COM450）中额外多一个"酒桶N"入口。
;   每个酒桶独立完成酒虫的全部工作：倒入水、取出换水、添加
;   物品混合酿造、操纵时间加速、绯红之王跳过发酵。
;
; 实现方式：将酒桶状态（酒桶_内容物/酒桶_天数）临时载入酒虫
;   的全局变量（VAR_FERMENT/DAY:10），复用全部酿造逻辑后写回。
;========================================================

;--------------------------------------------------------
; 每日事件钩子：在本子系统开关开启时被调用
; 推进各酒桶的发酵（逻辑同酒虫的@酒造，每个酒桶独立结算）
; 酒桶0开局自带，酒桶1～5由家具屋打造（ITEM:酒桶=打造个数）
;--------------------------------------------------------
@生活系统_酿酒_每日事件
#LOCALSIZE 2
#LOCALSSIZE 1
SIF !生活系统_酿酒
	RETURN
FOR LOCAL, 0, 6
	;酒桶0=原版酒虫，由AFTERTRA的@酒造每日推进，这里只推进打造的酒桶1～5
	SIF LOCAL == 0
		CONTINUE
	;仅推进已拥有的酒桶（酒桶K需要 ITEM:酒桶 >= K）
	SIF ITEM:酒桶 < LOCAL
		CONTINUE
	SIF 酒桶_内容物:LOCAL == ""
		CONTINUE
	酒桶_天数:LOCAL ++
	LOCAL:1 = GETMETH_INT(0, "酒データ", ALC_ID(酒桶_内容物:LOCAL), "醸造日数")
	;酒造家Lv2以上且所需天数>2时，实际所需天数-1
	SIF TALENT:MASTER:酒造家 >= 2 && LOCAL:1 > 2
		LOCAL:1 --
	IF LOCAL:1 > 0 && LOCAL:1 <= 酒桶_天数:LOCAL
		LOCALS = %GETMETH_STR(0, "酒データ", ALC_ID(酒桶_内容物:LOCAL), "変化先")%
		CALL COLORMESSAGE(@"酒桶{LOCAL}中的%酒桶_内容物:LOCAL%变成了%LOCALS%",C_YELLOW, 2)
		酒桶_天数:LOCAL = 0
		酒桶_内容物:LOCAL = %LOCALS%
		CALL BREWING_GUIDE_MAKE_KNOWN(酒桶_内容物:LOCAL)
	ENDIF
NEXT
RETURN

;--------------------------------------------------------
; 酒桶操作菜单（由COM450「察看酒虫的情况」调用）
; ARG: 初始酒桶编号（0～5；酒桶0=原版酒虫，酒桶1～5由家具屋打造，最多5个）
; 翻页式界面：默认显示酒桶0（原版酒虫指令），[上一个酒桶]/[下一个酒桶]切换。
; 实现方式：将酒桶状态（酒桶_内容物/酒桶_天数）载入酒虫的全局变量
;   （VAR_FERMENT/DAY:10），复用全部酿造逻辑后写回。
;   酒桶0即酒虫本身，直接使用全局状态，无需载入/写回。
;--------------------------------------------------------
@酒桶_操作(ARG)
#LOCALSIZE 3
#LOCALSSIZE 2
#DIM DYNAMIC 桶号
#DIM DYNAMIC 醸造量
#DIM DYNAMIC 酒ID
#DIM DYNAMIC CAN_ADD_ITEMS
#DIM DYNAMIC 行数
#DIM DYNAMIC 切换中
#DIM DYNAMIC 有水
#DIM DYNAMIC 可添加
#DIM DYNAMIC 可TSP
#DIM DYNAMIC 可绯红
#DIM DYNAMIC 可上一个
#DIM DYNAMIC 可下一个
桶号 = ARG
切换中 = 0	;仅"上一个/下一个酒桶"切换后为1——首次进入时永远以全局（酒桶0真实状态）为准，避免残留备份覆盖

$酒桶_LOOP

;首次进入酒桶0时清除数组槽0可能残留的旧备份（上次会话非正常退出/旧版本污染），以全局状态为准
SIF 桶号 == 0 && !切换中
	酒桶_内容物:0 =
	酒桶_天数:0 = 0

;载入目标桶的状态（酒桶0=原版酒虫，直接使用全局状态；酒桶1～5从独立数组载入）
;注意：载入其他桶会覆盖全局 VAR_FERMENT/DAY:10，因此切换离开酒桶0时会把其状态
;备份到数组槽0（见"上一个/下一个酒桶"分支）；仅切换回来时据此恢复，避免内容物串桶
IF 桶号 > 0
	VAR_FERMENT = %酒桶_内容物:桶号%
	DAY:10 = 酒桶_天数:桶号
ELSEIF 切换中 && 酒桶_内容物:0 != ""
	VAR_FERMENT = %酒桶_内容物:0%
	DAY:10 = 酒桶_天数:0
ENDIF
;空桶自动积起清水（与酒虫的瓶子一样，桶里总有内容物，可直接添加添加物开始酿造）
IF VAR_FERMENT == ""
	VAR_FERMENT = 普通的水
	DAY:10 = 0
ENDIF
酒ID = ALC_ID()
醸造量 = GETMETH_INT(0, "酒データ", 酒ID, "醸造数")
行数 = LINECOUNT

;显示当前桶的状态（酒桶0=原版酒虫）
IF 桶号 == 0
	PRINTFORML %CALLNAME:MASTER%往放着酒虫的瓶子里窥去
	PRINTFORML 酒桶0（酒虫瓶）：装满了%VAR_FERMENT%…（发酵天数{DAY:10}）
ELSE
	PRINTFORML 酒桶{桶号}：桶里装满了%VAR_FERMENT%…（发酵天数{DAY:10}）
ENDIF
DRAWLINE

;选项1：取出桶中物，换入携带的水（与原版酒虫设定一致，未带水时不可用）
;注：选项条件一律先用 #DIM 保存再传入 ASK_M——参数列表中的函数调用（GETMETH_STR/ALC_ID 等）
;会覆盖 LOCAL/LOCALS，直接传 LOCAL 会导致"文本正常但选项灰显"
有水 = 1
LOCALS '= @"取出%VAR_FERMENT%，换入%VAR_WATER%"
SIF VAR_WATER == ""
	LOCALS '= "没有带着可以替换的水"
	有水 = 0
ENDIF
;退出选项文本（酒桶0沿用原版"什么也不做"）
LOCALS:1 = 返回
SIF 桶号 == 0
	LOCALS:1 = 什么也不做
ENDIF
可添加 = VAR_FERMENT != ""
可TSP = VAR_FERMENT != "" && BASE:MASTER:8 >= 2400
可绯红 = VAR_FERMENT != "" && BASE:MASTER:8 >= 4000 && ITEM:绯红之王 && GETMETH_STR(0, "酒データ", ALC_ID(VAR_FERMENT), "変化先") != "0"
可上一个 = 桶号 > 0
可下一个 = 桶号 < ITEM:酒桶

{
CALL ASK_M(LOCALS:1, 1,
LOCALS, 有水,
"添加物品", 可添加,
"操纵时间造酒（TSP2400）", 可TSP,
"『绯红之王』！（TSP4000&道具）", 可绯红,
"上一个酒桶", 可上一个,
"下一个酒桶", 可下一个)
}
SELECTCASE RESULT
	CASE 0
		;什么也不做/返回——写回当前桶状态（酒桶0即酒虫本身，写回仅作备份）
		酒桶_内容物:桶号 = %VAR_FERMENT%
		酒桶_天数:桶号 = DAY:10
		;退出前：若当前是酒桶1～5，把全局恢复为酒桶0（原版酒虫）的状态，
		;避免退出后 @酒造 用其他桶的内容推进原版全局；随后清除切换备份
		IF 桶号 > 0
			VAR_FERMENT = %酒桶_内容物:0%
			DAY:10 = 酒桶_天数:0
		ENDIF
		酒桶_内容物:0 =
		酒桶_天数:0 = 0
		RETURN -1
	CASE 1
		;取出桶中物，换入携带的水（与原版酒虫设定一致）
		PRINTFORML %CALLNAME:MASTER%取出%VAR_FERMENT%后往桶里倒进了%VAR_WATER%
		;生活系统大修：桶中为"咸鸭蛋"时（清酒+20个待腌制腌成），取出的是腌好的20个咸鸭蛋
		SIF VAR_FERMENT == "咸鸭蛋"
			醸造量 = 20
		IF 醸造量 > 0
			;酒造家天赋额外+1产量
			SIF TALENT:MASTER:酒造家
				醸造量++
			CALL GET_ITEM(@"%VAR_FERMENT%", 醸造量, 2)
			CALL BREWING_GUIDE_CONSUME(VAR_FERMENT)
		ENDIF
		;特定酒取出时获得酒粕副产品
		SIF VAR_FERMENT == "吟酿酒" || VAR_FERMENT == "熟成酒" || VAR_FERMENT == "古酒" || VAR_FERMENT == "贵酿酒" || VAR_FERMENT == "贵酿熟成酒" || VAR_FERMENT == "贵酿古酒"
			CALL GET_ITEM("酒粕", 1, 1)
		;更新桶中内容物
		VAR_FERMENT = %VAR_WATER%
		VAR_WATER =
		DAY:10 = 0
		;换水时可以喂食酒虫（加速发酵）
		IF ITEM:鱼粕 || ITEM:肉骨粉
			PRINTFORML 给桶里的酒虫喂食吧…
			{
			CALL ASK_M("喂鱼粕", ITEM:鱼粕,
			"喂肉骨粉", ITEM:肉骨粉,
			"不喂食",1)
			}
			SELECTCASE RESULT
				CASE 0
					CALL LOST_ITEM("鱼粕", 1, 1)
					PRINTFORML 酒虫吃完了鱼粕而变得稍微活跃了一点…
					DAY:10 += 1
				CASE 1
					CALL LOST_ITEM("肉骨粉", 1, 1)
					PRINTFORML 酒虫吃完了肉骨粉而变得活跃起来…
					DAY:10 += 2
				CASE 2
					PRINTFORML 什么都不喂
			ENDSELECT
		ENDIF
		CALL BREWING_GUIDE_MAKE_KNOWN(VAR_FERMENT)
		CALL 酒桶_行动耗时
		;写回并刷新显示
		酒桶_内容物:桶号 = %VAR_FERMENT%
		酒桶_天数:桶号 = DAY:10
		CLEARLINE LINECOUNT - 行数
		GOTO 酒桶_LOOP
	CASE 2
		;添加物品（进入添加物选择菜单，直接操作载入的全局状态）
		CALL COM450_1
		CALL 酒桶_行动耗时
		酒桶_内容物:桶号 = %VAR_FERMENT%
		酒桶_天数:桶号 = DAY:10
		CLEARLINE LINECOUNT - 行数
		GOTO 酒桶_LOOP
	CASE 3
		;操纵时间造酒（消费TSP2400，推进1天发酵）
		IF GETMETH_STR(0, "酒データ", 酒ID, "変化先") == ""
			PRINTFORMW 对%VAR_FERMENT%没有意义
			CLEARLINE LINECOUNT - 行数
			GOTO 酒桶_LOOP
		ENDIF
		PRINTFORML %CALLNAME:MASTER%使用时间停止能力强行加速了酒桶中的时间
		BASE:MASTER:8 -= 2400
		CALL 酒桶_発酵(桶号)
		CALL 酒桶_行动耗时
		酒桶_内容物:桶号 = %VAR_FERMENT%
		酒桶_天数:桶号 = DAY:10
		CLEARLINE LINECOUNT - 行数
		GOTO 酒桶_LOOP
	CASE 4
		;绯红之王（消费TSP4000+绯红之王道具，直接推进9天）
		IF GETMETH_STR(0, "酒データ", 酒ID, "変化先") == ""
			PRINTFORMW 对%VAR_FERMENT%没有意义
			CLEARLINE LINECOUNT - 行数
			GOTO 酒桶_LOOP
		ENDIF
		PRINTFORML %CALLNAME:MASTER%消除了时间得到了『结果』
		BASE:MASTER:8 -= 4000
		ITEM:绯红之王 --
		;生活系统大修：绯红之王直接跳过咸鸭蛋腌制（待腌制的咸鸭蛋→立即腌成咸鸭蛋）
		IF VAR_FERMENT == "待腌制的咸鸭蛋"
			DAY:10 = 14
		ELSE
			DAY:10 += 9
		ENDIF
		CALL 酒桶_発酵(桶号)
		CALL 酒桶_行动耗时
		酒桶_内容物:桶号 = %VAR_FERMENT%
		酒桶_天数:桶号 = DAY:10
		CLEARLINE LINECOUNT - 行数
		GOTO 酒桶_LOOP
	CASE 5
		;翻页：上一个酒桶（写回当前桶状态；离开酒桶0时即备份其全局状态）
		酒桶_内容物:桶号 = %VAR_FERMENT%
		酒桶_天数:桶号 = DAY:10
		桶号 --
		切换中 = 1
		CLEARLINE LINECOUNT - 行数
		GOTO 酒桶_LOOP
	CASE 6
		;翻页：下一个酒桶（写回当前桶状态；离开酒桶0时即备份其全局状态）
		酒桶_内容物:桶号 = %VAR_FERMENT%
		酒桶_天数:桶号 = DAY:10
		桶号 ++
		切换中 = 1
		CLEARLINE LINECOUNT - 行数
		GOTO 酒桶_LOOP
	CASEELSE
		CLEARLINE 1
		GOTO 酒桶_LOOP
ENDSELECT

;--------------------------------------------------------
; 酒桶行动耗时（与原版酒虫指令一致：每次行动消耗5分钟）
;--------------------------------------------------------
@酒桶_行动耗时
IF FLAG:70 && MAGIC_DLC_时间因子
	BASE:MASTER:TSP -= 15
ELSE
	TIME += 5
	M_TFLAG:时间因子类型 = TimeFactor_TSLv
ENDIF

;--------------------------------------------------------
; 酒桶内发酵检查（加速/绯红之王后调用，逻辑同@酒造）
; 使用当前载入的全局状态（VAR_FERMENT/DAY:10）
; ARG: 酒桶编号（仅用于显示）
;--------------------------------------------------------
@酒桶_発酵(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC ALTER
DAY:10 ++
LOCAL = GETMETH_INT(0, "酒データ", ALC_ID(), "醸造日数")
;酒造家Lv2以上且所需天数>2时，实际所需天数-1
SIF TALENT:MASTER:酒造家 >= 2 && LOCAL > 2
	LOCAL--
IF LOCAL > 0 && LOCAL <= DAY:10
	ALTER = %GETMETH_STR(0, "酒データ", ALC_ID(), "変化先")%
	CALL COLORMESSAGE(@"酒桶{ARG}中的%VAR_FERMENT%变成了%ALTER%",C_YELLOW, 2)
	DAY:10 = 0
	VAR_FERMENT = %ALTER%
	CALL BREWING_GUIDE_MAKE_KNOWN(VAR_FERMENT)
ENDIF
