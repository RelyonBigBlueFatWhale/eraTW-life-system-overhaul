;========================================================
; 鱼塘（自定义指令 515）
; 入口：生活系统大修鱼塘系统（家庭菜园内）
; 结构：一览  鱼塘详情（分页选鱼）  单条鱼操作
;========================================================
@ADD_CUSTOM_COM515
#LOCALSIZE 4
#LOCALSSIZE 1
LOCAL = LINECOUNT
;分页位置（每页5条）
生活系统_鱼塘页码 = 1
$鱼塘_主菜单
PRINTFORML 　　　　　　　　鱼　　塘
DRAWLINE
FOR LOCAL:1, 1, 生活系统_鱼塘数量 + 1
        IF 生活系统_鱼塘鱼种:(LOCAL:1) == ""
                PRINTFORML [{LOCAL:1}] 鱼塘{LOCAL:1}　空塘
        ELSE
                LOCALS = 成长中
                LOCAL:2 = 0
                IF 生活系统_鱼塘产卵剩:(LOCAL:1) > 0
                        LOCALS = 产卵期
                        LOCAL:2 = 生活系统_鱼塘产卵剩:(LOCAL:1)
                ELSEIF 生活系统_鱼塘孵化剩:(LOCAL:1) > 0
                        LOCALS = 孵化期
                        LOCAL:2 = 生活系统_鱼塘孵化剩:(LOCAL:1)
                ENDIF
                LOCAL:3 = MIN(5, MAX(0, LOCAL:2))
                SIF LOCAL:2 <= 0
                        LOCAL:3 = 5
                CALL 生活系统_进度条(LOCAL:3, 5)
                SIF 生活系统_鱼塘请求:(LOCAL:1) == 1
                        SETCOLOR C_YELLOW
                PRINTFORML [{LOCAL:1}] 鱼塘{LOCAL:1}　{生活系统_鱼塘鱼数:(LOCAL:1)}条　%LOCALS%　%生活系统_UI进度条% \@ LOCAL:2 > 0 ? {LOCAL:2}天 # \@\@ 生活系统_鱼塘请求:(LOCAL:1) == 1 ? 　【请求】 # \@
                RESETCOLOR
        ENDIF
NEXT
IF 生活系统_鱼塘建造中
        CALL 生活系统_进度条(生活系统_鱼塘建造剩余, 5)
        PRINTFORML 建造中：新鱼塘　%生活系统_UI进度条% {生活系统_鱼塘建造剩余}天
ENDIF
DRAWLINE
PRINTL [1~5] 进入鱼塘　　[6] 建造新鱼塘　　[0] 返回
INPUT
SELECTCASE RESULT
        CASE 1 TO 5
                IF RESULT <= 生活系统_鱼塘数量
                        生活系统_鱼塘页码 = 1
                        CALL 鱼塘_详情(RESULT)
                        SIF RESULT
                                RETURN 1
                        CLEARLINE LINECOUNT - LOCAL
                ENDIF
                GOTO 鱼塘_主菜单
        CASE 6
                CALL 鱼塘_建造
        CASE 0
                RETURN 1
        CASEELSE
ENDSELECT
CLEARLINE LINECOUNT - LOCAL
GOTO 鱼塘_主菜单

;--------------------------------------------------------
; 鱼塘详情（分页选鱼 + 塘级操作）
;--------------------------------------------------------
@鱼塘_详情(塘号)
#DIM 塘号
#LOCALSIZE 5
#LOCALSSIZE 1
LOCAL = LINECOUNT
$鱼塘_操作
DRAWLINE
IF 生活系统_鱼塘鱼种:塘号 == ""
        PRINTFORML 鱼塘{塘号}　空塘
ELSE
        LOCALS = 成长中
        LOCAL:1 = 0
        IF 生活系统_鱼塘产卵剩:塘号 > 0
                LOCALS = 产卵期
                LOCAL:1 = 生活系统_鱼塘产卵剩:塘号
        ELSEIF 生活系统_鱼塘孵化剩:塘号 > 0
                LOCALS = 孵化期
                LOCAL:1 = 生活系统_鱼塘孵化剩:塘号
        ENDIF
        LOCAL:2 = MIN(5, MAX(0, LOCAL:1))
        SIF LOCAL:1 <= 0
                LOCAL:2 = 5
        CALL 生活系统_进度条(LOCAL:2, 5)
        PRINTFORML 鱼塘{塘号}　%生活系统_鱼塘鱼种:塘号%　{生活系统_鱼塘鱼数:塘号}条
        PRINTFORML %LOCALS%　%生活系统_UI进度条% \@ LOCAL:1 > 0 ? {LOCAL:1}天 # \@　　成熟雌{生活系统_鱼塘雌成熟数(塘号)}　雄{生活系统_鱼塘雄数(塘号)}
ENDIF
DRAWLINE
;鱼列表（每页5条）
LOCAL:3 = (生活系统_鱼塘页码 - 1) * 5
LOCAL:4 = MIN(LOCAL:3 + 5, 生活系统_鱼塘鱼数:塘号)
FOR LOCAL:2, LOCAL:3, LOCAL:4
        IF 生活系统_鱼塘性别:塘号:(LOCAL:2) == 1
                LOCALS = 雌
        ELSEIF 生活系统_鱼塘性别:塘号:(LOCAL:2) == 2
                LOCALS = 雄
        ELSE
                LOCALS = ？
        ENDIF
        PRINTFORML [{LOCAL:2 - LOCAL:3 + 1}] %LOCALS%　{生活系统_鱼塘长度:塘号:(LOCAL:2)}cm\@ 生活系统_鱼塘已成熟(塘号, LOCAL:2) ? 　成熟 # \@
NEXT
SIF 生活系统_鱼塘鱼数:塘号 <= 0
        PRINTL （空塘）
DRAWLINE
;底部按钮
LOCAL:1 = 生活系统_鱼塘鱼数:塘号 - LOCAL:3
IF LOCAL:1 > 5
        PRINTL [1~5] 选择这条鱼　　[6] 下一页　　[0] 返回
ELSEIF LOCAL:1 > 0
        PRINTL [1~5] 选择这条鱼　　[0] 返回
ELSE
        PRINTL [0] 返回
ENDIF
IF 生活系统_鱼塘请求:塘号 == 1
        PRINTL [7] 放入鱼　　[8] 喂食　　[9] 完成请求
ELSE
        SETCOLOR C_GRAY
        PRINTL [7] 放入鱼　　[8] 喂食　　[9] 完成请求
        RESETCOLOR
ENDIF
INPUT
SELECTCASE RESULT
        CASE 1 TO 5
                SIF RESULT <= LOCAL:1
                        CALL 鱼塘_单鱼(塘号, LOCAL:3 + RESULT - 1)
                        SIF RESULT
                                RETURN 1
        CASE 6
                SIF LOCAL:1 > 5
                        生活系统_鱼塘页码 = 生活系统_鱼塘页码 + 1
        CASE 7
                CALL 鱼塘_放入鱼(塘号)
                RETURN 1
        CASE 8
                CALL 鱼塘_喂食(塘号)
                RETURN 1
        CASE 9
                IF 生活系统_鱼塘请求:塘号 == 1
                        CALL 鱼塘_完成请求(塘号)
                        RETURN 1
                ENDIF
        CASE 0
                RETURN 0
        CASEELSE
ENDSELECT
CLEARLINE LINECOUNT - LOCAL
GOTO 鱼塘_操作
RETURN 0

;--------------------------------------------------------
; 单条鱼操作
;--------------------------------------------------------
@鱼塘_单鱼(塘号, 槽)
#DIM 塘号
#DIM 槽
#LOCALSIZE 2
#LOCALSSIZE 1
LOCAL = LINECOUNT
$鱼塘_单鱼_操作
IF 生活系统_鱼塘性别:塘号:槽 == 1
        LOCALS = 雌
ELSEIF 生活系统_鱼塘性别:塘号:槽 == 2
        LOCALS = 雄
ELSE
        LOCALS = ？
ENDIF
PRINTFORML 鱼塘{塘号}  第{槽+1}条　%LOCALS%　%生活系统_鱼塘鱼种:塘号%　{生活系统_鱼塘长度:塘号:槽}cm
DRAWLINE
PRINTFORML [1] 收回隙间渔获　　[2] 取鱼肉
PRINTFORML [3] 卖掉（%金額表示(生活系统_鱼塘单价(塘号, 槽))%）　\@ 生活系统_鱼塘鱼种:塘号 == "鲟" && 生活系统_鱼塘性别:塘号:槽 == 1 && 生活系统_鱼塘产卵剩:塘号 > 0 ? [4] 打捞鱼籽 # \@
PRINTL [0] 返回
INPUT
SELECTCASE RESULT
        CASE 1
                LOCAL:1 = QOL_FISH_INSTANCE_ADD(生活系统_鱼塘鱼种ID:塘号:槽, 生活系统_鱼塘长度:塘号:槽)
                CALL 生活系统_鱼塘_移除(塘号, 槽)
                PRINTFORMW 把这条鱼收回了隙间渔获。
                RETURN 1
        CASE 2
                SIF ITEM:魚 + 1 > 99
                        PRINTFORMW 背包里的鱼放不下了
                        RETURN 1
                ITEM:魚 += 1
                CALL 生活系统_鱼塘_移除(塘号, 槽)
                PRINTFORMW 取出了这条鱼的鱼肉。
                RETURN 1
        CASE 3
                LOCAL:1 = 生活系统_鱼塘单价(塘号, 槽)
                MONEY += LOCAL:1
                PRINTFORML 卖掉了这条%生活系统_鱼塘鱼种:塘号%，获得%金額表示(LOCAL:1)%元！
                CALL 生活系统_鱼塘_移除(塘号, 槽)
                RETURN 1
        CASE 4
                IF 生活系统_鱼塘鱼种:塘号 == "鲟" && 生活系统_鱼塘性别:塘号:槽 == 1 && 生活系统_鱼塘产卵剩:塘号 > 0
                        CALL GET_ITEM("鲟鱼卵", 1, 1)
                        PRINTFORMW 你从这条雌鲟体内打捞起一份鲟鱼卵！
                        CALL 生活系统_鱼塘_移除(塘号, 槽)
                        RETURN 1
                ENDIF
        CASE 0
                RETURN 0
        CASEELSE
ENDSELECT
CLEARLINE LINECOUNT - LOCAL
GOTO 鱼塘_单鱼_操作
RETURN 0

;--------------------------------------------------------
; 放入鱼（同塘不许混养；逐条记录鱼种/长度/性别未定）
;--------------------------------------------------------
@鱼塘_放入鱼(塘号)
#LOCALSIZE 7
#LOCALSSIZE 1
#DIM 塘号
#DIM L_UIDS, 60
#DIM L_SPECIES, 60
#DIM L_SPCNT, 60
IF 生活系统_鱼塘鱼数:塘号 >= 10
        PRINTFORMW 这个鱼塘已经满了
        RETURN
ENDIF
LOCAL:1 = QOL_FISH_INSTANCE_LIST(L_UIDS)
IF LOCAL:1 <= 0
        PRINTFORMW 隙间渔获里没有鱼先去钓鱼吧。
        RETURN
ENDIF
LOCAL:2 = 0
FOR LOCAL:3, 0, LOCAL:1
        IF QOL_FISH_INSTANCE_GET(L_UIDS:(LOCAL:3))
                SIF RESULT:0 <= 0
                        CONTINUE
                LOCAL:4 = RESULT:0
                SIF 生活系统_鱼塘鱼种:塘号 != "" && 生活系统_鱼塘鱼种ID:塘号:0 != LOCAL:4
                        CONTINUE
                LOCAL:5 = -1
                FOR LOCAL:6, 0, LOCAL:2
                        SIF L_SPECIES:(LOCAL:6) == LOCAL:4
                                LOCAL:5 = LOCAL:6
                NEXT
                IF LOCAL:5 < 0
                        L_SPECIES:(LOCAL:2) = LOCAL:4
                        L_SPCNT:(LOCAL:2) = 1
                        LOCAL:2 ++
                ELSE
                        L_SPCNT:(LOCAL:5) ++
                ENDIF
        ENDIF
NEXT
IF LOCAL:2 == 0
        PRINTFORMW 隙间里没有能放入该鱼塘的鱼种
        RETURN
ENDIF
PRINTFORML 要放入哪种鱼？（鱼塘{塘号}，剩{10 - 生活系统_鱼塘鱼数:塘号}个槽位）
FOR LOCAL:6, 0, LOCAL:2
        PRINTFORML [{LOCAL:6+1}] %QOL_FISH_GET_NAME(L_SPECIES:(LOCAL:6))%（隙间{L_SPCNT:(LOCAL:6)}条）
NEXT
PRINTL [0] 取消
INPUT
LOCAL:4 = RESULT
IF LOCAL:4 <= 0 || LOCAL:4 > LOCAL:2
        RETURN
ENDIF
LOCAL:4 = L_SPECIES:(LOCAL:4 - 1)
IF 生活系统_鱼塘鱼种:塘号 != "" && 生活系统_鱼塘鱼种ID:塘号:0 != LOCAL:4
        PRINTFORMW 鱼塘里已经养着别的鱼了
        RETURN
ENDIF
LOCAL:5 = 0
FOR LOCAL:3, 0, LOCAL:1
        IF 生活系统_鱼塘鱼数:塘号 >= 10
                BREAK
        ENDIF
        IF QOL_FISH_INSTANCE_GET(L_UIDS:(LOCAL:3))
                SIF RESULT:0 != LOCAL:4
                        CONTINUE
                生活系统_鱼塘长度:塘号:(生活系统_鱼塘鱼数:塘号) = RESULT:1
                生活系统_鱼塘鱼种ID:塘号:(生活系统_鱼塘鱼数:塘号) = LOCAL:4
                生活系统_鱼塘性别:塘号:(生活系统_鱼塘鱼数:塘号) = 0
                LOCAL:6 = QOL_FISH_INSTANCE_REMOVE(L_UIDS:(LOCAL:3))
                生活系统_鱼塘鱼数:塘号 ++
                LOCAL:5 ++
        ENDIF
NEXT
IF LOCAL:5 > 0
        生活系统_鱼塘鱼种:塘号 = %QOL_FISH_GET_NAME(LOCAL:4)%
        PRINTFORMW 放入了{LOCAL:5}条%生活系统_鱼塘鱼种:塘号%！
ELSE
        PRINTFORMW 没有放入任何鱼
ENDIF
RETURN

;--------------------------------------------------------
; 喂食（成长加速2天）
;--------------------------------------------------------
@鱼塘_喂食(塘号)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM 塘号
IF ITEM:虫 <= 0 && ITEM:鱼粕 <= 0
        PRINTFORMW 没有饲料（虫/鱼粕）
        RETURN
ENDIF
IF 生活系统_鱼塘鱼数:塘号 <= 0
        PRINTFORMW 这个鱼塘没有养鱼
        RETURN
ENDIF
IF ITEM:虫 > 0
        ITEM:虫 -= 1
ELSE
        ITEM:鱼粕 -= 1
ENDIF
生活系统_鱼塘成长剩:塘号 = MAX(生活系统_鱼塘成长剩:塘号, 2)
PRINTFORML 你给鱼塘{塘号}的鱼喂了食。
RETURN

;--------------------------------------------------------
; 完成请求
;--------------------------------------------------------
@鱼塘_完成请求(塘号)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM 塘号
CALL 生活系统_鱼塘完成请求(塘号)
RETURN

;--------------------------------------------------------
; 建造新鱼塘（15天，同时1口，上限5）
;--------------------------------------------------------
@鱼塘_建造
#LOCALSIZE 1
#LOCALSSIZE 1
IF 生活系统_鱼塘建造中
        PRINTFORMW 已经有鱼塘在建造中了
        RETURN
ENDIF
IF 生活系统_鱼塘数量 >= 5
        PRINTFORMW 鱼塘数量已达上限（5口）
        RETURN
ENDIF
IF MONEY < 300000
        PRINTFORMW 建造新鱼塘需要30万元
        RETURN
ENDIF
MONEY -= 300000
生活系统_鱼塘建造中 = 1
生活系统_鱼塘建造剩余 = 15
PRINTFORMW 开始建造新鱼塘预计需要15天。
RETURN

;--------------------------------------------------------
; 可用性门控（与家庭菜园相同）
;--------------------------------------------------------
@ADD_CUSTOM_COM_ABLE515
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !生活系统_鱼塘
        RETURN 0
SIF !家庭菜園可(CFLAG:MASTER:現在位置) && !IS_GAP_GUEST(MASTER)
        RETURN 0
RETURN 1

@Custom_COM515_NAME
#FUNCTIONS
RETURNF "鱼塘"
