;========================================================
; 蜂箱（自定义指令 514）
; 入口：生活系统大修养蜂系统（家庭菜园内）
; 结构：一览（含今日加成）  蜂箱详情
;========================================================
@ADD_CUSTOM_COM514
#LOCALSIZE 4
#LOCALSSIZE 1
LOCAL = LINECOUNT
$蜂箱_主菜单
PRINTFORML 　　　　　　　　蜜　蜂　园
CALL 蜂箱_今日加成
DRAWLINE
IF ITEM:蜂箱 <= 0
        PRINTL （还没有蜂箱）
ELSE
        FOR LOCAL:1, 0, ITEM:蜂箱
                IF !生活系统_蜂箱有蜂:(LOCAL:1)
                        CALL 生活系统_进度条(0, 10)
                        PRINTFORML [{LOCAL:1+1}] 蜂箱{LOCAL:1+1}　%生活系统_UI进度条%　空箱
                ELSE
                        CALL 生活系统_进度条(生活系统_蜂箱蜜:(LOCAL:1), 10)
                        PRINTFORML [{LOCAL:1+1}] 蜂箱{LOCAL:1+1}　%生活系统_UI进度条%　{生活系统_蜂箱蜜:(LOCAL:1)}/10
                ENDIF
        NEXT
ENDIF
DRAWLINE
PRINTFORML 蜂蜜{ITEM:蜂蜜}　蜂王{ITEM:蜂王}　彼岸花蜜{ITEM:彼岸花蜜}
DRAWLINE
PRINTL [1~8] 进入蜂箱　　[0] 返回
INPUT
SELECTCASE RESULT
        CASE 1 TO 8
                IF RESULT <= ITEM:蜂箱
                        CALL 蜂箱_详情(RESULT - 1)
                        SIF RESULT
                                RETURN 1
                        CLEARLINE LINECOUNT - LOCAL
                ENDIF
                GOTO 蜂箱_主菜单
        CASE 0
                RETURN 1
        CASEELSE
ENDSELECT
CLEARLINE LINECOUNT - LOCAL
GOTO 蜂箱_主菜单

;--------------------------------------------------------
; 今日加成（季节 + 天气）
;--------------------------------------------------------
@蜂箱_今日加成
#LOCALSIZE 4
#LOCALSSIZE 2
;季节部分
LOCAL:1 = 1
SIF DAY:季節 != 4
        LOCAL:1 = 2 + DAY:季節
SELECTCASE DAY:季節
        CASE 1
                LOCALS = 春
        CASE 2
                LOCALS = 夏
        CASE 3
                LOCALS = 秋
        CASEELSE
                LOCALS = 冬
ENDSELECT
LOCALS:1 = %LOCALS%
;天气部分
LOCAL:2 = -2
SELECTCASE TIME:天气
        CASE 天气_晴
                LOCAL:2 = 1
                LOCALS:1 = 晴
        CASE 天气_少云
                LOCAL:2 = 1
                LOCALS:1 = 少云
        CASE 天气_多云
                LOCAL:2 = 1
                LOCALS:1 = 多云
        CASEELSE
                LOCALS:1 = 恶劣
ENDSELECT
LOCAL:3 = LIMIT(LOCAL:1 + LOCAL:2, 1, 6)
PRINTFORML 今日加成：%LOCALS% {LOCAL:1}　%LOCALS:1% {LOCAL:2}　合计 {LOCAL:3}
RETURN

;--------------------------------------------------------
; 蜂箱详情
;--------------------------------------------------------
@蜂箱_详情(箱号)
#DIM 箱号
#LOCALSIZE 4
#LOCALSSIZE 1
LOCAL = LINECOUNT
$蜂箱_操作
DRAWLINE
IF !生活系统_蜂箱有蜂:箱号
        PRINTFORML 蜂箱{箱号+1}　空箱
        DRAWLINE
        PRINTL [1] 放入蜂王　　[0] 返回
        INPUT
        IF RESULT == 1
                CALL 蜂箱_放蜂王(箱号)
                RETURN 1
        ENDIF
        RETURN 0
ENDIF
PRINTFORML 蜂箱{箱号+1}
CALL 生活系统_进度条(生活系统_蜂箱蜜:箱号, 10)
PRINTFORML 存蜜：%生活系统_UI进度条%　{生活系统_蜂箱蜜:箱号}/10
CALL 生活系统_进度条(生活系统_蜂箱进度:箱号, 10)
PRINTFORML 进度：%生活系统_UI进度条%　{生活系统_蜂箱进度:箱号}/10
DRAWLINE
PRINTL [1] 收蜜　　[2] 喂糖水　　[0] 返回
INPUT
SELECTCASE RESULT
        CASE 1
                CALL 蜂箱_收蜜(箱号)
                RETURN 1
        CASE 2
                CALL 蜂箱_喂糖水(箱号)
                RETURN 1
        CASE 0
                RETURN 0
        CASEELSE
ENDSELECT
CLEARLINE LINECOUNT - LOCAL
GOTO 蜂箱_操作
RETURN 0

;--------------------------------------------------------
; 收蜜
;--------------------------------------------------------
@蜂箱_收蜜(箱号)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM 箱号
IF 生活系统_蜂箱蜜:箱号 <= 0
        PRINTFORMW 这个蜂箱里一点蜜都没有
        RETURN
ENDIF
CALL 生活系统_蜂箱收蜜(箱号)
LOCAL = RESULT
IF 生活系统_彼岸花开()
        PRINTFORMW 收得了{LOCAL}份蜂蜜，其中有一份彼岸花蜜！
ELSE
        PRINTFORMW 收得了{LOCAL}份蜂蜜！
ENDIF
RETURN

;--------------------------------------------------------
; 放入蜂王
;--------------------------------------------------------
@蜂箱_放蜂王(箱号)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM 箱号
IF ITEM:蜂王 <= 0
        PRINTFORMW 没有蜂王
        RETURN
ENDIF
IF 生活系统_蜂箱有蜂:箱号
        PRINTFORMW 这个蜂箱已经有蜜蜂了
        RETURN
ENDIF
ITEM:蜂王 -= 1
生活系统_蜂箱有蜂:箱号 = 1
PRINTFORMW 你把蜂王放进蜂箱{箱号+1}。
RETURN

;--------------------------------------------------------
; 喂糖水
;--------------------------------------------------------
@蜂箱_喂糖水(箱号)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM 箱号
IF ITEM:糖 <= 0 && ITEM:甜味料 <= 0
        PRINTFORMW 没有糖或甜味料
        RETURN
ENDIF
IF !生活系统_蜂箱有蜂:箱号
        PRINTFORMW 这个蜂箱里没有蜜蜂
        RETURN
ENDIF
IF ITEM:糖 > 0
        ITEM:糖 -= 1
ELSE
        ITEM:甜味料 -= 1
ENDIF
生活系统_蜂箱进度:箱号 += 2
PRINTFORML 你给蜂箱{箱号+1}的蜜蜂喂了糖水。
RETURN

;--------------------------------------------------------
; 可用性门控（与家庭菜园相同）
;--------------------------------------------------------
@ADD_CUSTOM_COM_ABLE514
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !生活系统_养蜂
        RETURN 0
SIF !家庭菜園可(CFLAG:MASTER:現在位置) && !IS_GAP_GUEST(MASTER)
        RETURN 0
RETURN 1

@Custom_COM514_NAME
#FUNCTIONS
RETURNF "蜂箱"
