@COM_ABLE471
#LOCALSIZE 1
#LOCALSSIZE 1
;生活系统大修 - 种地系统开关
SIF !生活系统_种地
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(471)
	RETURN RESULT
;育苗设施（家具908）
SIF ITEM:908 < 1
	RETURN 0
;必须在可进行家庭菜园的场所（设施放置于菜园）
SIF !家庭菜園可(CFLAG:MASTER:現在位置) && !IS_GAP_GUEST(MASTER)
	RETURN 0
;気力0
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF CFLAG:诶嘿嘿 == 2
	RETURN 0
RETURN 1

