;========================================================
; 天下第一武道大会（原生 TRAIN 指令 471）
; 文件：ERB/コマンド関連/COMF/日常系/COMF471 天下第一武道大会.ERB
;
; 入口：Act_COM 主行动栏（QOL_SHOW_USERCOM 原生渲染，受 COM_ABLE471 门控）
; 逻辑：CALL 生活系统_武道大会（DLC/生活系统大修）
;========================================================
@COM471
#LOCALSIZE 7
#LOCALSSIZE 1
CALL 生活系统_武道大会
RETURN 0

;--------------------------------------------------------
; 可用性门控：开关 + 博丽神社境内（据点模式 神社境内=20 / 外出模式 P2境内=2）
;--------------------------------------------------------
@COM_ABLE471
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !生活系统_武道大会 || (CFLAG:MASTER:現在位置 != 神社境内 && CFLAG:MASTER:現在位置 != P2境内)
        RETURN 0
RETURN 1
