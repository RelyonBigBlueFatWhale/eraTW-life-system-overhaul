@YASAI
#LOCALSIZE 2
#LOCALSSIZE 1
;生活系统大修：畝数组上限 240（隙间耕地）；普通上限 8 由 GETUNELENGTH418 控制
FOR LOCAL,0,240
	IF PLANT_TYPE:LOCAL
		SIF FLAG:澆水代行
			PLANT_DRY:LOCAL = 0
		PLANT_DAYS:LOCAL ++
		PLANT_DRY:LOCAL ++

		;生活系统大修：季节枯萎判定（子系统关闭或温室大棚 909 时无视季节）
		LOCAL:1 = 生活系统_植株季节(PLANT_TYPE:LOCAL)
		IF !生活系统_种地 || ITEM:909 || (LOCAL:1 & (1 << (DAY:2 - 1)))
			;季节适宜（或有温室）→ 正常生长
			IF MAIN_MAP == 9
				PLANT_GROW:LOCAL ++
				;肥やしを撒いてある場合は追加
				SIF PLANT_FOOD:LOCAL && PLANT_GROW:LOCAL < 10
					PLANT_GROW:LOCAL ++
			ELSE
				SELECTCASE TIME:5
				CASE 0,1
					PLANT_GROW:LOCAL ++
					;肥やしを撒いてある場合は追加
					SIF PLANT_FOOD:LOCAL && PLANT_GROW:LOCAL < 10
						PLANT_GROW:LOCAL ++
				CASE 2,3
					PLANT_GROW:LOCAL += RAND:2
					SIF PLANT_FOOD:LOCAL && PLANT_GROW:LOCAL < 10
						PLANT_GROW:LOCAL ++
				CASE 4 TO 7
					PLANT_DRY:LOCAL = 0
					;肥やしを撒いてある場合は1/2の確率でさらに追加
					SIF PLANT_FOOD:LOCAL && PLANT_GROW:LOCAL < 10
						PLANT_GROW:LOCAL += RAND:2
				CASE 8 TO 13
					PLANT_GROW:LOCAL -= RAND:2
				ENDSELECT
			ENDIF
			;三粒の天滴を所有している場合は澆水済み＆成長に補正
			IF ITEM:三粒の天滴
				IF FLAG:天滴坤神 && PLANT_DRY:LOCAL > 2
					PRINTFORML 坤神的恩惠滋润了干涸的田地
					PLANT_DRY:LOCAL = 0
					FLAG:天滴坤神 = 0
				ENDIF
				SIF PLANT_GROW:LOCAL < 10 && !RAND:4
					PLANT_GROW:LOCAL ++
			ENDIF
			;天赋：催熟（进入果期时直接成熟，由子系统开关控制）
			SIF 生活系统_种地 && TALENT:MASTER:催熟 && PLANT_GROW:LOCAL == 8
				PLANT_GROW:LOCAL = 10
		ELSE
			;季节不符 → 立即枯萎（枯死状态，需拔除重种）
			PLANT_GROW:LOCAL = 11
		ENDIF
	ENDIF
NEXT
